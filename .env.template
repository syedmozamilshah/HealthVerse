# HealthVerse - Autonomous Medical Triage & Routing Configuration Template
# =======================================================================
# Copy this file to .env and fill in your actual values

# ===================
# Gemini AI Configuration
# ===================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini models to use (these are the recommended ones)
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_REASONING_MODEL=gemini-2.0-flash

# ===================
# Qdrant Vector Database Configuration
# ===================
# For Qdrant Cloud (recommended for production):
# 1. Sign up at https://cloud.qdrant.io/
# 2. Create a cluster
# 3. Get your cluster details from the dashboard

QDRANT_CLUSTER_KEY=your_qdrant_cluster_key_here
QDRANT_CLUSTER_ID=your_qdrant_cluster_id_here
QDRANT_ENDPOINT=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_COLLECTION_NAME=healthverse_cases

# Alternative: For local Qdrant instance
# If you're running Qdrant locally, comment out the above and use:
# QDRANT_ENDPOINT=http://localhost:6333
# QDRANT_CLUSTER_KEY=
# QDRANT_CLUSTER_ID=

# ===================
# Agent Behavior Configuration
# ===================
# Confidence threshold for decision making (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.85

# Maximum iterations for the agent workflow
MAX_ITERATIONS=6

# Number of relevant documents to retrieve from vector store
TOP_K_SEARCH=5

# ===================
# MCQ Configuration
# ===================
# Number of multiple choice questions per iteration
MCQS_PER_ITERATION=1

# Number of options in each MCQ
MCQ_OPTIONS_COUNT=4

# ===================
# FastAPI Configuration
# ===================
# API server configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_LOG_LEVEL=info

# ===================
# Setup Instructions:
# ===================
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. For Gemini API:
#    - Visit https://makersuite.google.com/app/apikey
#    - Create a new API key
#    - Replace GEMINI_API_KEY value
# 4. For Qdrant (choose one option):
#    Option A - Cloud (Recommended):
#    - Sign up at https://cloud.qdrant.io/
#    - Create a new cluster
#    - Copy cluster details to respective fields
#    Option B - Local:
#    - Install Qdrant locally: docker run -p 6333:6333 qdrant/qdrant
#    - Use local endpoint configuration
# 5. Adjust other parameters as needed for your use case