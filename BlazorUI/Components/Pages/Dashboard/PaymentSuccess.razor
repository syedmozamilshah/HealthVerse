@rendermode InteractiveServer
@page "/payment-success"
@using System.Net.Http.Json
@using BlazorUI.Authentication
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@inject ProtectedLocalStorage LocalStorage
@inject ApiClient ApiClient

<PageTitle>Payment Successful - HealthVerse</PageTitle>

<div class="success-container">
    @if (isVerifying)
    {
        <div class="success-card">
            <div class="text-center py-5">
                <div class="spinner-border text-success" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 text-muted">Verifying your payment...</p>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="success-card">
            <div class="text-center py-4">
                <i class="bi bi-exclamation-circle text-warning" style="font-size: 4rem;"></i>
                <h2 class="mt-3">Payment Verification</h2>
                <p class="text-muted">@errorMessage</p>
                <button class="dashboard-btn mt-3" @onclick="GoToDashboard">
                    <i class="bi bi-house-door me-2"></i>
                    Go to Dashboard
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="success-card animate-success">
            <div class="success-icon">
                <div class="check-circle">
                    <i class="bi bi-check-lg"></i>
                </div>
            </div>
            
            <h1>Payment Successful!</h1>
            <p class="success-message">
                Your subscription has been activated successfully. You now have full access to all HealthVerse features.
            </p>

            <div class="subscription-info">
                <div class="info-item">
                    <i class="bi bi-calendar-check"></i>
                    <span>Monthly subscription active</span>
                </div>
                <div class="info-item">
                    <i class="bi bi-shield-check"></i>
                    <span>All premium features unlocked</span>
                </div>
                <div class="info-item">
                    <i class="bi bi-robot"></i>
                    <span>AI Agent access enabled</span>
                </div>
            </div>

            <button class="dashboard-btn" @onclick="GoToDashboard">
                <i class="bi bi-house-door me-2"></i>
                Go to Dashboard
            </button>
        </div>
    }
</div>

<style>
    .success-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 50%, #a5d6a7 100%);
        padding: 20px;
    }

    .success-card {
        background: white;
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(46, 125, 50, 0.15);
        max-width: 480px;
        width: 100%;
        padding: 50px 40px;
        text-align: center;
    }

    .animate-success {
        animation: scaleIn 0.5s ease-out;
    }

    @@keyframes scaleIn {
        from {
            opacity: 0;
            transform: scale(0.9);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .success-icon {
        margin-bottom: 30px;
    }

    .check-circle {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #4caf50 0%, #2e7d32 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.4);
        }
        70% {
            box-shadow: 0 0 0 20px rgba(76, 175, 80, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(76, 175, 80, 0);
        }
    }

    .check-circle i {
        font-size: 50px;
        color: white;
    }

    .success-card h1 {
        color: #2e7d32;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .success-message {
        color: #666;
        font-size: 1.1rem;
        line-height: 1.6;
        margin-bottom: 30px;
    }

    .subscription-info {
        background: #f8fdf8;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 30px;
    }

    .info-item {
        display: flex;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #e8f5e9;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-item i {
        color: #4caf50;
        font-size: 1.3rem;
        margin-right: 15px;
    }

    .info-item span {
        color: #333;
        font-size: 1rem;
    }

    .dashboard-btn {
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .dashboard-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(46, 125, 50, 0.3);
    }

    @@media (max-width: 768px) {
        .success-card { max-width: 420px; padding: 32px 24px; border-radius: 18px; }
        .check-circle { width: 84px; height: 84px; }
        .check-circle i { font-size: 36px; }
        .success-card h1 { font-size: 1.5rem; }
        .success-message { font-size: 1rem; }
        .info-item i { font-size: 1.1rem; margin-right: 12px; }
    }

    @@media (max-width: 480px) {
        .success-card { padding: 22px 16px; margin: 0 8px; }
        .check-circle { width: 72px; height: 72px; }
        .check-circle i { font-size: 30px; }
        .dashboard-btn { padding: 12px; font-size: 1rem; }
    }
</style>

@code {
    private bool isVerifying = true;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VerifyPayment();
        }
    }

    private async Task VerifyPayment()
    {
        try
        {
            // Get session_id from URL
            var uri = new Uri(Navigation.Uri);
            var queryParams = QueryHelpers.ParseQuery(uri.Query);
            
            if (queryParams.TryGetValue("session_id", out var sessionId) && !string.IsNullOrEmpty(sessionId))
            {
                // Call API to verify and activate subscription
                var client = await ApiClient.SetAuthorizedHeader();
                var response = await client.PostAsJsonAsync("api/Stripe/doctor/verify-session", new { sessionId = sessionId.ToString() });
                
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<VerifySessionResult>();
                    if (result?.IsSuccess == true)
                    {
                        isVerifying = false;
                        StateHasChanged();
                        return;
                    }
                    else
                    {
                        errorMessage = result?.Message ?? "Failed to verify payment. Please contact support.";
                    }
                }
                else
                {
                    // Even if verification fails, payment might have succeeded
                    // Just show success and let dashboard handle redirect
                    errorMessage = null;
                }
            }
            else
            {
                // No session ID, but user might have navigated here directly after payment
                errorMessage = null;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error verifying payment: {ex.Message}");
            errorMessage = null; // Don't show error, just proceed
        }

        isVerifying = false;
        StateHasChanged();
    }

    private void GoToDashboard()
    {
        Navigation.NavigateTo("/dashboard", true);
    }

    private class VerifySessionResult
    {
        public bool IsSuccess { get; set; }
        public string? Message { get; set; }
        public bool SubscriptionActivated { get; set; }
    }
}
