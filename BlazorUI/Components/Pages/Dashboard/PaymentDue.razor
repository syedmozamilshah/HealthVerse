@rendermode InteractiveServer
@page "/payment-due"
@using System.Net.Http.Json
@using BlazorUI.Authentication
@using BlazorUI.Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage LocalStorage
@inject NavigationManager Navigation
@inject ApiClient ApiClient
@inject IConfiguration Configuration

<PageTitle>Payment Due - HealthVerse</PageTitle>

<div class="payment-due-container">
    @if (isLoading)
    {
        <div class="loading-overlay">
            <div class="spinner-container">
                <div class="custom-spinner"></div>
                <p class="loading-text">Loading subscription details...</p>
            </div>
        </div>
    }
    else
    {
        <div class="payment-card animate-slide-up">
            <div class="payment-header">
                <div class="header-icon">
                    <i class="bi bi-credit-card-2-front"></i>
                </div>
                <h1>Subscription Required</h1>
                <span class="premium-badge">Premium Subscription</span>
            </div>

            <div class="payment-body">
                <div class="amount-display">
                    <span class="currency">Rs.</span>
                    <span class="amount gradient-text">2000</span>
                    <span class="period">/month</span>
                </div>

                <p class="payment-message">
                    @if (subscriptionStatus == "past_due")
                    {
                        <text>Your subscription payment is overdue. Please complete the payment to continue accessing HealthVerse services.</text>
                    }
                    else if (subscriptionStatus == "canceled")
                    {
                        <text>Your subscription has been canceled. Resubscribe to regain access to all features.</text>
                    }
                    else if (!hasPaidFirstSubscription)
                    {
                        <text>Complete your subscription to unlock all HealthVerse features including AI-powered diagnostics and patient management tools.</text>
                    }
                    else
                    {
                        <text>Your subscription requires attention. Please complete the payment to continue using HealthVerse.</text>
                    }
                </p>

                <div class="features-list">
                    <div class="feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>AI-Powered Diagnostic Assistance</span>
                    </div>
                    <div class="feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Unlimited Patient Management</span>
                    </div>
                    <div class="feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Smart Prescription Generator</span>
                    </div>
                    <div class="feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Real-time Appointment Scheduling</span>
                    </div>
                    <div class="feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>24/7 Priority Support</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-3" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        @errorMessage
                    </div>
                }

                <button class="subscribe-btn" @onclick="StartCheckout" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Processing...</span>
                    }
                    else
                    {
                        <i class="bi bi-lock-fill me-2"></i>
                        <span>Subscribe Now</span>
                    }
                </button>

                <div class="security-badge">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Secured by Stripe • 256-bit SSL encryption</span>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .payment-due-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 50%, #a5d6a7 100%);
        padding: 20px;
    }

    .loading-overlay {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 60vh;
    }

    .spinner-container {
        text-align: center;
    }

    .custom-spinner {
        width: 60px;
        height: 60px;
        border: 4px solid #e8f5e9;
        border-top: 4px solid #2e7d32;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .loading-text {
        color: #2e7d32;
        font-size: 1.1rem;
        font-weight: 500;
    }

    .payment-card {
        background: white;
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(46, 125, 50, 0.15);
        max-width: 480px;
        width: 100%;
        overflow: hidden;
    }

    .animate-slide-up {
        animation: slideUp 0.5s ease-out;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .payment-header {
        background: linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%);
        padding: 40px 30px;
        text-align: center;
        color: white;
    }

    .header-icon {
        width: 80px;
        height: 80px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .header-icon i {
        font-size: 36px;
    }

    .payment-header h1 {
        margin: 0 0 10px;
        font-size: 1.8rem;
        font-weight: 700;
    }

    .premium-badge {
        background: rgba(255, 255, 255, 0.2);
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .payment-body {
        padding: 40px 30px;
    }

    .amount-display {
        text-align: center;
        margin-bottom: 24px;
    }

    .currency {
        font-size: 1.5rem;
        color: #2e7d32;
        vertical-align: top;
        font-weight: 600;
    }

    .amount {
        font-size: 4rem;
        font-weight: 800;
        line-height: 1;
    }

    .gradient-text {
        background: linear-gradient(135deg, #2e7d32, #4caf50);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .period {
        font-size: 1.1rem;
        color: #666;
        margin-left: 4px;
    }

    .payment-message {
        text-align: center;
        color: #555;
        font-size: 1rem;
        line-height: 1.6;
        margin-bottom: 30px;
    }

    .features-list {
        margin-bottom: 30px;
    }

    .feature-item {
        display: flex;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .feature-item:last-child {
        border-bottom: none;
    }

    .feature-item i {
        color: #4caf50;
        font-size: 1.2rem;
        margin-right: 12px;
    }

    .feature-item span {
        color: #333;
        font-size: 0.95rem;
    }

    .subscribe-btn {
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .subscribe-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(46, 125, 50, 0.3);
    }

    .subscribe-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .security-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 20px;
        color: #888;
        font-size: 0.85rem;
    }

    .security-badge i {
        margin-right: 8px;
        color: #4caf50;
    }
    
    @@media (max-width: 768px) {
        .payment-card { max-width: 420px; border-radius: 18px; }
        .payment-header { padding: 28px 20px; }
        .payment-body { padding: 28px 20px; }
        .amount { font-size: 3rem; }
        .header-icon { width: 64px; height: 64px; }
        .header-icon i { font-size: 28px; }
        .payment-header h1 { font-size: 1.5rem; }
    }

    @@media (max-width: 480px) {
        .payment-card { margin: 0 8px; }
        .payment-header { padding: 22px 14px; }
        .payment-body { padding: 22px 14px; }
        .amount { font-size: 2.4rem; }
        .currency { font-size: 1.2rem; }
        .subscribe-btn { padding: 14px; font-size: 1rem; }
        .feature-item span { font-size: 0.92rem; }
    }
</style>

@code {
    private bool isLoading = true;
    private bool isProcessing = false;
    private string? errorMessage;
    private string subscriptionStatus = "none";
    private bool hasPaidFirstSubscription = false;
    private string doctorId = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadSubscriptionStatus();
    }

    private async Task LoadSubscriptionStatus()
    {
        try
        {
            isLoading = true;
            var client = await ApiClient.SetAuthorizedHeader();
            var response = await client.GetAsync("api/Stripe/doctor/subscription-status");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SubscriptionStatusResponse>();
                if (result != null && result.IsSuccess)
                {
                    subscriptionStatus = result.SubscriptionStatus ?? "none";
                    hasPaidFirstSubscription = result.HasPaidFirstSubscription;

                    // If subscription is active, redirect to dashboard
                    if (result.CanAccessDashboard)
                    {
                        Navigation.NavigateTo("/dashboard", true);
                        return;
                    }
                }
            }

            // Get doctor ID for checkout
            var profileResponse = await client.GetAsync("api/Doctor/get/profile");
            if (profileResponse.IsSuccessStatusCode)
            {
                var profileResult = await profileResponse.Content.ReadFromJsonAsync<DoctorProfileResponse>();
                if (profileResult?.Doctor != null)
                {
                    doctorId = profileResult.Doctor.Id;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading subscription status: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task StartCheckout()
    {
        try
        {
            isProcessing = true;
            errorMessage = null;
            StateHasChanged();

            var client = await ApiClient.SetAuthorizedHeader();
            
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var checkoutRequest = new
            {
                doctorId = doctorId,
                successUrl = $"{baseUrl}/payment-success",
                cancelUrl = $"{baseUrl}/payment-due"
            };

            var response = await client.PostAsJsonAsync("api/Stripe/doctor/create-checkout-session", checkoutRequest);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CheckoutSessionResponse>();
                if (result != null && result.IsSuccess && !string.IsNullOrEmpty(result.SessionUrl))
                {
                    Navigation.NavigateTo(result.SessionUrl, true);
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to create checkout session";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    public class SubscriptionStatusResponse
    {
        public bool IsSuccess { get; set; }
        public string? Message { get; set; }
        public string? SubscriptionStatus { get; set; }
        public bool HasPaidFirstSubscription { get; set; }
        public DateTime? SubscriptionEndDate { get; set; }
        public bool CanAccessDashboard { get; set; }
        public bool RequiresPayment { get; set; }
    }

    public class CheckoutSessionResponse
    {
        public bool IsSuccess { get; set; }
        public string? Message { get; set; }
        public string? SessionId { get; set; }
        public string? SessionUrl { get; set; }
        public string? PublishableKey { get; set; }
    }

    public class DoctorProfileResponse
    {
        public bool IsSuccess { get; set; }
        public DoctorProfile? Doctor { get; set; }
    }

    public class DoctorProfile
    {
        public string Id { get; set; } = "";
    }
}
