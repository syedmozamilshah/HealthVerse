@rendermode InteractiveServer
@page "/subscription"
@using System.Net.Http.Json
@using BlazorUI.Authentication
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using BlazorUI.Services
@inject ProtectedLocalStorage LocalStorage
@inject NavigationManager Navigation
@inject ApiClient ApiClient

<PageTitle>Subscription Management - HealthVerse</PageTitle>

<div class="subscription-container">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-success" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 text-muted">Loading subscription details...</p>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-header bg-gradient-green text-white py-4 rounded-top-4">
                            <h3 class="mb-0"><i class="bi bi-credit-card me-2"></i>Subscription Management</h3>
                        </div>
                        <div class="card-body p-4">
                            <!-- Current Status -->
                            <div class="status-section mb-4">
                                <h5 class="fw-bold mb-3">Current Status</h5>
                                <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3">
                                    <div>
                                        <span class="badge @GetStatusBadgeClass() fs-6 px-3 py-2">
                                            @GetStatusDisplayText()
                                        </span>
                                    </div>
                                    <div class="text-end">
                                        <small class="text-muted d-block">Monthly Plan</small>
                                        <span class="h4 text-success mb-0">2000<small class="text-muted fs-6">/mo</small></span>
                                    </div>
                                </div>
                            </div>

                            @if (subscriptionEndDate.HasValue)
                            {
                                <div class="billing-info mb-4">
                                    <h5 class="fw-bold mb-3">Billing Information</h5>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="p-3 border rounded-3">
                                                <small class="text-muted d-block">Current Period Ends</small>
                                                <span class="fw-semibold">@subscriptionEndDate.Value.ToDisplayString("MMMM dd, yyyy")</span>
                                            </div>
                                        </div>
                                        @if (lastPaymentDate.HasValue)
                                        {
                                            <div class="col-md-6">
                                                <div class="p-3 border rounded-3">
                                                    <small class="text-muted d-block">Last Payment</small>
                                                    <span class="fw-semibold">@lastPaymentDate.Value.ToDisplayString("MMMM dd, yyyy")</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Features -->
                            <div class="features-section mb-4">
                                <h5 class="fw-bold mb-3">Included Features</h5>
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <div class="feature-item d-flex align-items-center p-2">
                                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                                            <span>AI-Powered Diagnostics</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="feature-item d-flex align-items-center p-2">
                                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                                            <span>Unlimited Patients</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="feature-item d-flex align-items-center p-2">
                                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                                            <span>Smart Prescriptions</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="feature-item d-flex align-items-center p-2">
                                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                                            <span>Priority Support</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger" role="alert">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    @errorMessage
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(successMessage))
                            {
                                <div class="alert alert-success" role="alert">
                                    <i class="bi bi-check-circle me-2"></i>
                                    @successMessage
                                </div>
                            }

                            <!-- Actions -->
                            <div class="actions-section">
                                @if (subscriptionStatus == "active")
                                {
                                    <button class="btn btn-outline-danger" @onclick="ShowCancelConfirmation" disabled="@isProcessing">
                                        <i class="bi bi-x-circle me-2"></i>Cancel Subscription
                                    </button>
                                }
                                else if (subscriptionStatus == "past_due" || subscriptionStatus == "unpaid")
                                {
                                    <button class="btn btn-success btn-lg" @onclick="UpdatePaymentMethod" disabled="@isProcessing">
                                        @if (isProcessing)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        <i class="bi bi-credit-card me-2"></i>Update Payment & Pay Now
                                    </button>
                                }
                                else if (subscriptionStatus == "canceled" || subscriptionStatus == "none")
                                {
                                    <button class="btn btn-success btn-lg" @onclick="Resubscribe" disabled="@isProcessing">
                                        @if (isProcessing)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        <i class="bi bi-credit-card me-2"></i>Subscribe Now
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Back to Dashboard -->
                    <div class="text-center mt-4">
                        <a href="/dashboard" class="btn btn-link text-success">
                            <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Cancel Confirmation Modal -->
@if (showCancelModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-warning me-2"></i>Cancel Subscription</h5>
                    <button type="button" class="btn-close" @onclick="() => showCancelModal = false"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to cancel your subscription?</p>
                    <ul class="text-muted">
                        <li>You will lose access to AI-powered features</li>
                        <li>Your subscription will remain active until the end of the current billing period</li>
                        <li>You can resubscribe at any time</li>
                    </ul>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" @onclick="() => showCancelModal = false">Keep Subscription</button>
                    <button type="button" class="btn btn-danger" @onclick="CancelSubscription" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        Yes, Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .subscription-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #e8f5e9 0%, #f1f8e9 100%);
    }

    .bg-gradient-green {
        background: linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%);
    }

    .rounded-4 {
        border-radius: 1rem !important;
    }

    .rounded-top-4 {
        border-top-left-radius: 1rem !important;
        border-top-right-radius: 1rem !important;
    }

    .feature-item {
        background: #f8fdf8;
        border-radius: 8px;
    }
    
    @@media (max-width: 768px) {
        .card-body { padding: 1rem !important; }
        .status-section .d-flex { flex-direction: column; align-items: flex-start; gap: 12px; }
        .status-section .text-end { text-align: left !important; }
        .billing-info .row > .col-md-6 { flex: 0 0 100%; max-width: 100%; }
        .features-section .row > .col-md-6 { flex: 0 0 100%; max-width: 100%; }
        .actions-section .btn { width: 100%; display: block; margin-bottom: 8px; }
        .subscription-container { padding-left: 8px; padding-right: 8px; }
    }

    @@media (max-width: 480px) {
        .card-header h3 { font-size: 1.05rem; }
        .badge.fs-6 { font-size: 0.85rem; padding: 6px 10px; }
    }
</style>

@code {
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool showCancelModal = false;
    private string subscriptionStatus = "none";
    private DateTime? subscriptionEndDate;
    private DateTime? lastPaymentDate;
    private string? errorMessage;
    private string? successMessage;
    private string doctorId = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadSubscriptionStatus();
    }

    private async Task LoadSubscriptionStatus()
    {
        try
        {
            isLoading = true;
            var client = await ApiClient.SetAuthorizedHeader();
            var response = await client.GetAsync("api/Stripe/doctor/subscription-status");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SubscriptionStatusResponse>();
                if (result != null)
                {
                    subscriptionStatus = result.SubscriptionStatus ?? "none";
                    subscriptionEndDate = result.SubscriptionEndDate;
                }
            }

            // Get doctor profile for ID
            var profileResponse = await client.GetAsync("api/Doctor/get/profile");
            if (profileResponse.IsSuccessStatusCode)
            {
                var profileResult = await profileResponse.Content.ReadFromJsonAsync<DoctorProfileResponse>();
                if (profileResult?.Doctor != null)
                {
                    doctorId = profileResult.Doctor.Id;
                    lastPaymentDate = profileResult.Doctor.LastPaymentDate;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading subscription: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusBadgeClass()
    {
        return subscriptionStatus switch
        {
            "active" => "bg-success",
            "past_due" => "bg-warning text-dark",
            "unpaid" => "bg-danger",
            "canceled" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private string GetStatusDisplayText()
    {
        return subscriptionStatus switch
        {
            "active" => "Active",
            "past_due" => "Past Due",
            "unpaid" => "Unpaid",
            "canceled" => "Canceled",
            "none" => "No Subscription",
            _ => subscriptionStatus
        };
    }

    private void ShowCancelConfirmation()
    {
        showCancelModal = true;
    }

    private async Task CancelSubscription()
    {
        try
        {
            isProcessing = true;
            errorMessage = null;
            successMessage = null;

            var client = await ApiClient.SetAuthorizedHeader();
            var response = await client.PostAsync("api/Stripe/doctor/cancel-subscription", null);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CancelResponse>();
                if (result?.IsSuccess == true)
                {
                    successMessage = result.Message;
                    showCancelModal = false;
                    await LoadSubscriptionStatus();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to cancel subscription";
                }
            }
            else
            {
                errorMessage = "Failed to cancel subscription";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            showCancelModal = false;
        }
    }

    private async Task UpdatePaymentMethod()
    {
        await StartCheckout();
    }

    private async Task Resubscribe()
    {
        await StartCheckout();
    }

    private async Task StartCheckout()
    {
        try
        {
            isProcessing = true;
            errorMessage = null;

            var client = await ApiClient.SetAuthorizedHeader();
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            
            var checkoutRequest = new
            {
                doctorId = doctorId,
                successUrl = $"{baseUrl}/payment-success",
                cancelUrl = $"{baseUrl}/subscription"
            };

            var response = await client.PostAsJsonAsync("api/Stripe/doctor/create-checkout-session", checkoutRequest);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CheckoutResponse>();
                if (result?.IsSuccess == true && !string.IsNullOrEmpty(result.SessionUrl))
                {
                    Navigation.NavigateTo(result.SessionUrl, true);
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to create checkout session";
                }
            }
            else
            {
                errorMessage = "Failed to create checkout session";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private class SubscriptionStatusResponse
    {
        public bool IsSuccess { get; set; }
        public string? SubscriptionStatus { get; set; }
        public DateTime? SubscriptionEndDate { get; set; }
        public bool CanAccessDashboard { get; set; }
    }

    private class DoctorProfileResponse
    {
        public bool IsSuccess { get; set; }
        public DoctorProfile? Doctor { get; set; }
    }

    private class DoctorProfile
    {
        public string Id { get; set; } = "";
        public DateTime? LastPaymentDate { get; set; }
    }

    private class CancelResponse
    {
        public bool IsSuccess { get; set; }
        public string? Message { get; set; }
    }

    private class CheckoutResponse
    {
        public bool IsSuccess { get; set; }
        public string? Message { get; set; }
        public string? SessionUrl { get; set; }
    }
}
