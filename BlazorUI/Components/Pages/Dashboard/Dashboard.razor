    // Get display status - if appointment is in the past and not done, mark as missed
    private string GetDisplayStatus(AppointmentModelDtos appt)
    {
        var status = appt.Status?.ToLower() ?? "";
        
        // If already done/completed or cancelled, return as-is
        if (status == "done" || status == "completed" || status == "cancelled")
            return status == "completed" ? "done" : status;

        if (status == "confirmed")
            return "confirmed";

        if (status == "in-progress")
            return "in-progress";

        var now = DateTimeHelper.GetPakistanNow();

        // If appointment date is in the past and status is still pending, mark as missed
        if (appt.AppointmentDate < now)
            return "missed";

        // If appointment is in the future, show as pending (upcoming)
        return string.IsNullOrWhiteSpace(status) ? "pending" : status;
    }

    // Sort appointments: pending/upcoming first (by time), then done, then missed
    // Also filters based on search term and selected stat filter
@* M-4 GET SORTED APPOINTMENTS *@
    private List<AppointmentModelDtos> GetSortedAppointments()
    {
        if (appointment.AppointmentDtos == null)
            return new List<AppointmentModelDtos>();

        var now = DateTimeHelper.GetPakistanNow();
        
        var filtered = appointment.AppointmentDtos.AsEnumerable();
        
        // Apply stat card filter
        filtered = selectedFilter switch
        {
            "today" => filtered.Where(a => 
            {
                return a.AppointmentDate.IsSameDateInPakistan(now) && a.Status?.ToLower() != "cancelled";
            }),
            "upcoming" => filtered.Where(a => 
            {
                var apptDate = a.AppointmentDate;
                if (apptDate.Kind == DateTimeKind.Utc)
                    apptDate = apptDate.ToLocalTime();
                else if (apptDate.Kind == DateTimeKind.Unspecified)
                    apptDate = DateTime.SpecifyKind(apptDate, DateTimeKind.Utc).ToLocalTime();
                var status = a.Status?.ToLower();
                return apptDate >= now && (status == "pending" || status == "confirmed");
            }),
            "pending" => filtered.Where(a => GetDisplayStatus(a) == "pending"),
            "missed" => filtered.Where(a => GetDisplayStatus(a) == "missed"),
            _ => filtered // "all" - no filter
        };
        
        // Apply search filter if search term is provided
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var search = searchTerm.Trim().ToLower();
            filtered = filtered.Where(a => 
                (a.Users?.FirstName?.ToLower().Contains(search) == true) ||
                (a.Users?.LastName?.ToLower().Contains(search) == true) ||
                ($"{a.Users?.FirstName} {a.Users?.LastName}".ToLower().Contains(search)) ||
                (a.PatientId?.ToLower().Contains(search) == true)
            );
        }
        
        return filtered
            .OrderByDescending(a => a.AppointmentDate)  // Latest/newest appointments first
            .ToList();
    }
    
    // Set the filter and toggle off if clicking same filter
    private void SetFilter(string filter)
    {
        selectedFilter = selectedFilter == filter ? "all" : filter;
        StateHasChanged();
    }
    
    // Get display name for the current filter
    private string GetFilterDisplayName()
    {
        return selectedFilter switch
        {
            "today" => "Patients Today",
            "upcoming" => "Upcoming Appointments",
            "pending" => "Pending",
            "missed" => "Missed",
            _ => "All"
        };
    }

    // Count patients with appointments today
    private int GetPatientsToday()
    {
        if (appointment.AppointmentDtos == null)
            return 0;
        
        var today = DateTimeHelper.GetPakistanNow().Date;
        
        // Count unique patients with appointments scheduled for today (excluding cancelled)
        return appointment.AppointmentDtos
            .Where(a => 
            {
                var apptDate = a.AppointmentDate;
                if (apptDate.Kind == DateTimeKind.Utc)
                    apptDate = apptDate.ToLocalTime();
                else if (apptDate.Kind == DateTimeKind.Unspecified)
                    apptDate = DateTime.SpecifyKind(apptDate, DateTimeKind.Utc).ToLocalTime();
                return apptDate.Date == today && a.Status?.ToLower() != "cancelled";
            })
            .Select(a => a.PatientId)
            .Distinct()
            .Count();
    }

    // Count upcoming appointments (future + today's pending)
    private int GetUpcomingAppointmentsCount()
    {
        if (appointment.AppointmentDtos == null)
            return 0;
        
        var now = DateTimeHelper.GetPakistanNow();
        return appointment.AppointmentDtos.Count(a => 
        {
            var apptDate = a.AppointmentDate;
            if (apptDate.Kind == DateTimeKind.Utc)
                apptDate = apptDate.ToLocalTime();
            else if (apptDate.Kind == DateTimeKind.Unspecified)
                apptDate = DateTime.SpecifyKind(apptDate, DateTimeKind.Utc).ToLocalTime();
            return apptDate >= now && a.Status?.ToLower() == "pending";
        });
    }

    // Count pending appointments
    private int GetPendingCount()
    {
        if (appointment.AppointmentDtos == null)
            return 0;
        
        return appointment.AppointmentDtos.Count(a => 
            GetDisplayStatus(a) == "pending");
    }

    // Count missed appointments
    private int GetMissedCount()
    {
        if (appointment.AppointmentDtos == null)
            return 0;
        
        return appointment.AppointmentDtos.Count(a => 
            GetDisplayStatus(a) == "missed");
    }

    private string GetDoctorImageUrl()
    {
        // First try doctor's uploaded image
        if (doctorProfile != null && !string.IsNullOrEmpty(doctorProfile.ImageUrl))
        {
            return doctorProfile.ImageUrl;
        }
        // Then try user's profile image
        if (!string.IsNullOrEmpty(user.ProfileImage))
        {
            return user.ProfileImage;
        }
        // Default avatar
        return "images/doctor-avatar.png";
    }

    private string GetDoctorDisplayName()
    {
        // First try doctor profile Name (from database)
        if (doctorProfile != null && !string.IsNullOrEmpty(doctorProfile.Name))
        {
            return doctorProfile.Name;
        }
        // Fall back to session user's FirstName
        return user.FirstName ?? "Doctor";
    }

