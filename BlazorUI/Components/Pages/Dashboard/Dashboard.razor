                                    <div class="fw-semibold"><i class="bi bi-calendar-event me-2"></i>Upcoming Appointments</div>
                                    <div class="text-muted small">@(selectedFilter == "upcoming" ? "Filtered" : "Click to filter")</div>
                                </div>
                                <div class="display-6 mb-0">@GetUpcomingAppointmentsCount()</div>
