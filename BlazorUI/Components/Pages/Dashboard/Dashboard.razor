            </div>
        </div>

    </div>
</div>
}
else
{
    <div class="container py-5">
        <div class="alert alert-info">Checking subscription status…</div>
    </div>
}


@code{
    private AppointmentDtosResponse appointment = new AppointmentDtosResponse();

    private NetcodeHubToast? ToastComponent;

    private bool isLoading = true;
    private bool isAuthorized = false;

    private LoginUser user=new();
    
    private DoctorProfile? doctorProfile;
    
    private System.Threading.Timer? _refreshTimer;
    
    
    private string searchTerm = string.Empty;
    
    private string selectedFilter = "all";
    private bool isSidebarOpen = false;

    private bool showPrescriptionModal = false;
    private AppointmentModelDtos? selectedAppointmentForPrescription;

    private void ShowPrescriptionDetails(AppointmentModelDtos appt)
    {
        selectedAppointmentForPrescription = appt;
        showPrescriptionModal = true;
    }

    private void ClosePrescriptionModal()
    {
        showPrescriptionModal = false;
        selectedAppointmentForPrescription = null;
    }

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private void CloseSidebar()
    {
        isSidebarOpen = false;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        var client = await ApiClient.SetAuthorizedHeader();
        if (client.DefaultRequestHeaders.Authorization == null)
        {
            // Not logged in - redirect to login
            Navigation.NavigateTo("/", true);
            return;
        }

        await LoadDoctorProfile();
        if (doctorProfile != null && !string.IsNullOrEmpty(doctorProfile.Id))
        {
            await HubClient.SetDoctorIdAsync(doctorProfile.Id);
        }

        // If profile doesn't exist, redirect to profile setup (not payment)
        if (doctorProfile == null)
        {
            Navigation.NavigateTo("/profile-setup", true);
            return;
        }

        if (!doctorProfile.IsVerified)
        {
            Navigation.NavigateTo("/profile-setup", true);
            return;
        }

        // Check actual subscription status from Stripe API
        var subscriptionStatus = await GetSubscriptionStatus();
        if (!subscriptionStatus.IsSubscribed)
        {
            Navigation.NavigateTo("/payment-due", true);
            return;
        }

        isAuthorized = true;

        await LoadAppointments();
        await HubClient.StartAsync();
        HubClient.NewAppointment += HandleNewAppointment;
        HubClient.VerificationStatusChanged += HandleVerificationStatusChanged;

        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadAppointments();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task<SubscriptionStatusResult> GetSubscriptionStatus()
    {
        try
        {
            var client = await ApiClient.SetAuthorizedHeader();
            var response = await client.GetAsync("api/Stripe/doctor/subscription-status");
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SubscriptionStatusResult>();
                return result ?? new SubscriptionStatusResult { IsSubscribed = false };
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error checking subscription: {ex.Message}");
        }
        return new SubscriptionStatusResult { IsSubscribed = false };
    }

