@rendermode InteractiveServer
@page "/dashboard"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using BlazorUI.Authentication
@using BlazorUI.Components.Pages.Auth
@using BlazorUI.Models
@using BlazorUI.Models.AppointmentModel
@using BlazorUI.Models.DoctorModel
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using NetcodeHub.Packages.Components.Toast
@using BlazorUI.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable
@inject ProtectedLocalStorage LocalStorage
@inject IHttpClientFactory HttpClientFactory
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ApiClient ApiClient
@inject AuthenticationStateProvider AuthStateProvider
@inject ProtectedLocalStorage SessionStorage
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject AppointmentHubClient HubClient

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
<link href="app.css" rel="stylesheet" />

<style>
    /* Simple custom offcanvas for Blazor (avoids requiring bootstrap.js) */
    .custom-offcanvas {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        width: 260px;
        background: linear-gradient(180deg, #e9ffe8 0%, #ffffff 60%);
        border-right: 1px solid #d8f3df;
        padding: 1rem;
        z-index: 1055;
        box-shadow: 2px 0 12px rgba(0,0,0,0.08);
        overflow-y: auto;
        transform: translateX(0);
    }
    .custom-offcanvas-hide {
        transform: translateX(-110%);
        transition: transform 220ms ease-in-out;
    }
    .custom-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.35);
        z-index: 1050;
    }
</style>
<NetcodeHubToast @ref="ToastComponent" 
                 Position="bottom-right" 
                 Duration="1000" 
                 Persist="false" />


@if (isAuthorized)
{
    @if (showPrescriptionModal && selectedAppointmentForPrescription != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
                    <div class="modal-header text-white" style="background-color: #198754; border-top-left-radius: 12px; border-top-right-radius: 12px;">
                        <h5 class="modal-title mb-0">
                            <i class="bi bi-file-earmark-medical me-2"></i>Prescription Details
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="ClosePrescriptionModal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <strong>Patient:</strong> @(selectedAppointmentForPrescription.Users.FirstName + " " + selectedAppointmentForPrescription.Users.LastName)
                            </div>
                            <div>
                                <strong>Date:</strong> @GetAppointmentDateDisplay(selectedAppointmentForPrescription), @GetAppointmentTimeDisplay(selectedAppointmentForPrescription)
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <strong>Diagnosis:</strong> @(string.IsNullOrEmpty(selectedAppointmentForPrescription.Diagnosis) ? "N/A" : selectedAppointmentForPrescription.Diagnosis)
                        </div>

                        @if (selectedAppointmentForPrescription.Prescriptions != null && selectedAppointmentForPrescription.Prescriptions.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle" style="border: 1px solid #dee2e6;">
                                    <thead style="background-color: #d1e7dd;">
                                        <tr>
                                            <th>Medicine</th>
                                            <th>Dosage</th>
                                            <th>Frequency</th>
                                            <th>Duration</th>
                                            <th>Instructions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var med in selectedAppointmentForPrescription.Prescriptions)
                                        {
                                            <tr>
                                                <td class="fw-bold">@med.MedicineName</td>
                                                <td>@med.Dosage</td>
                                                <td>@med.Frequency</td>
                                                <td>@med.Duration</td>
                                                <td>@med.Instructions</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle me-2"></i>No medicines prescribed for this appointment.
                            </div>
                        }
                    </div>
                    <div class="modal-footer border-0 bg-light rounded-bottom" style="border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                        <button type="button" class="btn btn-secondary" @onclick="ClosePrescriptionModal">
                            <i class="bi bi-x-circle me-1"></i>Close
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

<div class="container-fluid py-3 "style="background: linear-gradient(135deg, #e3ffe6 0%, #d0f0db 35%, #f7fff9 100%); min-height: 100vh;">
    <div class="row g-3">
@* *@
        
        <div class="col-12 col-lg-2 d-none d-lg-block">
                <div class="card h-100" style="border-radius: 16px; background: linear-gradient(180deg, #e9ffe8 0%, #ffffff 60%); border: 1px solid #d8f3df;">
                    <div class="card-body ">
                        <div class="mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <img src="images/logo.png" alt="logo" class="img-fluid" style="max-width: 36px;">
                                <div>
                                    <div class="fw-bold">HEALTHVERSE</div>
                                    <div class="text-muted small">Your Digital Health Companion</div>
                                </div>
                            </div>
                        </div>
                        <div class="mb-2 text-muted">Menu:</div>
                        <div class="list-group list-group-flush">
                            <a @onclick='() => Navigation.NavigateTo("/dashboard", replace: true)'
                            class="list-group-item list-group-item-action"
                            style='@(Navigation.Uri.Contains("/dashboard") 
                                    ? "background-color:#34c759; color:#ffffff; border-radius:10px; border-color:#34c759; cursor:pointer;" 
                                    : "cursor:pointer; border-radius:10px;")'>
                                <i class="bi bi-people me-2"></i>Patients
                            </a>
                            <a class="list-group-item list-group-item-action" style="cursor:pointer;" @onclick='() => Navigation.NavigateTo("/appointments", replace: true)'><i class="bi bi-calendar2-check me-2"></i>Appointments</a>
                            @* <a class="list-group-item list-group-item-action" style="cursor:pointer;" href=""><i class="bi bi-cpu me-2"></i>AI Assistance</a> *@
                            @* <a class="list-group-item list-group-item-action" href="#"><i class="bi bi-capsule-pill me-2"></i>Prescriptions</a> *@
                            @* <a class="list-group-item list-group-item-action" href="#"><i class="bi bi-bar-chart-line me-2"></i>Analytics</a> *@
                            <div class="mt-3 text-muted">Help And Settings:</div>
                            <a class="list-group-item list-group-item-action" style="cursor:pointer;" @onclick='() => Navigation.NavigateTo("/subscription")'><i class="bi bi-credit-card me-2"></i>Subscription</a>
                            <a class="list-group-item list-group-item-action" style="cursor:pointer;" @onclick='() => Navigation.NavigateTo("/help")'><i class="bi bi-question-circle me-2"></i>Help</a>
                            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" style="cursor:pointer;" @onclick='() => Navigation.NavigateTo("/profile-setup")'><span><i class="bi bi-gear me-2"></i>Settings</span><i class="bi bi-chevron-right"></i></a>
                            <a class="list-group-item list-group-item-action" style="cursor:pointer;" @onclick='() => Navigation.NavigateTo("/logout")'><i class="bi bi-box-arrow-right me-2"></i>Log Out</a>
                        </div>
                    </div>
                </div>
        </div>

        <!-- Mobile offcanvas sidebar (Blazor-controlled) -->
        @if (isSidebarOpen)
        {
            <div class="custom-backdrop" @onclick="CloseSidebar"></div>
        }

        <div class="d-lg-none">
            <div class="custom-offcanvas @(isSidebarOpen ? string.Empty : "custom-offcanvas-hide")" role="dialog" aria-modal="true">
                <div class="mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <img src="images/logo.png" alt="logo" class="img-fluid" style="max-width: 36px;">
                        <div>
                            <div class="fw-bold">HEALTHVERSE</div>
                            <div class="text-muted small">Your Digital Health Companion</div>
                        </div>
                    </div>
                </div>
                <div class="mb-2 text-muted">Menu:</div>
                <div class="list-group list-group-flush">
                    <a @onclick='() => { CloseSidebar(); Navigation.NavigateTo("/dashboard", replace: true); }'
                    class="list-group-item list-group-item-action"
                    style='@(Navigation.Uri.Contains("/dashboard") 
                            ? "background-color:#34c759; color:#ffffff; border-radius:10px; border-color:#34c759; cursor:pointer;" 
                            : "cursor:pointer; border-radius:10px;")'>
                        <i class="bi bi-people me-2"></i>Patients
