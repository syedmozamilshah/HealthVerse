                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                                    @GetPendingCount()
                                </span>
                            }
                        </button>
                        <button type="button" class="btn btn-light border position-relative" @onclick="ShowTodayAppointments" title="Today's Appointments">
                            <i class="bi bi-calendar-check"></i>
                            @if (GetPatientsToday() > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success" style="font-size: 0.6rem;">
                                    @GetPatientsToday()
                                </span>
                            }
                        </button>
                    </div>
                    </div>
                </div> 
                @* patient management *@
                <div class="col-12 col-lg-9">
                    <div class="card mb-3" style="border: 1px solid #d8f3df; border-radius: 16px; box-shadow: 0 6px 14px rgba(0,0,0,.04);">
                        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                            <span>Patients Management</span>
                            @if (selectedFilter != "all")
                            {
                                <span class="badge bg-success">
                                    Showing: @GetFilterDisplayName()
                                </span>
                            }
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                                    <input type="text" class="form-control" 
                                           placeholder="Search By Patient Name"
                                           @bind="searchTerm"
                                           @bind:event="oninput">
                                </div>
                                <div class="form-text">Type to filter patients</div>
                            </div>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col">Patients Name</th>
                                        <th scope="col">Visit Date</th>
                                        <th scope="col">Status</th>
                                        <th scope="col">More Info.</th>
                                    </tr>
                                    <tr>
                                        <th colspan="4" class="p-0"><hr class="my-0"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (isLoading)
                                    {
                                        @for (int i = 0; i < 3; i++)  // show 3 skeleton rows
                                        {
                                            <tr>
                                                <td class="d-flex align-items-center gap-2">
                                                    <!-- Avatar skeleton -->
                                                    <div class="rounded-circle bg-light" style="width:36px;height:36px;"></div>
                                                    <div>
                                                        <!-- Name + Id skeleton lines -->
                                                        <div class="bg-light mb-1" style="width:100px;height:12px;border-radius:4px;"></div>
                                                        <div class="bg-light" style="width:60px;height:10px;border-radius:4px;"></div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div style="color:#34C759;width:80px;height:12px;border-radius:4px;"></div>
                                                </td>
                                                <td>
                                                    <div class="bg-light" style="width:70px;height:20px;border-radius:10px;"></div>
                                                </td>
                                                <td>
                                                    <div class="bg-light" style="width:60px;height:12px;border-radius:4px;"></div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else if (appointment.AppointmentDtos != null && appointment.AppointmentDtos.Count > 0)
                                    {
                                        @foreach (var appt in GetSortedAppointments())
                                        {
                                            var displayStatus = GetDisplayStatus(appt);
                                            <tr>
                                                <td class="d-flex align-items-center gap-2">
                                                    <img src="@(string.IsNullOrEmpty(appt.Users.ProfileImage) ? "images/doctor-avatar.png" : appt.Users.ProfileImage)" 
                                                        alt="@appt.Users.FirstName" class="rounded-circle" width="36" height="36" style="border:2px solid #e6f7ec; object-fit: cover;">
                                                    <div>
                                                        <div class="fw-semibold">@(appt.Users.FirstName + " " + appt.Users.LastName)</div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold">@GetAppointmentDateDisplay(appt)</div>
                                                    <div class="text-muted small">@GetAppointmentTimeDisplay(appt)</div>
                                                </td>
                                                <td>
                                                    @if (displayStatus == "done")
                                                    {
                                                        <span class="badge bg-success">COMPLETED</span>
                                                    }
                                                    else if (displayStatus == "pending")
                                                    {
                                                        <span class="badge bg-warning text-dark">PENDING</span>
                                                    }
                                                    else if (displayStatus == "missed")
                                                    {
                                                        <span class="badge bg-danger">MISSED</span>
                                                    }
                                                    else if (displayStatus == "confirmed")
                                                    {
                                                        <span class="badge bg-primary">CONFIRMED</span>
                                                    }
                                                    else if (displayStatus == "in-progress")
                                                    {
                                                        <span class="badge bg-info">IN-PROGRESS</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-info">@displayStatus.ToUpper()</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <button @onclick="() => OnMoreInfoClick(appt.PatientId)" class="badge bg-success border-0" style="cursor: pointer;">
                                                            click here
