                            <div class="card" style="border: 1px solid @(selectedFilter == "pending" ? "#34c759" : "#d8f3df"); border-radius: 16px; cursor: pointer; transition: all 0.2s; @(selectedFilter == "pending" ? "background-color: #e9ffe8; box-shadow: 0 4px 12px rgba(52,199,89,0.2);" : "")" @onclick='() => SetFilter("pending")'>
                                <div class="card-body d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-semibold"><i class="bi bi-clock-history me-2"></i>Pending</div>
                                    <div class="text-muted small">@(selectedFilter == "pending" ? "Filtered" : "Click to filter")</div>
                                </div>
                                <div class="display-6 mb-0">@GetPendingCount()</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="card" style="border: 1px solid @(selectedFilter == "missed" ? "#34c759" : "#d8f3df"); border-radius: 16px; cursor: pointer; transition: all 0.2s; @(selectedFilter == "missed" ? "background-color: #e9ffe8; box-shadow: 0 4px 12px rgba(52,199,89,0.2);" : "")" @onclick='() => SetFilter("missed")'>
                                <div class="card-body d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-semibold"><i class="bi bi-x-circle me-2"></i>Missed</div>
                                    <div class="text-muted small">@(selectedFilter == "missed" ? "Filtered" : "Click to filter")</div>
