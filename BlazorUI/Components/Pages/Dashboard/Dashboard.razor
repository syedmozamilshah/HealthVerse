                    <a class="list-group-item list-group-item-action" style="cursor:pointer;" @onclick='() => { CloseSidebar(); Navigation.NavigateTo("/appointments", replace: true); }'><i class="bi bi-calendar2-check me-2"></i>Appointments</a>
                    <div class="mt-3 text-muted">Help And Settings:</div>
                    <a class="list-group-item list-group-item-action" style="cursor:pointer;" @onclick='() => { CloseSidebar(); Navigation.NavigateTo("/subscription"); }'><i class="bi bi-credit-card me-2"></i>Subscription</a>
                    <a class="list-group-item list-group-item-action" style="cursor:pointer;" @onclick='() => { CloseSidebar(); Navigation.NavigateTo("/help"); }'><i class="bi bi-question-circle me-2"></i>Help</a>
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" style="cursor:pointer;" @onclick='() => { CloseSidebar(); Navigation.NavigateTo("/profile-setup"); }'><span><i class="bi bi-gear me-2"></i>Settings</span><i class="bi bi-chevron-right"></i></a>
                    <a class="list-group-item list-group-item-action" style="cursor:pointer;" @onclick='() => { CloseSidebar(); Navigation.NavigateTo("/logout"); }'><i class="bi bi-box-arrow-right me-2"></i>Log Out</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-10">
            <div class="row g-3">

                @* left navigator *@
                <div class="col-12">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <button class="btn btn-light d-lg-none me-2" type="button" @onclick="ToggleSidebar">
                                <i class="bi bi-list"></i>
                            </button>
                            <h2 class="mb-0">Doctor Dashboard</h2>
                        </div>
                    <div class="input-group" style="max-width: 420px;">
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-light border position-relative" @onclick="ShowNotifications" title="Notifications">
                            <i class="bi bi-bell"></i>
