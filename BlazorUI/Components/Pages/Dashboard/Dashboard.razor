    @* M-8 CALLING APIS TO GET THE APPOINTMENTS *@
    private async Task LoadAppointments()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            var client = await ApiClient.SetAuthorizedHeader();
            if (client.DefaultRequestHeaders.Authorization == null)
            {
                ToastComponent?.ShowDangerToast("Unauthorized", "Please login again.");
                Navigation.NavigateTo("/login", true);
                return;
            }

            var currentUserResult = await SessionStorage.GetAsync<LoginUser>("currentUser");
            if (currentUserResult.Success && currentUserResult.Value != null)
            {
                user = currentUserResult.Value;
            }

            var response = await client.GetAsync("api/Doctor/get/appointments");
            Console.WriteLine($"API Response Status: {response.ReasonPhrase}");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<AppointmentDtosResponse>();
                if (apiResponse != null && apiResponse.IsSuccess)
                {
                    Console.WriteLine($"Fetched {apiResponse.AppointmentDtos?.Count} appointments.");
                    Console.WriteLine($"Fetched {apiResponse.AppointmentDtos} appointments.");
                    appointment = apiResponse;

                    Console.WriteLine($"after appointments.");
                    StateHasChanged();
                }
            }
            else
            {
                ToastComponent?.ShowInfoToast("Whoo no appointment found", response.ReasonPhrase ?? "Unknown error");
                return;
            }
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Exception in LoadAppointments:", ex.Message);
            Console.Error.WriteLine($"Exception in LoadAppointments: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

