    private async Task LookupPmdcByLicence(string licenceNumber, bool force = false, bool applyProfileAutoFill = false)
    {
        if (applyProfileAutoFill)
        {
            doctorForm.LicenceNumber = licenceNumber;
            verificationForm.LicenceNumber = licenceNumber;
        }

        if (string.IsNullOrWhiteSpace(licenceNumber))
        {
            ClearPmdcLookupState();
            return;
        }

        if (licenceNumber.Length != 7)
        {
            pmdcLookupTried = true;
            pmdcIsVerified = false;
            pmdcLookupMessage = "Licence number must be exactly 7 characters.";
            pmdcDoctorName = string.Empty;
            pmdcQualification = string.Empty;
            pmdcStatus = string.Empty;
            pmdcDateOfRegistration = string.Empty;
            return;
        }

        if (isPmdcLookupLoading)
        {
            return;
        }

        if (!force && string.Equals(lastPmdcLookupLicense, licenceNumber, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        try
        {
            isPmdcLookupLoading = true;
            pmdcLookupMessage = string.Empty;
            pmdcLookupTried = false;
            StateHasChanged();

            var client = await ApiClient.SetAuthorizedHeader();
            var response = await client.GetAsync($"api/DoctorVerification/pmdc-lookup?licenceNumber={Uri.EscapeDataString(licenceNumber)}");
            lastPmdcLookupLicense = licenceNumber;

            var payload = await response.Content.ReadFromJsonAsync<PmdcLookupApiResponse>();

            if (payload != null)
            {
                pmdcLookupTried = true;
                pmdcIsVerified = payload.IsVerified;
                pmdcLookupMessage = payload.Message;
                pmdcDoctorName = payload.DoctorName;
                pmdcQualification = payload.Qualification;
                pmdcStatus = payload.Status;
                pmdcDateOfRegistration = payload.DateOfRegistration;

                ApplyVerificationAutoFillFromPmdc(payload);

                if (applyProfileAutoFill)
                {
                    ApplyProfileAutoFillFromPmdc(payload);
                }
            }
            else
            {
                pmdcLookupTried = true;
                pmdcIsVerified = false;
                pmdcLookupMessage = response.IsSuccessStatusCode
                    ? "Unable to parse PMDC response."
                    : $"PMDC lookup failed: {(int)response.StatusCode}";
                pmdcDoctorName = string.Empty;
                pmdcQualification = string.Empty;
                pmdcStatus = string.Empty;
                pmdcDateOfRegistration = string.Empty;
            }
        }
        catch (Exception ex)
        {
            pmdcLookupTried = true;
            pmdcIsVerified = false;
            pmdcLookupMessage = $"PMDC lookup failed: {ex.Message}";
            pmdcDoctorName = string.Empty;
            pmdcQualification = string.Empty;
            pmdcStatus = string.Empty;
            pmdcDateOfRegistration = string.Empty;
        }
        finally
        {
            isPmdcLookupLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyProfileAutoFillFromPmdc(PmdcLookupApiResponse payload)
    {
        var normalizedQualification = (payload.Qualification ?? string.Empty).ToUpperInvariant();
        doctorForm.Specialization = InferSpecialization(normalizedQualification);
        doctorForm.Speciality = InferSpeciality(normalizedQualification);

        var years = InferExperienceYears(payload.DateOfRegistration);
        if (years.HasValue)
        {
            if (years.Value <= 5)
            {
                doctorForm.Experience = years.Value.ToString();
                doctorForm.ExperienceOtherYears = null;
            }
            else
            {
                doctorForm.Experience = "Other";
                doctorForm.ExperienceOtherYears = years.Value;
            }
        }

        verificationForm.Specialization = doctorForm.Specialization;

        profileEditContext?.Validate();
    }

    private void ApplyVerificationAutoFillFromPmdc(PmdcLookupApiResponse payload)
    {
        var inferredSpecialization = InferSpecialization(payload.Qualification ?? string.Empty);
        if (!string.IsNullOrWhiteSpace(inferredSpecialization))
        {
            verificationForm.Specialization = inferredSpecialization;
        }
    }

    private void SyncProfileFieldsFromVerification()
    {
        doctorForm.LicenceNumber = verificationForm.LicenceNumber;

        if (!string.IsNullOrWhiteSpace(verificationForm.Specialization))
        {
            doctorForm.Specialization = verificationForm.Specialization;
        }

        if (!string.IsNullOrWhiteSpace(pmdcQualification))
        {
            doctorForm.Speciality = InferSpeciality(pmdcQualification);

            if (string.IsNullOrWhiteSpace(doctorForm.Specialization))
            {
                var inferred = InferSpecialization(pmdcQualification);
                if (!string.IsNullOrWhiteSpace(inferred))
                {
                    doctorForm.Specialization = inferred;
                }
            }
        }

        var years = InferExperienceYears(pmdcDateOfRegistration);
        if (years.HasValue)
        {
            if (years.Value <= 5)
            {
                doctorForm.Experience = years.Value.ToString();
                doctorForm.ExperienceOtherYears = null;
            }
            else
            {
                doctorForm.Experience = "Other";
                doctorForm.ExperienceOtherYears = years.Value;
            }
        }

        profileEditContext?.Validate();
    }

    private static string InferSpecialization(string qualification)
    {
        if (qualification.Contains("FCPS", StringComparison.OrdinalIgnoreCase)) return "FCPS";
        if (qualification.Contains("MS", StringComparison.OrdinalIgnoreCase)) return "MS (Ophthalmology)";
        if (qualification.Contains("MD", StringComparison.OrdinalIgnoreCase)) return "MD";
        if (qualification.Contains("MBBS", StringComparison.OrdinalIgnoreCase)) return "MBBS";
        return string.Empty;
    }

    private static string InferSpeciality(string qualification)
    {
        if (qualification.Contains("OPTOMET", StringComparison.OrdinalIgnoreCase)) return "Optometrist";
        if (qualification.Contains("OPTICIAN", StringComparison.OrdinalIgnoreCase)) return "Optician";
        if (qualification.Contains("OCULARIST", StringComparison.OrdinalIgnoreCase)) return "Ocularist";
        return "Ophthalmologist";
    }

    private static int? InferExperienceYears(string? dateOfRegistration)
    {
        if (string.IsNullOrWhiteSpace(dateOfRegistration))
        {
            return null;
        }

        if (!DateTime.TryParse(dateOfRegistration, out var parsedDate))
        {
            return null;
        }

        var years = DateTime.UtcNow.Year - parsedDate.Year;
        if (parsedDate.Date > DateTime.UtcNow.AddYears(-years))
        {
            years--;
        }

        return Math.Clamp(years, 1, 30);
    }

