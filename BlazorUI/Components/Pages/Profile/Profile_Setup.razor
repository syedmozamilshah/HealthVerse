@* M-2 CALLING THE API TO GETTING DOCTOR PROFILE *@
    private async Task LoadProfile()
    {
        try
        {
            var client = await ApiClient.SetAuthorizedHeader();
            if (client.DefaultRequestHeaders.Authorization == null)
            {
                ToastComponent?.ShowDangerToast("Unauthorized", "Please login again.");
                Navigation.NavigateTo("/login", true);
                return;
            }
            var httpResponse = await client.GetAsync("api/Doctor/get/profile");

            if (!httpResponse.IsSuccessStatusCode)
            {
                var errorContent = await httpResponse.Content.ReadAsStringAsync();
                ToastComponent?.ShowDangerToast("Fetch Failed", $"Status: {httpResponse.StatusCode}");
                return;
            }

            var payload = await httpResponse.Content.ReadFromJsonAsync<DoctorResponseDto>();

            if (payload?.IsSuccess != true)
            {
                ToastComponent?.ShowDangerToast("Fetch Failed", payload?.Message ?? "Failed to fetch profile.");
                return;
            }

            var d = payload.doctor;
            if (d == null)
            {
                ToastComponent?.ShowDangerToast("Fetch Failed", "Doctor profile data is missing.");
                return;
            }

            // Store doctor ID for SignalR notifications
            _doctorId = d.Id;
            await HubClient.SetDoctorIdAsync(_doctorId);
            
            doctorForm.IsVerified     = d.IsVerified;
            doctorForm.IsSubmittedForVerification = d.IsSubmittedForVerification;
            doctorForm.IsReVerificationRequired = d.IsReVerificationRequired;
            doctorForm.IsLicenseInfoLocked = d.IsLicenseInfoLocked;
            doctorForm.LicenceNumber  = d.LicenceNumber ?? "";
            doctorForm.Speciality     = d.Speciality ?? "";
            doctorForm.IsAvailable    = d.IsAvailable;
            doctorForm.ClinicLocation = d.ClinicInfo?.Location ?? "";
            doctorForm.Experience     = NormalizeExperience(d.Experience);
            doctorForm.Fee            = ParseIntSafe(d.Fee);
            doctorForm.Specialization = d.Specialization ?? "";
            doctorForm.ImageUrl       = d.ImageUrl ?? "";
            doctorForm.RenewalDate    = d.RenewalDate == default ? DateTime.Now : d.RenewalDate;

            // Load verification documents into verificationForm
            verificationForm.LicenceNumber = d.LicenceNumber ?? "";
            verificationForm.Specialization = d.Specialization ?? "";
            verificationForm.CnicFrontImage = d.CnicFrontImage ?? "";
            verificationForm.CnicBackImage = d.CnicBackImage ?? "";
            verificationForm.MbbsImage = d.MbbsImage ?? "";
            verificationForm.FcpsImage = d.FcpsImage ?? "";
            verificationForm.LicenseImage = d.LicenseImage ?? "";
            ClearPmdcLookupState();
            lastPmdcLookupLicense = doctorForm.LicenceNumber ?? string.Empty;
            
            
            DateTime startDateTime = d.AvailableTimeMorning?.StartTime == default 
                ? DateTime.Today.AddHours(9) 
                : d.AvailableTimeMorning?.StartTime ?? DateTime.Today.AddHours(9);
            
            DateTime endDateTime = d.AvailableTimeMorning?.EndTime == default 
                ? DateTime.Today.AddHours(17) 
                : d.AvailableTimeMorning?.EndTime ?? DateTime.Today.AddHours(17);

            startTime = TimeOnly.FromTimeSpan(startDateTime.TimeOfDay);
            endTime   = TimeOnly.FromTimeSpan(endDateTime.TimeOfDay);
            
            availabilityDate = d.AvailabilityDate == default ? DateTime.Today : d.AvailabilityDate;

            InitializeAvailabilityDates();
            
            if (d.AvailabilityDates?.Any() == true)
            {
                availabilityDates.Clear();
                foreach (var date in d.AvailabilityDates)
                {
                    availabilityDates.Add(date.Date);
                }
            }

            if (d.DailyAvailabilities != null && d.DailyAvailabilities.Any())
            {
                dailyAvailability.Clear();
                foreach (var day in d.DailyAvailabilities)
                {
                    // Use literal time directly without timezone conversion
                    var dateLocal = day.Date;
                    var startLocal = day.StartTime;
                    var endLocal = day.EndTime;
                    
                    var dateOnly = dateLocal.Date;
                    var st = TimeOnly.FromTimeSpan(startLocal.TimeOfDay);
                    var et = TimeOnly.FromTimeSpan(endLocal.TimeOfDay);
                    dailyAvailability[dateOnly] = new DayTimeRange(st, et);
                    availabilityDates.Add(dateOnly);
                    
                    Console.WriteLine($"Loaded availability: Date={dateOnly:yyyy-MM-dd}, Start={st}, End={et}");
                }
            }

            ToastComponent?.ShowSuccessToast("Loaded", "Profile fetched successfully.");
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Error", ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

@* M-2 CALLING THE API TO UPDATE DOCTOR PROFILE *@
    private async Task SubmitProfile()
    {
        try
        {
            if (isEditingLockedFields && !doctorForm.IsSubmittedForVerification)
            {
                bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "You have edited PMDC-verified fields. This will require re-verification by the admin. Do you want to apply for re-verification and save your profile changes?");
                if (!confirm)
                {
                    return;
                }

                var revClient = await ApiClient.SetAuthorizedHeader();
                var requestBody = new
                {
                    licence_number = doctorForm.LicenceNumber,
                    specialization = doctorForm.Specialization,
                    reason = "Updating PMDC license information from basic profile"
                };
                
                var responseRev = await revClient.PostAsJsonAsync("api/DoctorVerification/submit-reverification", requestBody);
                if (responseRev.IsSuccessStatusCode)
                {
                    doctorForm.IsReVerificationRequired = true;
                    doctorForm.IsVerified = false;
                    isEditingLockedFields = false;
                    ToastComponent?.ShowSuccessToast("Re-verification", "Re-verification requested successfully.");
                    
                    verificationForm.LicenceNumber = doctorForm.LicenceNumber ?? "";
                    verificationForm.Specialization = doctorForm.Specialization ?? "";
                }
                else
                {
                    var error = await responseRev.Content.ReadAsStringAsync();
                    ToastComponent?.ShowDangerToast("Failed", $"Could not submit re-verification request: {error}");
                    return;
                }
            }

            // validate clinic address client-side
            if (string.IsNullOrWhiteSpace(doctorForm.ClinicLocation) || doctorForm.ClinicLocation.Trim().Length < 10 || doctorForm.ClinicLocation.Trim().Length > 150)
            {
                ToastComponent?.ShowDangerToast("Error", "Please enter a valid clinic address (10-150 characters). ");
                return;
            }

            // Licence number length check (exactly 7 chars)
            if (string.IsNullOrWhiteSpace(doctorForm.LicenceNumber) || doctorForm.LicenceNumber.Trim().Length != 7)
            {
                ToastComponent?.ShowDangerToast("Error", "Licence number must be exactly 7 characters.");
                return;
            }

            // Experience validation: if "Other" enforce ExperienceOtherYears between 1 and 30
            if (doctorForm.Experience == "Other")
            {
                if (!doctorForm.ExperienceOtherYears.HasValue || doctorForm.ExperienceOtherYears.Value < 1 || doctorForm.ExperienceOtherYears.Value > 30)
                {
                    ToastComponent?.ShowDangerToast("Error", "Please enter experience between 1 and 30 years.");
                    return;
                }
            }
            else
            {
                // if a numeric experience string was chosen, ensure it's within allowed bounds
                if (!string.IsNullOrWhiteSpace(doctorForm.Experience) && int.TryParse(new string(doctorForm.Experience.Where(char.IsDigit).ToArray()), out var expVal))
                {
                    if (expVal <= 0 || expVal > 30)
                    {
                        ToastComponent?.ShowDangerToast("Error", "Experience must be between 1 and 30 years.");
                        return;
                    }
                }
            }

            // Consultation fee maximum
            if (doctorForm.Fee > 5000)
            {
                ToastComponent?.ShowDangerToast("Validation Error", "Consultation fee cannot exceed 5000 PKR.");
                return;
            }

            isVisible = true;
            StateHasChanged();
            
            var client = await ApiClient.SetAuthorizedHeader();
            if (client.DefaultRequestHeaders.Authorization == null)
            {
                ToastComponent?.ShowDangerToast("Unauthorized", "Please login again.");
                Navigation.NavigateTo("/login", true);
                return;
            }

            var content = new MultipartFormDataContent();

            content.Add(new StringContent(doctorForm.LicenceNumber ?? string.Empty), "LicenceNumber");
            content.Add(new StringContent(doctorForm.Speciality ?? string.Empty), "Speciality");
            var experienceValue = doctorForm.Experience == "Other"
                ? (doctorForm.ExperienceOtherYears?.ToString() ?? "0")
                : doctorForm.Experience;
            content.Add(new StringContent(experienceValue ?? string.Empty), "Experience");
            content.Add(new StringContent(doctorForm.Fee.ToString(System.Globalization.CultureInfo.InvariantCulture)), "Fee");
            content.Add(new StringContent(doctorForm.Specialization ?? string.Empty), "Specialization");
            content.Add(new StringContent(doctorForm.IsAvailable.ToString().ToLower()), "IsAvailable");
            content.Add(new StringContent(doctorForm.RenewalDate.ToString("o")), "RenewalDate");

            content.Add(new StringContent(doctorForm.ClinicLocation ?? string.Empty), "ClinicInfo.Location");

            var startDateTime = CreateDateTimeFromTimeSpan(startTime);
            var endDateTime   = CreateDateTimeFromTimeSpan(endTime);
            content.Add(new StringContent(startDateTime.ToString("s")), "AvailableTimeMorning.StartTime");
            content.Add(new StringContent(endDateTime.ToString("s")), "AvailableTimeMorning.EndTime");

            int i = 0;
            foreach (var kv in dailyAvailability.OrderBy(k => k.Key))
            {
                var dateOnly = kv.Key.Date;
                var st = dateOnly.Add(kv.Value.Start.ToTimeSpan());
                var et = dateOnly.Add(kv.Value.End.ToTimeSpan());
                
                // Create date at noon (prevents timezone date shifts)
                var dateUtc = new DateTime(dateOnly.Year, dateOnly.Month, dateOnly.Day, 12, 0, 0, DateTimeKind.Unspecified);
                
                // Use literal slot times
                var stUnspecified = DateTime.SpecifyKind(st, DateTimeKind.Unspecified);
                var etUnspecified = DateTime.SpecifyKind(et, DateTimeKind.Unspecified);
                
                content.Add(new StringContent(dateUtc.ToString("s")), $"DailyAvailabilities[{i}].Date");
                content.Add(new StringContent(stUnspecified.ToString("s")), $"DailyAvailabilities[{i}].StartTime");
                content.Add(new StringContent(etUnspecified.ToString("s")), $"DailyAvailabilities[{i}].EndTime");
                i++;
            }
            Console.WriteLine($"=== Finished preparing availabilities ===");

            // Use stored bytes instead of opening stream again (avoids JS interop issues)
            if (uploadedImageBytes != null && uploadedImageBytes.Length > 0)
            {
                var streamContent = new ByteArrayContent(uploadedImageBytes);
                streamContent.Headers.ContentType = new MediaTypeHeaderValue(uploadedImageContentType ?? "image/jpeg");
                content.Add(streamContent, "image_url", uploadedImageName ?? "profile.jpg");
            }

            var resp = await client.PostAsync("api/Doctor/profile/update", content);

            if (resp.IsSuccessStatusCode)
            {
                // Reload the profile to reflect saved data
                await LoadProfile();

                if (activeTab == "schedule")
                {
                    ToastComponent?.ShowSuccessToast("Saved", "Schedule saved successfully!");
                }
                else
                {
                    ToastComponent?.ShowSuccessToast("Saved", "Profile updated successfully!");
                    // Navigate to the Verification tab after saving clinic info
                    activeTab = "verification";
                }
            }
            else
            {
                var errorContent = await resp.Content.ReadAsStringAsync();
                ToastComponent?.ShowDangerToast("Save Failed", $"Status: {errorContent}");
            }
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Error", ex.Message);
        }
        finally
        {
            isVisible = false;
            StateHasChanged();
        }
    }

