        profileEditContext = new EditContext(doctorForm);
        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var client = await ApiClient.SetAuthorizedHeader();
            if (client.DefaultRequestHeaders.Authorization == null)
            {
                // Not logged in - redirect to login
                Navigation.NavigateTo("/", true);
                return;
            }

            await CheckSubscriptionStatus();
            await LoadProfile();
            await HubClient.StartAsync();

            if (!_hubSubscribed)
            {
                _hubSubscribed = true;
                HubClient.VerificationStatusChanged += HandleVerificationStatusChanged;
            }
        }
    }

@* M-10 CHECK SUBSCRIPTION STATUS *@
    private async Task CheckSubscriptionStatus()
    {
        try
        {
            var client = await ApiClient.SetAuthorizedHeader();
            var response = await client.GetAsync("api/Doctor/get/profile");
            
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<DoctorProfileResponse>();
                if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Doctor != null)
                {
                    subscriptionProfile = apiResponse.Doctor;
                    
                    // Check actual subscription status from Stripe API
                    var subResponse = await client.GetAsync("api/Stripe/doctor/subscription-status");
                    if (subResponse.IsSuccessStatusCode)
                    {
                        var subResult = await subResponse.Content.ReadFromJsonAsync<SubscriptionStatusResult>();
                        isSubscriptionActive = subResult?.IsSubscribed ?? false;
                    }
                    
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error checking subscription: {ex.Message}");
        }
    }

    private class SubscriptionStatusResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("isSubscribed")]
        public bool IsSubscribed { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("subscriptionStatus")]
        public string? SubscriptionStatus { get; set; }
    }

@* M-10 START STRIPE CHECKOUT *@
    private async Task StartStripeCheckout()
    {
        try
        {
            isProcessingCheckout = true;
            StateHasChanged();

            var client = await ApiClient.SetAuthorizedHeader();
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            
            var checkoutRequest = new
            {
                doctorId = _doctorId,
                successUrl = $"{baseUrl}/payment-success",
                cancelUrl = $"{baseUrl}/profile-setup"
            };

            var response = await client.PostAsJsonAsync("api/Stripe/doctor/create-checkout-session", checkoutRequest);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CheckoutResponse>();
                if (result?.IsSuccess == true && !string.IsNullOrEmpty(result.SessionUrl))
                {
                    Navigation.NavigateTo(result.SessionUrl, true);
                }
                else
                {
                    ToastComponent?.ShowDangerToast("Error", result?.Message ?? "Failed to create checkout session");
                }
            }
            else
            {
                ToastComponent?.ShowDangerToast("Error", "Failed to create checkout session");
            }
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Error", $"Error: {ex.Message}");
        }
        finally
        {
            isProcessingCheckout = false;
            StateHasChanged();
        }
    }

