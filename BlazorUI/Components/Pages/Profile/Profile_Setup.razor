        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Error", ex.Message);
        }
        finally
        {
            isSubmittingVerification = false;
            StateHasChanged();
        }
    }

    private async Task OnImageUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                if (file.Size > 5 * 1024 * 1024)
                {
                    ToastComponent?.ShowDangerToast("Error", "File size must be less than 5MB");
                    return;
                }

                if (!file.ContentType.StartsWith("image/"))
                {
                    ToastComponent?.ShowDangerToast("Error", "Please select an image file");
                    return;
                }

                ToastComponent?.ShowInfoToast("Uploading", "Processing image...");

                // Store file bytes immediately to avoid JS interop issues later
                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                uploadedImageBytes = ms.ToArray();
                uploadedImageContentType = file.ContentType;
                uploadedImageName = file.Name;

                var base64 = Convert.ToBase64String(uploadedImageBytes);
                doctorForm.ImageUrl = $"data:{file.ContentType};base64,{base64}";
                uploadedImageFile = file;

                ToastComponent?.ShowSuccessToast("Success", "Image updated successfully!");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Error", $"Failed to upload image: {ex.Message}");
        }
    }

    private async Task<string> ConvertToBase64(IBrowserFile file)
    {
        using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();
        var base64 = Convert.ToBase64String(bytes);
        return $"data:{file.ContentType};base64,{base64}";
    }

