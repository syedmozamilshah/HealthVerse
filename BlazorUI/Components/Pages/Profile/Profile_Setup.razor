    private static string NormalizeExperience(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        var digits = new string(value.Where(char.IsDigit).ToArray());
        if (string.IsNullOrEmpty(digits)) return value;
        var years = int.Parse(digits);
        return years <= 5 ? years.ToString() : "Other";
    }

    private static int ParseIntSafe(string? s)
        => int.TryParse(new string((s ?? "").Where(char.IsDigit).ToArray()), out var n) ? n : 0;

    private static DateTime CreateDateTimeFromTimeSpan(TimeOnly time)
        => DateTime.Today.Add(time.ToTimeSpan());

    private void OpenTimeEditor(DateTime date)
    {
        if (date.Date < DateTime.Today.Date) return;
        selectedDate = date.Date;
        if (dailyAvailability.TryGetValue(selectedDate.Value, out var existing))
        {
            selectedStartTimeString = existing.Start.ToString("HH:mm");
            selectedEndTimeString   = existing.End.ToString("HH:mm");
        }
        else
        {
            selectedStartTimeString = "09:00";
            selectedEndTimeString   = "17:00";
        }
        StateHasChanged();
    }

    private void InitializeAvailabilityDates()
    {
        availabilityDates.Clear();
        dailyAvailability.Clear();
    }

    private void OnAvailabilityToggleChanged()
    {
        if (doctorForm.IsAvailable)
        {
            InitializeAvailabilityDates();
        }
        else
        {
            availabilityDates.Clear();
            dailyAvailability.Clear();
            selectedDate = null;
        }
        StateHasChanged();
    }

    private void SaveSelectedDateTime()
    {
        if (!selectedDate.HasValue) return;
        if (!TimeOnly.TryParse(selectedStartTimeString, out var st)) return;
        if (!TimeOnly.TryParse(selectedEndTimeString, out var et)) return;
        if (st < minDayTime) st = minDayTime;
        if (et > maxDayTime) et = maxDayTime;
        if (et <= st)
        {
            ToastComponent?.ShowDangerToast("Invalid time", "End time must be after start time.");
            return;
        }

        var date = selectedDate.Value.Date;
        dailyAvailability[date] = new DayTimeRange(st, et);
        availabilityDates.Add(date);

        var next = date.AddDays(1);
        var lastWindow = DateTime.Today.AddDays(13).Date;
        selectedDate = next <= lastWindow ? next : null;
        if (selectedDate.HasValue)
        {
            selectedStartTimeString = st.ToString("HH:mm");
            selectedEndTimeString   = et.ToString("HH:mm");
        }
        StateHasChanged();
    }

    private void SkipSelectedDate()
    {
        if (!selectedDate.HasValue) return;
        var date = selectedDate.Value.Date;
        dailyAvailability.Remove(date);
        availabilityDates.Remove(date);

        var next = date.AddDays(1);
        var lastWindow = DateTime.Today.AddDays(13).Date;
        selectedDate = next <= lastWindow ? next : null;
        StateHasChanged();
    }

