    private async Task OnDocumentUpload(InputFileChangeEventArgs e, string documentType)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                if (file.Size > 5 * 1024 * 1024)
                {
                    ToastComponent?.ShowDangerToast("Error", "File size must be less than 5MB");
                    return;
                }

                // Allow only PNG, JPEG images
                var allowedTypes = new[] { "image/png", "image/jpeg", "image/jpg" };
                var allowedExtensions = new[] { ".png", ".jpg", ".jpeg" };
                var extension = Path.GetExtension(file.Name).ToLowerInvariant();
                
                if (!allowedTypes.Contains(file.ContentType.ToLowerInvariant()) && !allowedExtensions.Contains(extension))
                {
                    ToastComponent?.ShowDangerToast("Error", "Only PNG and JPEG image files are allowed");
                    return;
                }

                // Read file bytes immediately to avoid JS interop issues later
                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var fileBytes = ms.ToArray();
                
                var base64 = Convert.ToBase64String(fileBytes);
                var imageUrl = $"data:{file.ContentType};base64,{base64}";

                switch (documentType)
                {
                    case "cnic_front":
                        verificationForm.CnicFrontImage = imageUrl;
                        cnicFrontFile = file;
                        cnicFrontBytes = fileBytes;
                        break;
                    case "cnic_back":
                        verificationForm.CnicBackImage = imageUrl;
                        cnicBackFile = file;
                        cnicBackBytes = fileBytes;
                        break;
                    case "mbbs":
                        verificationForm.MbbsImage = imageUrl;
                        mbbsFile = file;
                        mbbsBytes = fileBytes;
                        break;
                    case "fcps":
                        verificationForm.FcpsImage = imageUrl;
                        fcpsFile = file;
                        fcpsBytes = fileBytes;
                        break;
                    case "license":
                        verificationForm.LicenseImage = imageUrl;
                        licenseFile = file;
                        licenseBytes = fileBytes;
                        break;
                }

                ToastComponent?.ShowSuccessToast("Uploaded", $"Document uploaded successfully");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Error", $"Failed to upload document: {ex.Message}");
        }
    }

