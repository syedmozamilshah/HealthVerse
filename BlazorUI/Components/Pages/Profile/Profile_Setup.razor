    private void OnProfileNewPasswordInput(ChangeEventArgs e)
    {
        var val = e?.Value?.ToString() ?? string.Empty;
        newPassword = val;
        UpdateProfilePasswordCriteria(val);
    }

    private void UpdateProfilePasswordCriteria(string val)
    {
        psHasMinLength = val.Length >= 8;
        psHasLowercase = System.Text.RegularExpressions.Regex.IsMatch(val, "[a-z]");
        psHasUppercase = System.Text.RegularExpressions.Regex.IsMatch(val, "[A-Z]");
        psHasDigit = System.Text.RegularExpressions.Regex.IsMatch(val, "[0-9]");
        psHasSpecial = System.Text.RegularExpressions.Regex.IsMatch(val, "[\\W_]");
        var satisfied = new []{psHasMinLength, psHasLowercase, psHasUppercase, psHasDigit, psHasSpecial}.Count(b => b);
        if (satisfied >= 5) psPasswordClass = "password-input-strong";
        else if (satisfied == 0) psPasswordClass = string.Empty;
        else psPasswordClass = "password-input-weak";
        StateHasChanged();
    }

    @* M-1 USED FOR PASSWORD UPDATION EMAIL *@

    private async Task UpdatePassword()
    {
        passwordError = string.Empty;
        passwordSuccess = string.Empty;
        
        // Validate inputs
        if (string.IsNullOrWhiteSpace(currentPassword))
        {
            passwordError = "Current password is required";
            return;
        }
        if (string.IsNullOrWhiteSpace(newPassword))
        {
            passwordError = "New password is required";
            return;
        }
        // Ensure criteria reflect current password (covers paste/autofill)
        UpdateProfilePasswordCriteria(newPassword);
        var satisfied = new []{psHasMinLength, psHasLowercase, psHasUppercase, psHasDigit, psHasSpecial}.Count(b => b);
        if (satisfied < 5)
        {
            passwordError = "Please choose a stronger password (must satisfy all 5 criteria).";
            return;
        }
        if (newPassword.Length < 8)
        {
            passwordError = "New password must be at least 8 characters";
            return;
        }
        if (newPassword != confirmPassword)
        {
            passwordError = "New passwords do not match";
            return;
        }
        
        try
        {
            isUpdatingPassword = true;
            StateHasChanged();
            
            var client = await ApiClient.SetAuthorizedHeader();
            var request = new { PreviousPassword = currentPassword, NewPassword = newPassword };
            var response = await client.PostAsJsonAsync("/api/auth/reset-password", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResponse>();
                if (result?.IsSuccess == true)
                {
                    passwordSuccess = "Password updated successfully!";
                    await ToastComponent!.ShowSuccessToast("Success", "Password updated successfully!");
                    // Clear the fields
                    currentPassword = string.Empty;
                    newPassword = string.Empty;
                    confirmPassword = string.Empty;
                }
                else
                {
                    passwordError = result?.Message ?? "Failed to update password";
                }
            }
            else
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResponse>();
                passwordError = result?.Message ?? "Current password is incorrect";
            }
        }
        catch (Exception ex)
        {
            passwordError = "An error occurred. Please try again.";
            Console.WriteLine($"Password update error: {ex.Message}");
        }
        finally
        {
            isUpdatingPassword = false;
            StateHasChanged();
        }
    }
    
    private async Task SendForgotPasswordEmail()
    {
        try
        {
            passwordError = string.Empty;
            passwordSuccess = string.Empty;
            
            // Get user email from session storage
            var currentUserResult = await SessionStorage.GetAsync<LoginUser>("currentUser");
            var userEmail = currentUserResult.Success ? currentUserResult.Value?.Email : null;
            
            if (string.IsNullOrEmpty(userEmail))
            {
                passwordError = "Unable to get your email address. Please try again later.";
                return;
            }
            
            var client = HttpClientFactory.CreateClient("API");
            var request = new { email = userEmail, profileType = "doctor" };
            var response = await client.PostAsJsonAsync("/api/auth/forgot-password", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResponse>();
                passwordSuccess = result?.Message ?? "Password reset link has been sent to your email!";
                await ToastComponent!.ShowSuccessToast("Email Sent", "Check your email for password reset instructions.");
            }
            else
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResponse>();
                passwordError = result?.Message ?? "Failed to send reset email. Please try again.";
            }
        }
        catch (Exception ex)
        {
            passwordError = "An error occurred. Please try again.";
            Console.WriteLine($"Forgot password error: {ex.Message}");
        }
        StateHasChanged();
    }
    
