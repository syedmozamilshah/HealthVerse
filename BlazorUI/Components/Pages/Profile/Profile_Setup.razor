    private async Task SubmitVerification()
    {
        try
        {
            isSubmittingVerification = true;
            StateHasChanged();

            // Validate required fields
            var missingFields = new List<string>();
            // if (string.IsNullOrEmpty(verificationForm.CnicFrontImage)) missingFields.Add("CNIC Front");
            // if (string.IsNullOrEmpty(verificationForm.CnicBackImage)) missingFields.Add("CNIC Back");
            if (string.IsNullOrEmpty(verificationForm.MbbsImage)) missingFields.Add("MBBS Degree");
            if (string.IsNullOrEmpty(verificationForm.LicenseImage)) missingFields.Add("PMDC License");
            if (string.IsNullOrEmpty(verificationForm.LicenceNumber)) missingFields.Add("License Number");
            if (string.IsNullOrEmpty(verificationForm.Specialization)) missingFields.Add("Specialization");

            if (missingFields.Any())
            {
                ToastComponent?.ShowDangerToast("Missing Fields", $"Please provide: {string.Join(", ", missingFields)}");
                return;
            }

            // if (!await ValidateCnicWithWebhook())
            // {
            //     return;
            // }

            var client = await ApiClient.SetAuthorizedHeader();
            var content = new MultipartFormDataContent();

            content.Add(new StringContent(verificationForm.LicenceNumber), "LicenceNumber");
            content.Add(new StringContent(verificationForm.Specialization), "Specialization");

            // Add document files using stored bytes (avoids JS interop issues)
            if (cnicFrontBytes != null && cnicFrontBytes.Length > 0 && cnicFrontFile != null)
            {
                var byteContent = new ByteArrayContent(cnicFrontBytes);
                byteContent.Headers.ContentType = new MediaTypeHeaderValue(cnicFrontFile.ContentType);
                content.Add(byteContent, "cnic_front_image", cnicFrontFile.Name);
            }

            if (cnicBackBytes != null && cnicBackBytes.Length > 0 && cnicBackFile != null)
            {
                var byteContent = new ByteArrayContent(cnicBackBytes);
                byteContent.Headers.ContentType = new MediaTypeHeaderValue(cnicBackFile.ContentType);
                content.Add(byteContent, "cnic_back_image", cnicBackFile.Name);
            }

            if (mbbsBytes != null && mbbsBytes.Length > 0 && mbbsFile != null)
            {
                var byteContent = new ByteArrayContent(mbbsBytes);
                byteContent.Headers.ContentType = new MediaTypeHeaderValue(mbbsFile.ContentType);
                content.Add(byteContent, "mbbs_image", mbbsFile.Name);
            }

            if (fcpsBytes != null && fcpsBytes.Length > 0 && fcpsFile != null)
            {
                var byteContent = new ByteArrayContent(fcpsBytes);
                byteContent.Headers.ContentType = new MediaTypeHeaderValue(fcpsFile.ContentType);
                content.Add(byteContent, "fcps_image", fcpsFile.Name);
            }

            if (licenseBytes != null && licenseBytes.Length > 0 && licenseFile != null)
            {
                var byteContent = new ByteArrayContent(licenseBytes);
                byteContent.Headers.ContentType = new MediaTypeHeaderValue(licenseFile.ContentType);
                content.Add(byteContent, "license_image", licenseFile.Name);
            }

            var response = await client.PostAsync("api/DoctorVerification/submit", content);

            if (response.IsSuccessStatusCode)
            {
                doctorForm.IsSubmittedForVerification = true;
                SyncProfileFieldsFromVerification();
                activeTab = "profile";
                ToastComponent?.ShowSuccessToast("Submitted", "Your verification request has been submitted. Profile fields have been updated from PMDC.");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastComponent?.ShowDangerToast("Failed", $"Submission failed: {error}");
            }
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Error", ex.Message);
        }
        finally
        {
            isSubmittingVerification = false;
            StateHasChanged();
        }
    }

    private async Task<bool> ValidateCnicWithWebhook()
    {
        if (!await ValidateCnicFile(cnicFrontBytes, cnicFrontFile, "front"))
        {
            return false;
        }

        if (!await ValidateCnicFile(cnicBackBytes, cnicBackFile, "back"))
        {
            return false;
        }

        return true;
    }

    private async Task<bool> ValidateCnicFile(byte[]? fileBytes, IBrowserFile? file, string sideLabel)
    {
        if (fileBytes == null || fileBytes.Length == 0 || file == null)
        {
            ToastComponent?.ShowDangerToast("Validation Error", $"CNIC {sideLabel} image is missing.");
            return false;
        }

        try
        {
            using var validationClient = HttpClientFactory.CreateClient();
            validationClient.Timeout = TimeSpan.FromSeconds(30);

            using var validationContent = new MultipartFormDataContent();
            var dataContent = new ByteArrayContent(fileBytes);
            dataContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
            validationContent.Add(dataContent, "data", file.Name);

            var response = await validationClient.PostAsync(CnicValidationUrl, validationContent);
            if (!response.IsSuccessStatusCode)
            {
                var err = await response.Content.ReadAsStringAsync();
                Console.Error.WriteLine($"CNIC validation error ({sideLabel}): {err}");
                ToastComponent?.ShowDangerToast("Validation Error", $"CNIC {sideLabel} validation failed: {response.StatusCode}");
                return false;
            }

            var validationText = (await response.Content.ReadAsStringAsync()).Trim();
            Console.WriteLine($"CNIC validation response ({sideLabel}): {validationText}");

            if (!string.Equals(validationText, "CNIC", StringComparison.OrdinalIgnoreCase))
            {
                await JSRuntime.InvokeVoidAsync("alert", $"CNIC {sideLabel} validation failed. Please upload a valid CNIC image.");
                return false;
            }

            return true;
        }
        catch (TaskCanceledException tce)
        {
            ToastComponent?.ShowDangerToast("Validation Timeout", $"CNIC {sideLabel} validation timed out. Please try again later.");
            Console.Error.WriteLine($"CNIC validation timeout ({sideLabel}): {tce.Message}");
            return false;
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Validation Error", $"Failed to validate CNIC {sideLabel}. Please try again.");
            Console.Error.WriteLine($"CNIC validation exception ({sideLabel}): {ex}");
            return false;
        }
    }


    private async Task SubmitReVerification()
    {
