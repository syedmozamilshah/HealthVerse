                            <div style="width: 40px; height: 40px; background: #dee2e6; border-radius: 50%; border: 2px solid white; margin-left: -15px; display:flex; align-items:center; justify-content:center;"><i class="bi bi-person text-muted"></i></div>
                            <div style="width: 40px; height: 40px; background: #ced4da; border-radius: 50%; border: 2px solid white; margin-left: -15px; display:flex; align-items:center; justify-content:center;"><i class="bi bi-person text-muted"></i></div>
                            <div style="width: 40px; height: 40px; background: #155d42; color: white; border-radius: 50%; border: 2px solid white; margin-left: -15px; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;">500+</div>
                        </div>
                        <div>
                            <div class="fw-bold text-dark">500+ Specialists</div>
                            <div class="small text-muted">Trusted by professionals</div>
                        </div>
                    </div>
                </div>

                <!-- Right Side -->
