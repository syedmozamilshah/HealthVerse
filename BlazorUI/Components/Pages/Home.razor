            <!-- Small-screen Quick Stats (visible only on mobile) -->
            <div class="row d-lg-none">
                <div class="col-12">
                    <div class="stats-card d-block">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0">Quick Stats</h6>
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2">Live</span>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="p-2 bg-light rounded-3 h-100 text-center">
                                    <i class="bi bi-people text-success mb-1 fs-5"></i>
                                    <div class="fw-bold h6 mb-0">2,847</div>
                                    <small class="text-muted" style="font-size: 0.7rem;">Patients</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 bg-light rounded-3 h-100 text-center">
                                    <i class="bi bi-robot text-success mb-1 fs-5"></i>
                                    <div class="fw-bold h6 mb-0">12,459</div>
                                    <small class="text-muted" style="font-size: 0.7rem;">AI Consults</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 bg-light rounded-3 h-100 text-center">
                                    <i class="bi bi-eye text-success mb-1 fs-5"></i>
                                    <div class="fw-bold h6 mb-0">156</div>
                                    <small class="text-muted" style="font-size: 0.7rem;">Specialists</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 bg-light rounded-3 h-100 text-center">
                                    <i class="bi bi-shield-check text-success mb-1 fs-5"></i>
                                    <div class="fw-bold h6 mb-0">98.7%</div>
                                    <small class="text-muted" style="font-size: 0.7rem;">Success</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Features Section -->
            <div class="row justify-content-center mb-5 pb-5">
                <div class="col-12 text-center mb-5">
                    <h3 class="fw-bold mb-3">Designed for Eye Care Professionals</h3>
                    <p class="text-muted">Comprehensive tools for ophthalmologists, optometrists, opticians, and ocularists</p>
                </div>
                <div class="col-md-4 mb-4 mb-md-0">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <h5 class="fw-bold mb-3">Patient Management</h5>
                        <p class="text-muted mb-0">Track patient history, symptoms, and appointments in one centralized dashboard.</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4 mb-md-0">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-robot"></i>
                        </div>
                        <h5 class="fw-bold mb-3">AI Consultation</h5>
                        <p class="text-muted mb-0">Specialized AI agents for each eye care discipline to assist with diagnoses.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-prescription2"></i>
                        </div>
                        <h5 class="fw-bold mb-3">Smart Prescriptions</h5>
                        <p class="text-muted mb-0">Generate and manage prescriptions with AI-powered recommendations.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code{
    private bool isAuthenticated = false;
    
    protected override async Task OnInitializedAsync()
    {
        // Only restore authentication state, don't auto-redirect
        // User should click a button (Login, Signup, Get Started) to navigate
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User?.Identity?.IsAuthenticated == true;
    }

    private void NavigateToDashboard()
    {
        if (isAuthenticated)
        {
            Navigation.NavigateTo("/dashboard", true);
        }
        else
        {
            Navigation.NavigateTo("/login", true);
        }
    }
}