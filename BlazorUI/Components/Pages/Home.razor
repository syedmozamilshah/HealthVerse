                    <small class="text-muted" style="font-size: 0.8rem; letter-spacing: 0.5px;">Eye Specialist Platform</small>
                </div>
            </div>
            <div class="d-flex align-items-center d-none d-md-flex">
                <a @onclick="NavigateToDashboard" style="cursor: pointer;" class="nav-link-custom">Dashboard</a>
                <a href="/register" class="btn-get-started">Get Started</a>
            </div>

            <!-- Mobile nav (compact) -->
            <div class="d-flex align-items-center d-md-none gap-2">
                <a @onclick="NavigateToDashboard" style="cursor: pointer;" class="nav-link-custom">Dashboard</a>
                <a href="/register" class="btn-get-started" style="padding:6px 14px; font-size:0.9rem;">Get Started</a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1">
