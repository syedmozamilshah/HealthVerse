                                        <div class="fw-bold h5 mb-0">2,847</div>
                                        <small class="text-muted" style="font-size: 0.7rem;">Active Patients</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-3 bg-light rounded-3 h-100">
                                        <i class="bi bi-robot text-success mb-2 fs-5"></i>
                                        <div class="fw-bold h5 mb-0">12,459</div>
                                        <small class="text-muted" style="font-size: 0.7rem;">AI Consultations</small>
