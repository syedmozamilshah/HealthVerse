    private string GetDisplayStatus(AppointmentModelDtos appt)
    {
        var status = appt.Status?.ToLower() ?? "pending";
        
        // If status is done, keep it as done
        if (status == "done") return "done";
        
        // Ensure appt.AppointmentDate is treated as UTC
        var appointmentUtc = appt.AppointmentDate.Kind == DateTimeKind.Unspecified 
            ? DateTime.SpecifyKind(appt.AppointmentDate, DateTimeKind.Utc)
            : appt.AppointmentDate;
        
        // If appointment date is in the past (PKT) and status is not done, mark as missed
        var appointmentPkt = TimeZoneInfo.ConvertTime(appointmentUtc, GetPakistanTimeZone());
        if (appointmentPkt < DateTimeHelper.GetPakistanNow() && status != "done")
        {
            return "missed";
        }
        
        return status;
    }

@* M-8 CALLING APIS TO GET THE APPOINTMENT DETAILS *@
    private async Task OpenAppointmentDetails(AppointmentModelDtos appt)
    {
        var displayStatus = GetDisplayStatus(appt);
        
        // Check if appointment has consultation history (status is done means there's a record)
        if (displayStatus == "done")
        {
            // Has record - navigate to patient details with chat
            Navigation.NavigateTo($"/patient-details/{appt.PatientId}");
        }
        else
        {
            // Check if there are any previous "done" appointments for this patient
            var hasHistory = allAppointments.Any(a => 
                a.PatientId == appt.PatientId && 
                GetDisplayStatus(a) == "done");
            
            if (hasHistory)
            {
                // Has previous consultation history - navigate to patient details
                Navigation.NavigateTo($"/patient-details/{appt.PatientId}");
            }
            else
            {
                // No record found - show modal
                selectedAppointmentForModal = appt;
                showNoRecordModal = true;
            }
        }
    }

