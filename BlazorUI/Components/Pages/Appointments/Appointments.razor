    private async Task StartSession(string appointmentId)
    {
        try
        {
            var client = await ApiClient.SetAuthorizedHeader();
            @* M-4 START APPOINTMENT SESSION *@
            var response = await client.PostAsync($"api/Appointment/start-session/{appointmentId}", null);
            
            if (response.IsSuccessStatusCode)
            {
                ToastComponent?.ShowSuccessToast("Success", "Session started successfully");
                await LoadAllAppointments();
                FilterAppointmentsByDate();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastComponent?.ShowDangerToast("Error", BuildStartSessionErrorMessage(error));
            }
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Error", $"Failed to start session: {ex.Message}");
        }
    }
    
    private async Task CompleteSession(string appointmentId)
    {
        try
        {
            var client = await ApiClient.SetAuthorizedHeader();
            var response = await client.PostAsync($"api/Appointment/complete-session/{appointmentId}", null);
            
            if (response.IsSuccessStatusCode)
            {
                ToastComponent?.ShowSuccessToast("Success", "Session completed successfully");
                await LoadAllAppointments();
                FilterAppointmentsByDate();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastComponent?.ShowDangerToast("Error", $"Could not complete session: {error}");
            }
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Error", $"Failed to complete session: {ex.Message}");
        }
    }

    private bool CanStartAppointment(AppointmentModelDtos appt)
    {
        if (appt.SlotStartTime == null) return false;
        
        // Ensure slot time is treated as UTC
        var slotUtc = appt.SlotStartTime.Value.Kind == DateTimeKind.Unspecified
            ? DateTime.SpecifyKind(appt.SlotStartTime.Value, DateTimeKind.Utc)
            : appt.SlotStartTime.Value;
        
        // Convert to PKT for comparison
        var slotPkt = TimeZoneInfo.ConvertTime(slotUtc, GetPakistanTimeZone());
        var nowPkt = DateTimeHelper.GetPakistanNow();
        
        return nowPkt >= slotPkt;
    }

    private string BuildStartSessionErrorMessage(string responseContent)
    {
        if (string.IsNullOrWhiteSpace(responseContent))
        {
            return "Could not start session.";
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(responseContent);
            var root = doc.RootElement;
            var message = TryGetStringProperty(root, "message") ?? "Could not start session.";

            if (TryGetUtcDateTime(root, "appointmentStartUtc", out var startUtc)
                && TryGetUtcDateTime(root, "appointmentEndUtc", out var endUtc))
            {
                // Convert to PKT for display
                var startPkt = TimeZoneInfo.ConvertTime(startUtc, GetPakistanTimeZone());
                var endPkt = TimeZoneInfo.ConvertTime(endUtc, GetPakistanTimeZone());
                return $"Session can only be started between {startPkt:hh:mm tt} and {endPkt:hh:mm tt} (Pakistan Time).";
            }

            return message;
        }
        catch
        {
            return responseContent;
        }
    }

    private static string? TryGetStringProperty(System.Text.Json.JsonElement root, string propertyName)
    {
        foreach (var prop in root.EnumerateObject())
        {
            if (string.Equals(prop.Name, propertyName, StringComparison.OrdinalIgnoreCase))
            {
                return prop.Value.GetString();
            }
        }

        return null;
    }

    private static bool TryGetUtcDateTime(System.Text.Json.JsonElement root, string propertyName, out DateTime value)
    {
        value = default;

        foreach (var prop in root.EnumerateObject())
        {
            if (!string.Equals(prop.Name, propertyName, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var rawValue = prop.Value.GetString();
            if (string.IsNullOrWhiteSpace(rawValue))
            {
                return false;
            }

            return DateTime.TryParse(
                rawValue,
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal,
                out value);
        }

        return false;
    }

    private TimeZoneInfo GetPakistanTimeZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Asia/Karachi");
        }
        catch (TimeZoneNotFoundException)
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Pakistan Standard Time");
        }
    }
