@rendermode InteractiveServer
@page "/appointments"
@using System.Net.Http.Json
@using BlazorUI.Authentication
@using BlazorUI.Models
@using BlazorUI.Models.AppointmentModel
@using BlazorUI.Models.UserDto
@using BlazorUI.Models.DoctorModel
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using NetcodeHub.Packages.Components.Toast
@using static NetcodeHub.Packages.Components.Toast.NetcodeHubToast
@using BlazorUI.Services
@inject ProtectedLocalStorage LocalStorage
@inject NavigationManager Navigation
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
<link href="app.css" rel="stylesheet" />

@* No Record Found Modal *@
@if (showNoRecordModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 16px; border: 1px solid #d8f3df;">
                <div class="modal-header border-0">
                    <h5 class="modal-title">
                        <i class="bi bi-info-circle text-warning me-2"></i>No Record Found
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-folder-x text-muted" style="font-size: 4rem;"></i>
                    <p class="mt-3 mb-0 text-muted">
                        @if (selectedAppointmentForModal != null)
                        {
                            <span>No previous consultation records found for <strong>@(selectedAppointmentForModal.Users.FirstName + " " + selectedAppointmentForModal.Users.LastName)</strong>.</span>
                            <br/>
                            <small class="text-secondary">
                                @if (GetDisplayStatus(selectedAppointmentForModal) == "missed")
                                {
                                    <span>This appointment was missed on @GetAppointmentDateDisplay(selectedAppointmentForModal).</span>
                                }
                                else
                                {
                                    <span>This appointment is scheduled for @GetAppointmentFullDisplay(selectedAppointmentForModal).</span>
                                }
                            </small>
                        }
                        else
                        {
                            <span>No consultation history available for this patient.</span>
                        }
                    </p>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@* Prescription Details Modal *@
@if (showPrescriptionModal && selectedAppointmentForPrescription != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
                <div class="modal-header text-white" style="background-color: #198754; border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    <h5 class="modal-title mb-0">
                        <i class="bi bi-file-earmark-medical me-2"></i>Prescription Details
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="ClosePrescriptionModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <strong>Patient:</strong> @(selectedAppointmentForPrescription.Users.FirstName + " " + selectedAppointmentForPrescription.Users.LastName)
                        </div>
                        <div>
                            <strong>Date:</strong> @GetAppointmentFullDisplay(selectedAppointmentForPrescription)
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <strong>Diagnosis:</strong> @(string.IsNullOrEmpty(selectedAppointmentForPrescription.Diagnosis) ? "N/A" : selectedAppointmentForPrescription.Diagnosis)
                    </div>

                    @if (selectedAppointmentForPrescription.Prescriptions != null && selectedAppointmentForPrescription.Prescriptions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle" style="border: 1px solid #dee2e6;">
                                <thead style="background-color: #d1e7dd;">
                                    <tr>
                                        <th>Medicine</th>
                                        <th>Dosage</th>
                                        <th>Frequency</th>
                                        <th>Duration</th>
                                        <th>Instructions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var med in selectedAppointmentForPrescription.Prescriptions)
                                    {
                                        <tr>
                                            <td class="fw-bold">@med.MedicineName</td>
                                            <td>@med.Dosage</td>
                                            <td>@med.Frequency</td>
                                            <td>@med.Duration</td>
                                            <td>@med.Instructions</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>No medicines prescribed for this appointment.
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 bg-light rounded-bottom" style="border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <button type="button" class="btn btn-secondary" @onclick="ClosePrescriptionModal">
                        <i class="bi bi-x-circle me-1"></i>Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="container-fluid py-3" style="background: linear-gradient(135deg, #e3ffe6 0%, #d0f0db 35%, #f7fff9 100%); min-height: 100vh;">
    <div class="row g-3">
        
        @* Sidebar (desktop only) *@
        <div class="col-12 col-lg-2 d-none d-lg-block">
            <div class="card h-100" style="border-radius: 16px; background: linear-gradient(180deg, #e9ffe8 0%, #ffffff 60%); border: 1px solid #d8f3df;">
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <img src="images/logo.png" alt="logo" class="img-fluid" style="max-width: 36px;">
                            <div>
                                <div class="fw-bold">HEALTHVERSE</div>
                                <div class="text-muted small">Your Digital Health Companion</div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2 text-muted">Menu:</div>
                    <div class="list-group list-group-flush">
                        <a @onclick='() => Navigation.NavigateTo("/dashboard", replace: true)'
                           class="list-group-item list-group-item-action"
                           style="cursor:pointer; border-radius:10px;">
                            <i class="bi bi-people me-2"></i>Patients
                        </a>
                        <a class="list-group-item list-group-item-action" 
                           style="background-color:#34c759; color:#ffffff; border-radius:10px; border-color:#34c759; cursor:pointer;">
                            <i class="bi bi-calendar2-check me-2"></i>Appointments
                        </a>
                        <div class="mt-3 text-muted">Help And Settings:</div>
                        <a class="list-group-item list-group-item-action" style="cursor:pointer;" @onclick='() => Navigation.NavigateTo("/help")'>
                            <i class="bi bi-question-circle me-2"></i>Help
                        </a>
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" style="cursor:pointer;" href="/profile-setup">
                            <span><i class="bi bi-gear me-2"></i>Settings</span>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                        <a class="list-group-item list-group-item-action" style="cursor:pointer;" @onclick='() => Navigation.NavigateTo("/logout")'>
                            <i class="bi bi-box-arrow-right me-2"></i>Log Out
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* Mobile offcanvas sidebar (Blazor-controlled) *@
        @if (isSidebarOpen)
        {
            <div class="custom-backdrop" @onclick="CloseSidebar"></div>
        }

        <div class="d-lg-none">
            <div class="custom-offcanvas @(isSidebarOpen ? string.Empty : "custom-offcanvas-hide")" role="dialog" aria-modal="true">
                <div class="mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <img src="images/logo.png" alt="logo" class="img-fluid" style="max-width: 36px;">
                        <div>
                            <div class="fw-bold">HEALTHVERSE</div>
                            <div class="text-muted small">Your Digital Health Companion</div>
                        </div>
                    </div>
                </div>
                <div class="mb-2 text-muted">Menu:</div>
                <div class="list-group list-group-flush">
                    <a @onclick='() => { CloseSidebar(); Navigation.NavigateTo("/dashboard", replace: true); }'
                       class="list-group-item list-group-item-action" style="cursor:pointer; border-radius:10px;">
                        <i class="bi bi-people me-2"></i>Patients
                    </a>
                    <a class="list-group-item list-group-item-action" style="background-color:#34c759; color:#ffffff; border-radius:10px; border-color:#34c759; cursor:pointer;">
                        <i class="bi bi-calendar2-check me-2"></i>Appointments
                    </a>
                    <div class="mt-3 text-muted">Help And Settings:</div>
                    <a class="list-group-item list-group-item-action" style="cursor:pointer;" @onclick='() => { CloseSidebar(); Navigation.NavigateTo("/profile-setup"); }'>
                        <i class="bi bi-question-circle me-2"></i>Help
                    </a>
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" style="cursor:pointer;" href="/profile-setup">
                        <span><i class="bi bi-gear me-2"></i>Settings</span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <a class="list-group-item list-group-item-action" style="cursor:pointer;" @onclick='() => { CloseSidebar(); Navigation.NavigateTo("/logout"); }'>
                        <i class="bi bi-box-arrow-right me-2"></i>Log Out
                    </a>
                </div>
            </div>
        </div>

        @* Main Content *@
        <div class="col-12 col-lg-10">
            <div class="row g-3">
                
                @* Header *@
                <div class="col-12">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <button class="btn btn-light d-lg-none me-2" type="button" @onclick="ToggleSidebar">
                                <i class="bi bi-list"></i>
                            </button>
                            <h2 class="mb-0">
                                <i class="bi bi-calendar2-check me-2"></i>Appointments Calendar
                            </h2>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <button class="btn btn-outline-success" @onclick="GoToToday">
                                <i class="bi bi-calendar-date me-1"></i>Today
                            </button>
                        </div>
                    </div>
                </div>

                @* Calendar Section *@
                <div class="col-12 col-lg-4">
                    <div class="card" style="border: 1px solid #d8f3df; border-radius: 16px; box-shadow: 0 6px 14px rgba(0,0,0,.04);">
                        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                            <button class="btn btn-sm btn-outline-success" @onclick="PreviousMonth">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <span>@currentMonth.ToString("MMMM yyyy")</span>
                            <button class="btn btn-sm btn-outline-success" @onclick="NextMonth">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                        <div class="card-body">
                            @* Days of week header *@
                            <div class="row text-center mb-2">
                                @foreach (var day in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                                {
                                    <div class="col fw-semibold text-muted small">@day</div>
                                }
                            </div>
                            
                            @* Calendar grid *@
                            @foreach (var week in GetCalendarWeeks())
                            {
                                <div class="row text-center mb-1">
                                    @foreach (var day in week)
                                    {
                                        var appointmentsOnDay = GetAppointmentsForDate(day);
                                        var isSelected = day.Date == selectedDate.Date;
                                        var isToday = day.Date == DateTimeHelper.GetPakistanNow().Date;
                                        var isCurrentMonth = day.Month == currentMonth.Month;
                                        var hasAppointments = appointmentsOnDay.Count > 0;
                                        
                                        <div class="col p-1">
                                            <button class="btn btn-sm w-100 position-relative @GetDayButtonClass(day, isSelected, isToday, isCurrentMonth, hasAppointments)"
                                                    style="@GetDayButtonStyle(isSelected, isToday, isCurrentMonth)"
                                                    @onclick="() => SelectDate(day)">
                                                @day.Day
                                                @if (hasAppointments)
                                                {
                                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                                                        @appointmentsOnDay.Count
                                                    </span>
                                                }
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @* Summary Cards *@
                    <div class="row g-3 mt-2">
                        <div class="col-6">
                            <div class="card text-center" style="border: 1px solid #d8f3df; border-radius: 12px;">
                                <div class="card-body py-2">
                                    <div class="text-muted small">Total</div>
                                    <div class="fw-bold fs-4 text-success">@(allAppointments?.Count ?? 0)</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card text-center" style="border: 1px solid #d8f3df; border-radius: 12px;">
                                <div class="card-body py-2">
                                    <div class="text-muted small">Selected Day</div>
                                    <div class="fw-bold fs-4 text-primary">@filteredAppointments.Count</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Appointments List *@
                <div class="col-12 col-lg-8">
                    <div class="card" style="border: 1px solid #d8f3df; border-radius: 16px; box-shadow: 0 6px 14px rgba(0,0,0,.04);">
                        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                            <span>
                                <i class="bi bi-list-ul me-2"></i>
                                Appointments for @selectedDate.ToDisplayString("dddd, MMMM dd, yyyy")
                            </span>
                            @if (selectedDate.Date == DateTimeHelper.GetPakistanNow().Date)
                            {
                                <span class="badge bg-success">Today</span>
                            }
                            else if (selectedDate.Date > DateTimeHelper.GetPakistanNow().Date)
                            {
                                <span class="badge bg-info">Upcoming</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Past</span>
                            }
                        </div>
                        <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                            @if (!isAuthorized)
                            {
                                <div class="text-center py-5">
                                    <div class="spinner-border text-success" role="status">
                                        <span class="visually-hidden">Checking access…</span>
                                    </div>
                                </div>
                            }
                            else if (isLoading)
                            {
                                <div class="text-center py-5">
                                    <div class="spinner-border text-success" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p class="mt-2 text-muted">Loading appointments...</p>
                                </div>
                            }
                            else if (filteredAppointments.Count == 0)
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                                    <p class="mt-2 text-muted">No appointments scheduled for this date.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var appt in filteredAppointments.OrderBy(a => a.AppointmentDate))
                                {
                                    var displayStatus = GetDisplayStatus(appt);
                                    <div class="card mb-2 appointment-card" 
                                         style="border: 1px solid #e9ecef; border-radius: 12px; cursor: pointer; transition: all 0.2s;"
                                         @onclick="() => OpenAppointmentDetails(appt)">
                                        <div class="card-body py-2">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div class="d-flex align-items-center gap-3">
                                                    <img src="@(string.IsNullOrEmpty(appt.Users.ProfileImage) ? "images/doctor-avatar.png" : appt.Users.ProfileImage)" 
                                                         alt="@appt.Users.FirstName" 
                                                         class="rounded-circle" 
                                                         width="48" height="48" 
                                                         style="border: 2px solid #e6f7ec; object-fit: cover;">
                                                    <div>
                                                        <div class="fw-semibold">@(appt.Users.FirstName + " " + appt.Users.LastName)</div>
                                                        <div class="text-muted small">
                                                            <i class="bi bi-clock me-1"></i>@GetAppointmentTimeDisplay(appt)
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (displayStatus == "done")
                                                    {
                                                        <span class="badge bg-success">DONE</span>
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowPrescriptionDetails(appt)" @onclick:stopPropagation="true">
                                                            <i class="bi bi-file-earmark-medical"></i> Prescription
                                                        </button>
                                                    }
                                                    else if (displayStatus == "pending")
                                                    {
                                                        <span class="badge bg-warning text-dark">PENDING</span>
                                                    }
                                                    else if (displayStatus == "missed")
                                                    {
                                                        <span class="badge bg-danger">MISSED</span>
                                                    }
                                                    else if (appt.Status?.ToLower() == "confirmed")
                                                    {
                                                        <span class="badge bg-primary">CONFIRMED</span>
                                                        <button class="btn btn-sm btn-success" 
                                                                disabled="@(!CanStartAppointment(appt))"
                                                                @onclick="() => StartSession(appt.Id)" 
                                                                @onclick:stopPropagation="true"
                                                                title="@(!CanStartAppointment(appt) ? "Appointment time not reached yet" : "Start session")">
                                                            <i class="bi bi-play-circle me-1"></i>Start
                                                        </button>
                                                    }
                                                    else if (appt.Status?.ToLower() == "in-progress")
                                                    {
                                                        <span class="badge bg-info">IN-PROGRESS</span>
                                                        <button class="btn btn-sm btn-primary" @onclick="() => CompleteSession(appt.Id)" @onclick:stopPropagation="true">
                                                            <i class="bi bi-check-circle me-1"></i>Complete
                                                        </button>
                                                    }
                                                    else if (appt.Status?.ToLower() == "completed")
                                                    {
                                                        <span class="badge bg-success">COMPLETED</span>
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowPrescriptionDetails(appt)" @onclick:stopPropagation="true">
                                                            <i class="bi bi-file-earmark-medical"></i> Prescription
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-info">@displayStatus.ToUpper()</span>
                                                    }
                                                    <i class="bi bi-chevron-right text-muted"></i>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(appt.Diagnosis))
                                            {
                                                <div class="mt-2 small text-muted">
                                                    <i class="bi bi-clipboard2-pulse me-1"></i>
                                                    <strong>Diagnosis:</strong> @appt.Diagnosis
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .appointment-card:hover {
        background-color: #f8fff9 !important;
        border-color: #34c759 !important;
        transform: translateX(4px);
    }

    .custom-offcanvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 260px;
        height: 100vh;
        background: linear-gradient(180deg, #e9ffe8 0%, #ffffff 60%);
        padding: 1rem;
        box-shadow: 6px 0 20px rgba(0,0,0,0.12);
        z-index: 1055;
        transform: translateX(0);
        transition: transform 220ms ease-in-out;
    }

    .custom-offcanvas-hide {
        transform: translateX(-110%);
    }

    .custom-backdrop {
        position: fixed;
        inset: 0;
        background-color: rgba(0,0,0,0.45);
        z-index: 1050;
    }

    @@media (max-width: 768px) {
        .card .card-header .btn { padding: .35rem .5rem; }
        .custom-offcanvas { width: 84%; }
        .appointment-card { padding: .6rem; }
        .card-body[style*="max-height"] { max-height: 360px !important; }
    }

    @@media (max-width: 480px) {
        .custom-offcanvas { width: 92%; }
        .appointment-card img { width: 40px; height: 40px; }
    }
</style>

@code {
    private NetcodeHubToast? ToastComponent;
    private bool isSidebarOpen = false;
    private bool isLoading = true;
    private bool isAuthorized = false;
    private DateTime currentMonth = DateTimeHelper.GetPakistanNow().Date;
    private DateTime selectedDate = DateTimeHelper.GetPakistanNow().Date;
    private List<AppointmentModelDtos> allAppointments = new();
    private List<AppointmentModelDtos> filteredAppointments = new();
    private bool showNoRecordModal = false;
    private AppointmentModelDtos? selectedAppointmentForModal;
    
    private bool showPrescriptionModal = false;
    private AppointmentModelDtos? selectedAppointmentForPrescription;

    private DoctorProfile? doctorProfile;

    protected override async Task OnInitializedAsync()
    {
        var client = await ApiClient.SetAuthorizedHeader();
        if (client.DefaultRequestHeaders.Authorization == null)
        {
            // Not logged in - redirect to login
            Navigation.NavigateTo("/", true);
            return;
        }

        await LoadDoctorProfile();

        if (doctorProfile == null)
        {
            Navigation.NavigateTo("/profile-setup", true);
            return;
        }

        if (!doctorProfile.IsVerified)
        {
            Navigation.NavigateTo("/profile-setup", true);
            return;
        }

        // Check actual subscription status from Stripe API
        var subscriptionStatus = await GetSubscriptionStatus();
        if (!subscriptionStatus.IsSubscribed)
        {
            Navigation.NavigateTo("/payment-due", true);
            return;
        }

        isAuthorized = true;

        await LoadAllAppointments();
        FilterAppointmentsByDate();
    }

    private async Task<SubscriptionStatusResult> GetSubscriptionStatus()
    {
        try
        {
            var client = await ApiClient.SetAuthorizedHeader();
            var response = await client.GetAsync("api/Stripe/doctor/subscription-status");
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SubscriptionStatusResult>();
                return result ?? new SubscriptionStatusResult { IsSubscribed = false };
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error checking subscription: {ex.Message}");
        }
        return new SubscriptionStatusResult { IsSubscribed = false };
    }

    private class SubscriptionStatusResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("isSubscribed")]
        public bool IsSubscribed { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("subscriptionStatus")]
        public string? SubscriptionStatus { get; set; }
    }

    private async Task LoadDoctorProfile()
    {
        try
        {
            var client = await ApiClient.SetAuthorizedHeader();
            var response = await client.GetAsync("api/Doctor/get/profile");
            
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<DoctorProfileResponse>();
                if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Doctor != null)
                {
                    doctorProfile = apiResponse.Doctor;
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading doctor profile: {ex.Message}");
        }
    }


@* M-8 CALLING APIS TO GET THE APPOINTMENTS *@
    private async Task LoadAllAppointments()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var client = await ApiClient.SetAuthorizedHeader();
            @* M-4 GET ALL APPOINTMENTS *@
            var response = await client.GetAsync("api/Doctor/get/appointments");

            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<AppointmentDtosResponse>();
                if (apiResponse != null && apiResponse.IsSuccess && apiResponse.AppointmentDtos != null)
                {
                    // Normalize all appointment dates to UTC (API sends dates without explicit timezone info)
                    allAppointments = apiResponse.AppointmentDtos.Select(appt =>
                    {
                        appt.AppointmentDate = DateTime.SpecifyKind(appt.AppointmentDate, DateTimeKind.Utc);
                        if (appt.SlotStartTime.HasValue)
                            appt.SlotStartTime = DateTime.SpecifyKind(appt.SlotStartTime.Value, DateTimeKind.Utc);
                        if (appt.SlotEndTime.HasValue)
                            appt.SlotEndTime = DateTime.SpecifyKind(appt.SlotEndTime.Value, DateTimeKind.Utc);
                        return appt;
                    }).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading appointments: {ex.Message}");
            ToastComponent?.ShowDangerToast("Error", "Failed to load appointments");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterAppointmentsByDate()
    {
        filteredAppointments = allAppointments
            .Where(a => a.AppointmentDate.IsSameDateInPakistan(selectedDate))
            .OrderBy(a => a.AppointmentDate)
            .ToList();
    }

