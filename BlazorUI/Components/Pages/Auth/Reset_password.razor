@rendermode InteractiveServer

@page "/change-password"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using System.Net.Http.Headers
@using System.Linq
@using BlazorUI.Authentication
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using NetcodeHub.Packages.Components.Toast
@using BlazorUI.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject IHttpClientFactory HttpClientFactory
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

@inject ApiClient ApiClient
@inject ProtectedLocalStorage LocalStorage



<NetcodeHubToast @ref="ToastComponent" 
                 Position="bottom-right" 
                 Duration="1000" 
                 Persist="false" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<style>
    /* Password strength UI (reset page) */
    .password-criteria { display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:0.5rem; }
    .criteria-item { padding:6px 10px; border-radius:999px; font-size:0.875rem; display:inline-flex; align-items:center; gap:6px; }
    .criteria-item.success { background: rgba(25,135,84,0.06); color:#198754; border:1px solid rgba(25,135,84,0.12); }
    .criteria-item.danger { background: rgba(220,53,69,0.04); color:#dc3545; border:1px solid rgba(220,53,69,0.08); }
    .password-input-strong { box-shadow: 0 0 0 0.2rem rgba(25,135,84,0.12); border-color: #198754 !important; }
    .password-input-weak { box-shadow: 0 0 0 0.2rem rgba(220,53,69,0.08); border-color: #dc3545 !important; }
    .password-toggle { transition: all 0.3s ease; cursor: pointer; border: 1px solid #dee2e6; border-left: none; }
    .password-toggle:hover { background-color: #e2e6ea !important; }
    .password-toggle:hover i { color: #198754 !important; }
</style>


<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center"
     style="background: linear-gradient(180deg, #ffffff 10%, #94c979 100%)">

    <div class="col-lg-8 bg-white shadow-lg rounded-4 p-5 border">
        <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-success m-0">
                <i class="bi bi-person-badge me-2"></i>Reset Password
            </h3>
            <p class="text-muted mb-0 small">
                Please enter your new password below.
            </p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-light fs-6"
                    @onclick='() => Navigation.NavigateTo("/profile-setup", replace: true)'>
                <i class="bi bi-x fs-4" style="color: black;"></i>
            </button>
        </div>


    </div>

     <EditForm Model="@passwordModel" OnValidSubmit="ChangePassword">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label>Current Password</label>
                    <InputText @bind-Value="passwordModel.CurrentPassword"
                        type="password"
                        class="form-control rounded-3 form-control-modern"
                        id="currentPasswordInput"
                        placeholder="Current Password" />
                <ValidationMessage For="@(() => passwordModel.CurrentPassword)" class="text-danger small"/>
                </div>
                <div class="mb-3">
                    <label>New Password</label>
                    <div class="input-group">
                        <InputText Value="@passwordModel.NewPassword" 
                            ValueExpression="@(() => passwordModel.NewPassword)"
                            ValueChanged="@((string s) => OnNewPasswordInputManual(s))"
                            type="@rpPasswordType"
                            class="@($"form-control rounded-start-3 rounded-end-0 form-control-modern {rpPasswordClass}")"
                            id="newPasswordInput"
                            placeholder="New Password"
                            style="border-right: none;" />
                        <span class="input-group-text bg-white rounded-end-3 password-toggle" @onclick="ToggleNewPasswordVisibility">
                            <i class="@rpPasswordIcon text-muted"></i>
                        </span>
                    </div>

                    <ValidationMessage For="@(() => passwordModel.NewPassword)" class="text-danger small"/>

                    <div class="mt-2">
                    <small class="d-block mb-1 text-muted">Password must meet at least 3 of the following:</small>
                    <div class="password-criteria">
                        <span class="criteria-item @(rpHasMinLength ? "success" : "danger")">
                            <i class="bi @(rpHasMinLength ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                            Min 6
                        </span>
                        <span class="criteria-item @(rpHasLowercase ? "success" : "danger")">
                            <i class="bi @(rpHasLowercase ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                            Lowercase
                        </span>
                        <span class="criteria-item @(rpHasUppercase ? "success" : "danger")">
                            <i class="bi @(rpHasUppercase ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                            Uppercase
                        </span>
                        <span class="criteria-item @(rpHasDigit ? "success" : "danger")">
                            <i class="bi @(rpHasDigit ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                            Number
                        </span>
                        <span class="criteria-item @(rpHasSpecial ? "success" : "danger")">
                            <i class="bi @(rpHasSpecial ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                            Special
                        </span>
                    </div>
                </div>
                </div>
                <div class="mb-3">
                    <label>Confirm Password</label>
                    <div class="input-group">
                        <InputText @bind-Value="passwordModel.ConfirmPassword"
                            type="@rpConfirmPasswordType"
                            class="form-control rounded-start-3 rounded-end-0 form-control-modern"
                            id="confirmPasswordInput"
                            placeholder="Confirm Password"
                            style="border-right: none;" />
                        <span class="input-group-text bg-white rounded-end-3 password-toggle" @onclick="ToggleConfirmPasswordVisibility">
                            <i class="@rpConfirmPasswordIcon text-muted"></i>
                        </span>
                    </div>
                    <ValidationMessage For="@(() => passwordModel.ConfirmPassword)" class="text-danger small"/>
                </div>

                <button type="submit" 
                        class="btn btn-success w-100" 
                        disabled="@isVisible" >
                    @if (isVisible)
                    {
                        <span class="spinner-border text-light" style="width: 2rem; height: 2rem;" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <span>Update Password</span>
                    }
                </button>
            </EditForm>
    
    </div>
</div>

<style>
    @@media (max-width: 768px) {
        .col-lg-8 { padding: 1.25rem !important; margin: 0 12px; }
        .col-lg-8 .p-5 { padding: 1rem !important; }
        .btn { width: 100%; }
        .form-control { font-size: 1rem; }
    }
</style>



@code{

    bool isVisible = false;
    private NetcodeHubToast? ToastComponent;

    private PasswordModel passwordModel = new PasswordModel();
    // Password strength flags for reset page
    bool rpHasMinLength = false;
    bool rpHasLowercase = false;
    bool rpHasUppercase = false;
    bool rpHasDigit = false;
    bool rpHasSpecial = false;
    string rpPasswordClass = string.Empty;
    bool showNewPassword = false;
    bool showConfirmPassword = false;

    string rpPasswordType => showNewPassword ? "text" : "password";
    string rpPasswordIcon => showNewPassword ? "bi bi-eye" : "bi bi-eye-slash";
    string rpConfirmPasswordType => showConfirmPassword ? "text" : "password";
    string rpConfirmPasswordIcon => showConfirmPassword ? "bi bi-eye" : "bi bi-eye-slash";

    void ToggleNewPasswordVisibility()
    {
        showNewPassword = !showNewPassword;
    }

    void ToggleConfirmPasswordVisibility()
    {
        showConfirmPassword = !showConfirmPassword;
    }

   private void OnNewPasswordInputManual(string val)
{
    // Update the model manually since we aren't using simple @bind-Value
    passwordModel.NewPassword = val;
    
    // Run your validation logic
    UpdateRpPasswordCriteria(val);
}

    private void UpdateRpPasswordCriteria(string val)
{
    if (string.IsNullOrEmpty(val))
    {
        rpHasMinLength = rpHasLowercase = rpHasUppercase = rpHasDigit = rpHasSpecial = false;
        rpPasswordClass = string.Empty;
    }
    else
    {
        rpHasMinLength = val.Length >= 6;
        rpHasLowercase = val.Any(char.IsLower);
        rpHasUppercase = val.Any(char.IsUpper);
        rpHasDigit = val.Any(char.IsDigit);
        // Using char.IsPunctuation or IsSymbol is more reliable than Regex in some cases
        rpHasSpecial = val.Any(ch => !char.IsLetterOrDigit(ch));

        var satisfied = new[] { rpHasMinLength, rpHasLowercase, rpHasUppercase, rpHasDigit, rpHasSpecial }.Count(b => b);

        if (satisfied >= 5) rpPasswordClass = "password-input-strong";
        else if (satisfied == 0) rpPasswordClass = string.Empty;
        else rpPasswordClass = "password-input-weak";
    }

    // Force Blazor to re-render the criteria spans
    StateHasChanged();
}

@* M-1 CALLING API FOR MODERATION *@

    private async Task ChangePassword()
    {
        try
        {
            isVisible = true;
            StateHasChanged();

            @* var tokenResult = await SessionStorage.GetAsync<string>("authToken");
            var token = tokenResult.Success ? tokenResult.Value : null;
            Console.WriteLine("Retrieved token: " + token); *@
            var client = await ApiClient.SetAuthorizedHeader();
            if (client.DefaultRequestHeaders.Authorization == null)
            {
                ToastComponent?.ShowDangerToast("Unauthorized", "Please login again.");
                Navigation.NavigateTo("/login", true);
                return;
            }

            // Ensure criteria reflect the current NewPassword value (covers paste/autofill)
            UpdateRpPasswordCriteria(passwordModel.NewPassword);
            var satisfied = new []{rpHasMinLength, rpHasLowercase, rpHasUppercase, rpHasDigit, rpHasSpecial}.Count(b => b);
            if (satisfied <= 5)
            {
                await ToastComponent!.ShowDangerToast("Weak Password", "Please choose a stronger password (at least 5 of the listed criteria). ");
                return;
            }

            var request = new ResetPasswordRequest{
                PreviousPassword = passwordModel.CurrentPassword,
                NewPassword = passwordModel.NewPassword
            };
            Console.WriteLine("Request payload: " + System.Text.Json.JsonSerializer.Serialize(request));

            var response = await client.PostAsJsonAsync("/api/auth/reset-password", request);

            Console.WriteLine("Status code: " + response.StatusCode);
            Console.WriteLine("Response status: " + response.IsSuccessStatusCode);
            Console.WriteLine("response message: " + response.Content.ReadAsStringAsync().Result);


            if (response.IsSuccessStatusCode)
            {
                
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (result != null && result.IsSuccess)
                {
                    await ToastComponent!.ShowSuccessToast("Password Changed", result.Message);
                    Navigation.NavigateTo("/dashboard", replace: true);
                }
                else
                {
                    await ToastComponent!.ShowDangerToast("Error", result?.Message ?? "Password change failed");
                }

            }
            else
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                await ToastComponent!.ShowDangerToast("Error", "password not matched");
            }
        }
        catch (Exception ex)
        {
            isVisible = false;
                StateHasChanged();
                Console.WriteLine(ex.Message);
            await ToastComponent!.ShowDangerToast("Exception", "previous password don't matched");
        }
        finally
        {
            isVisible = false;  
            StateHasChanged();
        }

    }

    public class PasswordModel{
        [Required(ErrorMessage="Current Password is required")]
        public string CurrentPassword{get;set;}=string.Empty;

        [Required(ErrorMessage="New Password is required")]
        [MinLength(6, ErrorMessage="Password must be at least 6 characters long")]
        public string NewPassword{get;set;}=string.Empty;
        [Required(ErrorMessage="Confirm Password is required")]
        [Compare("NewPassword", ErrorMessage="Passwords do not match")]
        public string ConfirmPassword{get;set;}=string.Empty;
    }
    public class ResetPasswordRequest
    {
        [JsonPropertyName("previous_password")]
        public string PreviousPassword { get; set; } = string.Empty;

        [JsonPropertyName("new_password")]
        public string NewPassword { get; set; } = string.Empty;
    }
}