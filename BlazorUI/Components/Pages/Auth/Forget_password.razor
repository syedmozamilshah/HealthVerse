@rendermode InteractiveServer
@page "/forget-password"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using BlazorUI.Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.Components.Forms
@using NetcodeHub.Packages.Components.Toast
@inject IHttpClientFactory HttpClientFactory
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Navigation

<style>
    .forget-password-page {
        background: linear-gradient(135deg, #a8e6cf 0%, #dcedc1 100%);
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
    }
    .custom-card {
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        padding: 2.5rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .custom-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 1.5rem 4rem rgba(0,0,0,.15)!important;
    }
    
    .form-control-modern {
        transition: all 0.3s ease;
        border: 1px solid #dee2e6;
    }
    .form-control-modern:focus {
        border-color: #198754;
        box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.15);
        background-color: #fff !important;
    }
    .form-control-modern:hover {
        background-color: #f8f9fa !important;
        border-color: #ced4da;
    }

    .btn-modern {
        background-color: #198754;
        border: none;
        border-radius: 50px;
        padding: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    .btn-modern:hover {
        background-color: #146c43;
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(25, 135, 84, 0.3);
    }
    .btn-modern:active {
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(25, 135, 84, 0.3);
    }
    
    @@media (max-width: 768px) {
        .custom-card { padding: 1.25rem !important; margin: 0 12px; }
        .col-lg-5.col-md-6 { padding: 0; }
        .btn-modern { width: 100%; }
        .form-control { font-size: 1rem; }
    }

    .link-modern {
        position: relative;
        transition: all 0.3s ease;
        text-decoration: none;
    }
    .link-modern:hover {
        color: #146c43 !important;
        letter-spacing: 0.5px;
    }
</style>

<NetcodeHubToast @ref="ToastComponent" 
                 Position="bottom-right" 
                 Duration="4000" 
                 Persist="false" />

<div class="forget-password-page d-flex flex-column">
    
    <!-- Logo Header -->
    <div class="container-fluid pt-4 ps-5">
        <div class="d-flex align-items-center gap-2">
            <img src="images/logo.png" alt="HealthVerse" style="height: 45px;" />
            <div>
                <h5 class="fw-bold mb-0 text-dark" style="letter-spacing: 1px;">HEALTHVERSE</h5>
                <small class="text-muted" style="font-size: 0.85rem;">Your Digital Health Companion</small>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 d-flex align-items-center py-4">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                
                <!-- Left Side: Form -->
                <div class="col-lg-5 col-md-6 mb-5 mb-md-0">
                    <div class="bg-white custom-card">
                        <div class="mb-4">
                            <h3 class="fw-bold text-dark">Recover your account</h3>
                            <p class="text-muted">Enter your email to reset password</p>
                        </div>

                        <EditForm Model="@forgetModel" OnValidSubmit="SendRequest" FormName="ForgetForm">
                            <DataAnnotationsValidator />

                            <div class="form-floating mb-4">
                                <InputText @bind-Value="forgetModel.Email"
                                        type="email"
                                        class="form-control rounded-3 form-control-modern"
                                        id="emailInput"
                                        placeholder="name@example.com" />
                                <label for="emailInput">Email</label>
                                <ValidationMessage For="@(() => forgetModel.Email)" class="text-danger small"/>
                            </div>

                            <div class="d-grid mb-3">
                                <button type="submit" 
                                        class="btn btn-modern text-white shadow-sm" 
                                        disabled="@isVisible">
                                    @if (isVisible)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Sending...</span>
                                    }
                                    else
                                    {
                                        <span>Send Reset Link</span>
                                    }
                                </button>
                            </div>

                            <div class="text-center">
                                <span class="text-muted">Remember your password? </span>
                                <a href="/login" class="text-success fw-bold link-modern">Sign In</a>
                            </div>

                        </EditForm>
                    </div>
                </div>

                <!-- Right Side: Image -->
                <div class="col-lg-6 col-md-6 offset-lg-1 d-none d-md-block text-center">
                    <img src="images/hero-doctors.png" 
                         class="img-fluid" 
                         style="max-height: 85vh; object-fit: contain;" 
                         alt="Doctors Team" />
                </div>
            </div>
        </div>
    </div>
</div>



@code {
    bool isVisible = false;

    public class ForgetPasswordModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address")]
        public string Email { get; set; } = string.Empty;
        public string ProfileType{get;  set;}=string.Empty;
    }

    private ForgetPasswordModel forgetModel = new();
    private string apiResponse = "";
    private NetcodeHubToast? ToastComponent;

@* M-1 CALLING API FOR RECOVERY *@

    private async Task SendRequest()
    {
        try
        {
            isVisible = true;   
            StateHasChanged();
            Console.WriteLine("Submit clicked");
            forgetModel.ProfileType="doctor";

            var client = HttpClientFactory.CreateClient("API");
            var response = await client.PostAsJsonAsync("api/Auth/forgot-password", forgetModel);

            Console.WriteLine("Status code: " + response.StatusCode);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadAsStringAsync();
                Console.WriteLine("Raw API response: " + result);

                apiResponse = result;

                var loginResult = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (loginResult != null && loginResult.IsSuccess)
                {
                    await ToastComponent!.ShowSuccessToast("Recover successfully", "Email verification link has been sent to your email");
                    Navigation.NavigateTo("/"); 
                }
            }
            else
            {
                apiResponse = $"Error: {response.StatusCode}";
                await ToastComponent!.ShowDangerToast("Not registered", "unknown error");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception: don't matched the password" );
            apiResponse = $"Exception: {ex.Message}";
            Console.WriteLine(apiResponse);
            isVisible = true;   
            StateHasChanged();
            await ToastComponent!.ShowDangerToast("Error", "unknown error");
        }
        finally
        {
            isVisible = false;  
            StateHasChanged();
        }
    }
}
