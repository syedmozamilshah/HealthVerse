@rendermode InteractiveServer
@page "/login"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using BlazorUI.Authentication
@using BlazorUI.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using NetcodeHub.Packages.Components.Toast
@inject IHttpClientFactory HttpClientFactory
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JsRuntime
@using System.Text.Json.Serialization
@using Radzen.Blazor



<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
<link href="app.css" rel="stylesheet" />

<style>
    .login-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .login-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 1.5rem 4rem rgba(0,0,0,.15)!important;
    }
    
    .form-control-modern {
        transition: all 0.3s ease;
        border: 1px solid transparent;
    }
    .form-control-modern:focus {
        border-color: #198754;
        box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.15);
        background-color: #fff !important;
    }
    .form-control-modern:hover {
        background-color: #e2e6ea !important;
    }

    .btn-modern {
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        background-color: #198754;
        border: none;
    }
    .btn-modern:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(25, 135, 84, 0.3);
        background-color: #157347 !important;
    }
    .btn-modern:active {
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(25, 135, 84, 0.3);
    }

    .link-modern {
        position: relative;
        transition: all 0.3s ease;
    }
    .link-modern:hover {
        color: #146c43 !important;
        letter-spacing: 0.5px;
    }
    
    .password-toggle {
        transition: all 0.3s ease;
        cursor: pointer;
    }
    .password-toggle:hover {
        background-color: #e2e6ea !important;
    }
    .password-toggle:hover i {
        color: #198754 !important;
    }
    
    @@media (max-width: 768px) {
        .login-card { max-width: 540px; margin: 0 12px; }
        .col-md-6.p-5 { padding: 20px !important; }
        .btn-modern { width: 100%; padding: 12px 16px; }
        .form-control-lg { font-size: 1rem; padding: 10px 12px; }
    }
</style>

<NetcodeHubToast @ref="ToastComponent" 
                 Position="bottom-right" 
                 Duration="1000" 
                 Persist="false" />

<div class="min-vh-100 d-flex flex-column" style="background: linear-gradient(135deg, #a8e6cf 0%, #dcedc1 100%);">
    
    <!-- Logo Header -->
    <div class="container-fluid pt-4 ps-4">
        <div class="d-flex align-items-center gap-2">
            <img src="images/logo.png" alt="HealthVerse" style="height: 40px;" />
            <div>
                <h5 class="fw-bold mb-0 text-dark">HEALTHVERSE</h5>
                <small class="text-muted">Your Digital Health Companion</small>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 d-flex align-items-center justify-content-center p-4">
        <div class="card border-0 shadow-lg overflow-hidden login-card" style="max-width: 1000px; width: 100%; border-radius: 24px;">
            <div class="row g-0">
                
                <!-- Left Side: Form -->
                <div class="col-md-6 p-5 bg-white d-flex flex-column justify-content-center">
                    <div class="mb-4">
                        <h2 class="fw-bold text-dark">Welcome Back</h2>
                        <p class="text-muted">Sign in to continue your journey</p>
                    </div>

                    <EditForm Model="@formData" OnValidSubmit="SendRequest" FormName="LoginForm">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Email Address</label>
                            <InputText @bind-Value="formData.Email" 
                                     type="email" 
                                     class="form-control form-control-lg bg-light border-0 rounded-3 form-control-modern" 
                                     placeholder="221403@students.au.edu.pk" />
                            <ValidationMessage For="@(() => formData.Email)" class="text-danger small"/>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-muted small fw-bold">Password</label>
                            <div class="input-group">
                                <InputText @bind-Value="formData.Password"
                                         type="@passwordType"
                                         class="form-control form-control-lg bg-light border-0 rounded-start-3 form-control-modern"
                                         placeholder="••••••••••" />
                                <span class="input-group-text bg-light border-0 rounded-end-3 password-toggle" @onclick="TogglePasswordVisibility">
                                    <i class="@passwordIcon text-muted"></i>
                                </span>
                            </div>
                            <ValidationMessage For="@(() => formData.Password)" class="text-danger small"/>
                        </div>

                        <div class="d-grid mb-4">
                            <button type="submit" 
                                    class="btn btn-success btn-lg rounded-pill fw-bold btn-modern" 
                                    disabled="@isVisible">
                                @if (isVisible)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Signing In...</span>
                                }
                                else
                                {
                                    <span>Sign In</span>
                                }
                            </button>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted small">Forgot your password?</span>
                            <a href="/forget-password" class="text-success text-decoration-none small fw-bold link-modern">Reset Password</a>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Don't have an account?</span>
                            <a href="/register" class="text-success text-decoration-none small fw-bold link-modern">Sign Up</a>
                        </div>

                    </EditForm>
                </div>

                <!-- Right Side: Image -->
                <div class="col-md-6 d-none d-md-block position-relative bg-light">
                    <img src="images/hero-doctors.png" 
                         class="img-fluid w-100 h-100" 
                         style="object-fit: cover;" 
                         alt="Doctors Team" />
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    bool isVisible = false;
    bool showPassword = false;
    string passwordType => showPassword ? "text" : "password";
    string passwordIcon => showPassword ? "bi bi-eye" : "bi bi-eye-slash";

    void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private FormData formData = new();
    private string apiResponse = "";
    private NetcodeHubToast? ToastComponent;


@* M-1 CALLING API FOR LOGIN *@
    private async Task SendRequest()
    {
        try
        {
            isVisible = true;
            StateHasChanged();
            Console.WriteLine("Submit clicked");
            Console.WriteLine($"Email: {formData.Email}, Password: {formData.Password}");
            formData.ProfileType="doctor";

            var client = HttpClientFactory.CreateClient("API");
            var response = await client.PostAsJsonAsync("api/Auth/login", formData);

            Console.WriteLine("Status code: " + response.StatusCode);
            Console.WriteLine("Response status: " + response.IsSuccessStatusCode);

            // Read the response content
            var result = await response.Content.ReadAsStringAsync();
            Console.WriteLine("Raw API response: " + result);

            if (response.IsSuccessStatusCode)
            {
                apiResponse = result;

                var loginResult = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (loginResult != null && loginResult.IsSuccess)
                {
                    try
                    {
                        await JsRuntime.InvokeAsync<object>(
                            "authCookies.setDoctorSession",
                            loginResult.Token,
                            loginResult.RefreshToken,
                            loginResult.TokenExpired,
                            loginResult.RefreshExpired);
                        
                        Console.WriteLine("Doctor session cookies set successfully");
                        
                        await ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsAuthenticated(loginResult);
                        await SessionStorage.SetAsync("currentUser", loginResult.User);

                        apiResponse = $"Welcome {loginResult.User.FirstName}!";
                        await ToastComponent!.ShowSuccessToast("Login Successful", $"Welcome {loginResult.User.FirstName}");
                        Navigation.NavigateTo("/dashboard", forceLoad: true); 
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error during authentication setup: {ex.Message}");
                        apiResponse = $"Error: Failed to setup authentication session";
                        await ToastComponent!.ShowDangerToast("Authentication Error", "Failed to setup session. Please try again.");
                        
                        formData.Password = string.Empty;
                        isVisible = false;
                        StateHasChanged();
                    }
                }
            }
            else
            {
                // Parse the error response to get the actual message from API
                try
                {
                    var errorResult = System.Text.Json.JsonSerializer.Deserialize<LoginResponse>(result, 
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    
                    var errorMessage = errorResult?.Message ?? "Invalid email or password";
                    
                    // ✅ Show specific, clear error messages based on what went wrong
                    if (errorMessage.Contains("No account found") || errorMessage.Contains("Please register"))
                    {
                        // User is NOT registered at all
                        await ToastComponent!.ShowDangerToast("Account Not Found", 
                            "No account exists with this email. Please Sign Up first to create an account.");
                    }
                    else if (errorMessage.Contains("Incorrect password") || errorMessage.Contains("forgot"))
                    {
                        // Registered user but wrong password
                        await ToastComponent!.ShowDangerToast("Wrong Password", 
                            "The password you entered is incorrect. Click 'Reset Password' if you forgot it.");
                    }
                    else if (errorMessage.Contains("email is not verified") && errorMessage.Contains("new verification link"))
                    {
                        // Email not verified - new link was just sent
                        await ToastComponent!.ShowInfoToast("Verification Email Sent", 
                            "Your email is not verified. We just sent a new link to your inbox. Please verify and try again.");
                    }
                    else if (errorMessage.Contains("email is not verified"))
                    {
                        // Email not verified - link already pending
                        await ToastComponent!.ShowInfoToast("Email Not Verified", 
                            "Please check your inbox for the verification link we sent earlier.");
                    }
                    else if (errorMessage.Contains("profile not matched"))
                    {
                        await ToastComponent!.ShowDangerToast("Wrong Account Type", 
                            "This account is not registered as a doctor. Please use the patient mobile app.");
                    }
                    else if (errorMessage.Contains("banned"))
                    {
                        await ToastComponent!.ShowDangerToast("Account Banned", 
                            "Your account has been banned. Please contact support.");
                    }
                    else if (errorMessage.Contains("suspended"))
                    {
                        await ToastComponent!.ShowDangerToast("Account Suspended", 
                            "Your account is suspended. Please contact support.");
                    }
                    else
                    {
                        await ToastComponent!.ShowDangerToast("Login Failed", errorMessage);
                    }
                    
                    apiResponse = $"Error: {errorMessage}";
                }
                catch
                {
                    apiResponse = $"Error: {response.StatusCode}";
                    await ToastComponent!.ShowDangerToast("Login Failed", "Invalid email or password");
                }
                
                formData.Password = string.Empty;
                isVisible = false;
                StateHasChanged();
            }
        }
        catch (HttpRequestException)
        {
            formData.Password = string.Empty;
            apiResponse = "Unable to connect to server. Please check if the server is running.";
            await ToastComponent!.ShowDangerToast("Connection Error", "Unable to connect to server. Please try again later.");
        }
        catch (Exception ex)
        {
            formData.Password = string.Empty;
            Console.WriteLine("Exception: " + ex);
            apiResponse = $"Exception: {ex.Message}";
            await ToastComponent!.ShowDangerToast("Error", "An unexpected error occurred. Please try again.");
        }
        finally
        {
            isVisible = false;
            StateHasChanged();
        }
    }

    public class FormData
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email format")]
        [JsonPropertyName("email")]
        public string Email { get; set; } = string.Empty;

        
        [Required(ErrorMessage = "Password is required")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        [JsonPropertyName("password")]
        public string Password { get; set; } = string.Empty;

        [JsonPropertyName("profile_type")]
        public string ProfileType { get; set; } = string.Empty;
    }

    

    
}
