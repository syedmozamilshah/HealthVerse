    private string FormatPrescriptionField(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Equals("NIL", StringComparison.OrdinalIgnoreCase))
            return "- NIL";
        
        // Add dash before each line
        var lines = value.Split('\n', StringSplitOptions.RemoveEmptyEntries);
        return string.Join("\n", lines.Select(l => "- " + l.Trim()));
    }

