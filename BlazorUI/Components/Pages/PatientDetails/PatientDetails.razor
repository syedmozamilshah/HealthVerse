    // Centered modal helper (JS interop)
    private TaskCompletionSource<bool>? _modalTcs;
    private DotNetObjectReference<object>? _modalDotNetRef;

    [JSInvokable]
    public Task OnModalClosed()
    {
        _modalTcs?.TrySetResult(true);
        return Task.CompletedTask;
    }

    private async Task ShowCenteredModal(string message)
    {
        _modalTcs = new TaskCompletionSource<bool>();
        _modalDotNetRef = DotNetObjectReference.Create((object)this);

        // Define the JS function that will create a centered modal overlay
        var jsDef = @"(function(){
            window.showCenteredModal = function(dotnetRef, message){
                try{
                    var overlay = document.createElement('div');
                    overlay.id = 'blazor-centered-modal-overlay';
                    overlay.style.position = 'fixed';
                    overlay.style.left = '0';
                    overlay.style.top = '0';
                    overlay.style.width = '100%';
                    overlay.style.height = '100%';
                    overlay.style.background = 'rgba(0,0,0,0.45)';
                    overlay.style.display = 'flex';
                    overlay.style.alignItems = 'center';
                    overlay.style.justifyContent = 'center';
                    overlay.style.zIndex = '2147483647';

                    var modal = document.createElement('div');
                    modal.style.background = '#ffffff';
                    modal.style.padding = '24px';
                    modal.style.borderRadius = '10px';
                    modal.style.maxWidth = '640px';
                    modal.style.width = '80%';
                    modal.style.boxShadow = '0 12px 40px rgba(0,0,0,0.25)';
                    modal.style.textAlign = 'center';

                    var p = document.createElement('p');
                    p.style.margin = '0 0 18px';
                    p.style.fontSize = '16px';
                    p.style.lineHeight = '1.4';
                    p.style.color = '#222';
                    p.innerText = message;

                    var btn = document.createElement('button');
                    btn.innerText = 'OK';
                    btn.style.padding = '10px 18px';
                    btn.style.border = 'none';
                    btn.style.borderRadius = '6px';
                    btn.style.cursor = 'pointer';
                    btn.style.background = '#2e7d32';
                    btn.style.color = '#fff';
                    btn.style.fontSize = '14px';

                    btn.onclick = function(){
                        try{ document.body.removeChild(overlay); }catch(e){}
                        try{ dotnetRef.invokeMethodAsync('OnModalClosed'); }catch(e){}
                    };

                    modal.appendChild(p);
                    modal.appendChild(btn);
                    overlay.appendChild(modal);
                    document.body.appendChild(overlay);
                }catch(e){ console.error(e); }
            };
        })();";

        // Register the JS function
        await JSRuntime.InvokeVoidAsync("eval", jsDef);

        // Call it and wait for the user's click
        await JSRuntime.InvokeVoidAsync("showCenteredModal", _modalDotNetRef, message);
        await _modalTcs.Task;

        // Cleanup
        _modalDotNetRef?.Dispose();
        _modalDotNetRef = null;
        _modalTcs = null;
    }

