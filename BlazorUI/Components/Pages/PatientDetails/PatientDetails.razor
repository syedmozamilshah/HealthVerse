    // DR Grade mappings (0-4 for Diabetic Retinopathy severity)
    private static readonly Dictionary<string, string> DrGradeLabels = new()
    {
        { "0", "No Diabetic Retinopathy" },
        { "1", "Mild NPDR" },
        { "2", "Moderate NPDR" },
        { "3", "Severe NPDR" },
