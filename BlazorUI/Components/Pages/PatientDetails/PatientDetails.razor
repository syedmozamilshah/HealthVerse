    private async Task HandleDRImageUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            // Validate file type
            var allowedTypes = new[] { "image/png", "image/jpeg", "image/jpg" };
            if (!allowedTypes.Contains(file.ContentType.ToLower()))
            {
                ToastComponent?.ShowDangerToast("Invalid File", "Only PNG, JPG, and JPEG images are supported.");
                return;
            }

            isUploadingDR = true;
            StateHasChanged();

            // Read file content for preview and upload
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var fileBytes = memoryStream.ToArray();

            // Create preview image URL
            var base64 = Convert.ToBase64String(fileBytes);
            drPreviewImageUrl = $"data:{file.ContentType};base64,{base64}";
            StateHasChanged();

            // Create multipart form data
            // Step 1: Validate image via n8n webhook (field name: "data") for DR images
            try
            {
                using var validationClient = HttpClientFactory.CreateClient();
                validationClient.Timeout = TimeSpan.FromSeconds(30);

                using var validationContent = new MultipartFormDataContent();
                var dataContent = new ByteArrayContent(fileBytes);
                dataContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
                validationContent.Add(dataContent, "data", file.Name);

                var validationUrl = "https://n8n-14pv.onrender.com/webhook/86d84c0e-a39d-459d-9d16-6d87a2e25b0a";
                var validationResponse = await validationClient.PostAsync(validationUrl, validationContent);

                if (!validationResponse.IsSuccessStatusCode)
                {
                    var err = await validationResponse.Content.ReadAsStringAsync();
                    Console.Error.WriteLine($"n8n DR validation error: {err}");
                    ToastComponent?.ShowDangerToast("Validation Error", $"Image validation failed: {validationResponse.StatusCode}");
                    return;
                }

                var validationText = (await validationResponse.Content.ReadAsStringAsync()).Trim();
                Console.WriteLine($"n8n DR validation response: {validationText}");

                // If not plain-text "Retina", show centered modal and abort
                if (!string.Equals(validationText, "Retina", StringComparison.OrdinalIgnoreCase))
                {
                    await ShowCenteredModal("It looks like the image of a geometric diagram. Please upload a retinal fundus image.");
                    return;
                }
            }
            catch (TaskCanceledException tce)
            {
                ToastComponent?.ShowDangerToast("Validation Timeout", "Image validation timed out. Please try again later.");
                Console.Error.WriteLine($"n8n DR validation timeout: {tce.Message}");
                return;
            }

            // Step 2: Validation passed - send to DR API (existing behavior)
            using var httpClient = HttpClientFactory.CreateClient();
            httpClient.Timeout = TimeSpan.FromSeconds(120);
            
            using var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(fileBytes);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            // Send to DR API
            var response = await httpClient.PostAsync(
                "https://zamliskill--dr-efficientnetb7-api-fastapi-app.modal.run/predict", 
                content);

            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"DR API Raw Response: {responseContent}");
                
                // Parse the detailed response
                ParseDRDetailedResult(responseContent);
                
                ToastComponent?.ShowSuccessToast("Success", "Image analyzed successfully!");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                ToastComponent?.ShowDangerToast("Error", $"Failed to analyze image: {response.StatusCode}");
                Console.Error.WriteLine($"DR API Error: {errorContent}");
            }
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Error", $"Error uploading image: {ex.Message}");
            Console.Error.WriteLine($"DR Upload Exception: {ex}");
        }
        finally
        {
            isUploadingDR = false;
            StateHasChanged();
        }
    }

