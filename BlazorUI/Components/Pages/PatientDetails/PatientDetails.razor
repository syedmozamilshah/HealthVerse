    private string GetFormattedMedicinesFromEntries()
    {
        if (medicineEntries.Count == 0)
            return prescriptionData.Medicines ?? "NIL";
        
        var formattedMedicines = medicineEntries
            .Where(m => !string.IsNullOrWhiteSpace(m.Name))
            .Select(m => m.ToFormattedString());
        
        return string.Join("\n", formattedMedicines);
    }

    private void ParseMedicinesToEntries(string? medicinesText)
    {
        medicineEntries.Clear();
        
        if (string.IsNullOrWhiteSpace(medicinesText) || medicinesText == "NIL")
            return;
        
        var lines = medicinesText.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var line in lines)
        {
            var entry = new MedicineEntry();
            
            // Try to parse structured format: "Name - X tablet(s) - Timing | Instructions"
            var parts = line.Split(new[] { " - " }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 1)
            {
                entry.Name = parts[0].Trim();
                
                if (parts.Length >= 2)
                {
                    // Try to extract quantity
                    var qtyMatch = System.Text.RegularExpressions.Regex.Match(parts[1], @"(\d+)");
                    if (qtyMatch.Success)
                    {
                        entry.Quantity = int.Parse(qtyMatch.Groups[1].Value);
                    }
                }
                
                if (parts.Length >= 3)
                {
                    var timingPart = parts[2].ToLower();
                    entry.Morning = timingPart.Contains("morning");
                    entry.Afternoon = timingPart.Contains("afternoon");
                    entry.Evening = timingPart.Contains("evening");
                    entry.Night = timingPart.Contains("night");
                    
                    // Extract instructions if present (after |)
                    var instructionIndex = parts[2].IndexOf("|");
                    if (instructionIndex >= 0 && instructionIndex < parts[2].Length - 1)
                    {
                        entry.Instructions = parts[2].Substring(instructionIndex + 1).Trim();
                    }
                }
            }
            
            medicineEntries.Add(entry);
        }
    }

