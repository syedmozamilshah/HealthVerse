    private async Task SendPrescription()
    {
        try
        {
            isSendingPrescription = true;
            StateHasChanged();

            string? base64Data = null;

            // Try to capture as image first
            try
            {
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
                base64Data = await JSRuntime.InvokeAsync<string>("captureElementAsBase64", cts.Token, "prescriptionContent");
                if (!string.IsNullOrEmpty(base64Data))
                {
                    Console.WriteLine($"Image capture successful, length: {base64Data.Length}");
                }
            }
            catch (Exception imgEx)
            {
                Console.Error.WriteLine($"Image capture failed: {imgEx.Message}");
            }

            // If image failed, try PDF
            if (string.IsNullOrEmpty(base64Data))
            {
                Console.WriteLine("Trying PDF generation...");
                try
                {
                    using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
                    base64Data = await JSRuntime.InvokeAsync<string>("generatePrescriptionPdf", cts.Token, "prescriptionContent");
                    if (!string.IsNullOrEmpty(base64Data))
                    {
                        Console.WriteLine($"PDF generation successful, length: {base64Data.Length}");
                    }
                }
                catch (Exception pdfEx)
                {
                    Console.Error.WriteLine($"PDF generation failed: {pdfEx.Message}");
                }
            }

            // If both failed, show error
            if (string.IsNullOrEmpty(base64Data))
            {
                ToastComponent?.ShowDangerToast("Error", "Could not generate prescription file. Please try again.");
                return;
            }

            // Send to save-prescription-image endpoint
            var client = await ApiClient.SetAuthorizedHeader();
            var patientFullName = ((patientDtoResponse?.Data?.FirstName ?? "") + " " + (patientDtoResponse?.Data?.LastName ?? "")).Trim();
            
            // Convert medicine entries to DTOs
            var medicineItemDtos = medicineEntries
                .Where(m => !string.IsNullOrWhiteSpace(m.Name))
                .Select(m => new MedicineItemDto
                {
                    Name = m.Name,
                    Dosage = $"{m.Quantity} tablet(s)",
                    DurationDays = m.DurationDays,
                    Morning = m.Morning,
                    Afternoon = m.Afternoon,
                    Evening = m.Evening,
                    Night = m.Night,
                    Instructions = m.Instructions ?? ""
                })
                .ToList();

            var request = new SavePrescriptionImageRequest
            {
                PatientId = patientId,
                DoctorId = doctorId ?? "",
                DoctorName = doctorName ?? "Doctor",
                DoctorSpecialty = doctorSpecialty ?? "",
                PatientName = patientFullName,
                ImageBase64 = base64Data,
                Diagnosis = prescriptionData.Diagnosis ?? "",
                Medicines = prescriptionData.Medicines ?? "",
                Advice = prescriptionData.Advice ?? "",
                FollowUp = prescriptionData.FollowUp ?? "",
                MedicineItems = medicineItemDtos.Count > 0 ? medicineItemDtos : null
            };

            var response = await client.PostAsJsonAsync("api/Prescription/save-prescription-image", request);
            
            if (response.IsSuccessStatusCode)
            {
                var options = new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                };
                var responseContent = await response.Content.ReadAsStringAsync();
                var result = System.Text.Json.JsonSerializer.Deserialize<SavePrescriptionImageResponse>(responseContent, options);
                
                if (result?.Success == true && result.Data != null)
                {
                    // Add the new prescription to the local list immediately
                    var newPrescription = new SavedPrescription
                    {
                        Id = result.Data.PrescriptionId ?? "",
                        PrescriptionUrl = result.Data.PrescriptionUrl ?? "",
                        PrescriptionDate = result.Data.PrescriptionDate ?? DateTime.Now.ToString("dd-MM-yyyy"),
                        DoctorName = doctorName ?? "Doctor",
                        DoctorSpecialty = doctorSpecialty ?? "",
                        Diagnosis = prescriptionData.Diagnosis ?? "",
                        Medicines = prescriptionData.Medicines ?? "",
                        Advice = prescriptionData.Advice ?? "",
                        CreatedAt = DateTime.Now
                    };
                    patientReports.Insert(0, newPrescription);
                    
                    // Mark appointment as completed
                    try
                    {
                        var completeResponse = await client.PostAsync($"api/Appointment/complete/{patientId}", null);
                        if (completeResponse.IsSuccessStatusCode)
                        {
                            Console.WriteLine("Appointment marked as completed");
                        }
                        else
                        {
                            Console.WriteLine($"Could not mark appointment as completed: {completeResponse.StatusCode}");
                        }
                    }
                    catch (Exception completeEx)
                    {
                        Console.Error.WriteLine($"Error marking appointment complete: {completeEx.Message}");
                    }
                }
                
                ToastComponent?.ShowSuccessToast("Success", "Prescription saved successfully!");
                ClosePrescriptionPreview();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastComponent?.ShowDangerToast("Error", $"Failed: {response.StatusCode}");
                Console.Error.WriteLine($"API Error: {error}");
            }
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Error", $"Error: {ex.Message}");
            Console.Error.WriteLine($"Send Prescription Error: {ex.Message}");
            Console.Error.WriteLine($"Stack Trace: {ex.StackTrace}");
        }
        finally
        {
            isSendingPrescription = false;
            StateHasChanged();
        }
    }

