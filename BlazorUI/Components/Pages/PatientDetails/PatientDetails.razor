@rendermode InteractiveServer
@page "/patient-details/{patientId}"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using BlazorUI.Authentication
@using BlazorUI.Models
@using BlazorUI.Models.AppointmentModel
@using BlazorUI.Models.PatientDto
@using BlazorUI.Models.ChatModel
@using BlazorUI.Models.DoctorModel
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using NetcodeHub.Packages.Components.Toast
@using Microsoft.AspNetCore.Components
@using BlazorUI.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory
@inject ProtectedSessionStorage SessionStorage
@inject ProtectedLocalStorage LocalStorage
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ApiClient ApiClient

<div class="container-fluid" style="background: linear-gradient(180deg, #ffffff 16%, #94c979 100%); min-height: 100vh; padding: 20px;">

    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between p-3 shadow rounded"
                style="background: linear-gradient(90deg, #2e7d32, #66bb6a); color: white;">
                
                <h3 class="mb-0">
                    Patient: <span class="fw-bold"> <i class="bi bi-person-circle me-1"></i> @(patientDtoResponse?.Data?.FirstName)</span>
                </h3>

                <div class="d-flex align-items-center gap-3">
                    @if (agentInfo != null && agentInfo.IsAgentAvailable)
                    {
                        <span class="badge bg-light text-success">
                            <i class="bi bi-robot me-1"></i> @agentInfo.Specialty Agent Active
                        </span>
                    }
                    else if (agentInfo != null && !agentInfo.IsAgentAvailable)
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-exclamation-triangle me-1"></i> No Agent for @agentInfo.Specialty
                        </span>
                    }
                    
                    @* Doctor quick actions: Start / Complete session for this patient *@
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-light text-success"
                                disabled="@(!CanStartPatientAppointment())"
                                title="@(!CanStartPatientAppointment() ? "Appointment time not reached yet" : "Start Session")"
                                @onclick:stopPropagation="true"
                                @onclick="StartSessionByPatient">
                            <i class="bi bi-play-circle"></i>
                        </button>
                        <button class="btn btn-sm btn-light text-primary"
                                disabled="@(!CanCompletePatientAppointment())"
                                title="@(!CanCompletePatientAppointment() ? "Start session first" : "Complete Appointment")"
                                @onclick:stopPropagation="true"
                                @onclick="CompleteByPatient">
                            <i class="bi bi-check-circle"></i>
                        </button>
                    </div>
                    <button class="btn"
                        @onclick='() => Navigation.NavigateTo("/dashboard", replace: true)'>
                        <i class="bi bi-x fs-4" style="color: white;"></i>
                    </button>
                </div>
                
            </div>
        </div>
    </div>


    <div class="row">

        <!-- Chat History Sidebar -->
        <div class="col-12 col-md-3 mb-3" id="chatSidebar">
            <div class="border rounded bg-white shadow-sm p-3 d-flex flex-column"
                style="height: 80vh; overflow-y: auto;">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-success mb-0">Chats</h6>
                    <button class="btn btn-success btn-sm rounded-pill px-2 py-1 d-inline-flex align-items-center"
                            title="New Chat"
                            @onclick="CreateNewChat"
                            disabled="@isCreatingChat">
                        @if (isCreatingChat)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="bi bi-plus-circle me-1"></i>
                        }
                        <span class="d-none d-sm-inline">New Chat</span>
                    </button>
                </div>

                @if (isLoadingChats)
                {
                    <div class="d-flex justify-content-center py-4">
                        <div class="spinner-border text-success" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (chatList != null && chatList.Count > 0)
                {
                    <ul class="list-group list-group-flush" style="flex-grow: 1;">
                        @foreach (var chat in chatList)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center @(currentChatId == chat.Id ? "bg-success text-white" : "")"
                                style="cursor: pointer; border-radius: 8px; margin-bottom: 4px;"
                                @onclick="() => LoadChat(chat.Id)">
                                
                                <span class="text-truncate" style="max-width: 180px;">
                                    <i class="bi bi-chat-dots me-2 @(currentChatId == chat.Id ? "text-white" : "text-success")"></i> 
                                    @chat.Title
                                </span>

                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge @(currentChatId == chat.Id ? "bg-light text-success" : "bg-success")">@chat.MessageCount</span>
                                    <button class="btn btn-sm p-0" @onclick:stopPropagation="true" @onclick="() => DeleteChat(chat.Id)">
                                        <i class="bi bi-trash @(currentChatId == chat.Id ? "text-white" : "text-danger")"></i>
                                    </button>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-chat-square-text fs-1"></i>
                        <p class="mt-2">No chats yet</p>
                        <small>Click "New Chat" to start a consultation</small>
                    </div>
                }
            </div>
        </div>


        <!-- Main Chat Area -->
        <div class="col-12 col-md-6 mb-3">
            <div class="border rounded shadow-sm d-flex flex-column"
                style="height: 80vh; background: #f8f9fa;">

                @* Tabs for Ophthalmologist *@
                @if (IsOphthalmologist())
                {
                    <ul class="nav nav-tabs" style="background: #f0f0f0; border-top-left-radius: .3rem; border-top-right-radius: .3rem;">
                        <li class="nav-item">
                            <a class="nav-link @(activeTab == "agent" ? "active text-success fw-bold" : "text-secondary")" 
                               style="cursor: pointer; border-bottom: @(activeTab == "agent" ? "3px solid #2e7d32" : "none");"
                               @onclick='() => SetActiveTab("agent")'>
                                <i class="bi bi-robot me-1"></i> Agent
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(activeTab == "dr" ? "active text-success fw-bold" : "text-secondary")" 
                               style="cursor: pointer; border-bottom: @(activeTab == "dr" ? "3px solid #2e7d32" : "none");"
                               @onclick='() => SetActiveTab("dr")'>
                                <i class="bi bi-eye me-1"></i> DR
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(activeTab == "classifier" ? "active text-success fw-bold" : "text-secondary")" 
                               style="cursor: pointer; border-bottom: @(activeTab == "classifier" ? "3px solid #2e7d32" : "none");"
                               @onclick='() => SetActiveTab("classifier")'>
                                <i class="bi bi-search me-1"></i> Classifier
                            </a>
                        </li>
                    </ul>
                }

                @if (activeTab == "agent" || !IsOphthalmologist())
                {
                <div class="p-3 d-flex align-items-center justify-content-between"
                    style="background: linear-gradient(90deg, #2e7d32, #66bb6a); color: white; @(IsOphthalmologist() ? "" : "border-top-left-radius: .3rem; border-top-right-radius: .3rem;")">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-robot me-2"></i>AI Consultation Chat
                        @if (!string.IsNullOrEmpty(agentInfo?.Specialty))
                        {
                            <small class="fw-normal">(@agentInfo.Specialty)</small>
                        }
                    </h6>
                    <div class="d-flex align-items-center gap-2">
                        <!-- M-5 GENERATE PRESCRIPTION -->
                        <button class="btn btn-light btn-sm rounded-pill px-3"
        @onclick="GeneratePrescription"
        disabled="@(!IsSessionActiveOrReadyToStart() || isGeneratingPrescription)"
        title="@(!IsSessionActiveOrReadyToStart() ? "Appointment not active or ready" : "Generate Prescription")">

    @if (isGeneratingPrescription)
    {
        <span class="spinner-border spinner-border-sm me-1"></span>
        <span>Generating...</span>
    }
    else
    {
        <i class="bi bi-file-earmark-medical me-1"></i>
        <span>Generate Prescription</span>
    }
</button>
                        
                        <!-- NEW REFERRAL UI -->
                        <div class="d-flex align-items-center gap-2 border-start ps-2 border-light">
                            <select class="form-select form-select-sm w-auto" 
                                    style="border-radius: 20px; font-size: 0.85rem;" 
                                    @bind="selectedReferralSpecialty"
                                    disabled="@(!hasPrescriptionGenerated)">
                                <option value="">Refer to...</option>
                                @if (doctorSpecialty != "Optometrist")
                                {
                                    <option value="Optometrist">Optometrist</option>
                                }
                                @if (doctorSpecialty != "Ophthalmologist")
                                {
                                    <option value="Ophthalmologist">Ophthalmologist</option>
                                }
                                @if (doctorSpecialty != "Ocularist")
                                {
                                    <option value="Ocularist">Ocularist</option>
                                }
                                @if (doctorSpecialty != "Optician")
                                {
                                    <option value="Optician">Optician</option>
                                }
                            </select>
                            <button class="btn btn-warning btn-sm rounded-pill px-3 fw-bold"
                                    @onclick="ReferPatient"
                                    title="@(!hasPrescriptionGenerated ? "Please generate a prescription first" : "Refer Patient")"
                                    disabled="@(isReferring || string.IsNullOrEmpty(selectedReferralSpecialty) || !hasPrescriptionGenerated)">
                                @if (isReferring)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                else
                                {
                                    <i class="bi bi-box-arrow-up-right me-1"></i>
                                }
                                <span class="text-dark">Refer</span>
                            </button>
                        </div>

                        <span class="badge @(agentInfo?.IsAgentAvailable == true ? "bg-light text-success" : "bg-warning text-dark")">
                            @(agentInfo?.IsAgentAvailable == true ? "Active" : "Unavailable")
                        </span>
                    </div>
                </div>

                <!-- Messages Container -->
                <div class="flex-grow-1 overflow-auto p-3" id="chatMessages"
                    style="background-color: #ffffff; border-left: 4px solid #94c979; border-right: 4px solid #94c979;">
                    
                    @if (currentChat != null && currentChat.Chats.Count > 0)
                    {
                        foreach (var message in currentChat.Chats)
                        {
                            <!-- User Message -->
                            <div class="d-flex justify-content-end mb-3">
                                <div class="p-2 px-3 rounded shadow-sm"
                                    style="background-color: #e9ecef; max-width: 70%;">
                                    <strong class="d-block text-muted small">You</strong>
                                    <div style="white-space: pre-wrap;">@message.Query</div>
                                    <div class="text-end text-muted small">@message.Timestamp.ToDisplayString("hh:mm tt")</div>
                                </div>
                            </div>

                            <!-- AI Response - Show thinking if empty -->
                            @if (string.IsNullOrEmpty(message.Response))
                            {
                                <div class="d-flex justify-content-start mb-3">
                                    <div class="p-2 px-3 rounded shadow-sm text-white"
                                        style="background-color: #28a745; max-width: 70%;">
                                        <strong class="d-block small">
                                            <i class="bi bi-robot me-1"></i>AI Agent
                                        </strong>
                                        <div class="d-flex align-items-center">
                                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                                            <span>Thinking...</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-start mb-3">
                                    <div class="p-2 px-3 rounded shadow-sm text-white"
                                        style="background-color: #28a745; max-width: 70%;">
                                        <strong class="d-block small">
                                            <i class="bi bi-robot me-1"></i>AI Agent
                                        </strong>
                                        <div style="white-space: pre-wrap;">@message.Response</div>
                                        <div class="text-start text-light small">@message.Timestamp.ToDisplayString("hh:mm tt")</div>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else if (string.IsNullOrEmpty(currentChatId))
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-chat-square-text fs-1"></i>
                            <h5 class="mt-3">Start a New Consultation</h5>
                            <p>Click "New Chat" or select an existing chat to begin</p>
                            @if (agentInfo?.IsAgentAvailable == true)
                            {
                                <p class="text-success">
                                    <i class="bi bi-check-circle me-1"></i>
                                    @agentInfo.Specialty AI Agent is ready to assist
                                </p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-chat-dots fs-1"></i>
                            <p class="mt-3">No messages yet. Start the conversation!</p>
                        </div>
                    }

                    @* Only show this thinking indicator if there's no message with empty response already showing one *@
                    @if (isSendingMessage && (currentChat == null || !currentChat.Chats.Any(m => string.IsNullOrEmpty(m.Response))))
                    {
                        <div class="d-flex justify-content-start mb-3">
                            <div class="p-2 px-3 rounded shadow-sm text-white"
                                style="background-color: #28a745; max-width: 70%;">
                                <strong class="d-block small">
                                    <i class="bi bi-robot me-1"></i>AI Agent
                                </strong>
                                <div class="d-flex align-items-center">
                                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                                    <span>Thinking...</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Message Input -->
                <div class="p-2 d-flex align-items-center border-top bg-white">
                    <input type="text" 
                           class="form-control rounded-pill me-2" 
                           placeholder="@(agentInfo?.IsAgentAvailable == true ? "Type your message..." : "AI Agent not available for your specialty")"
                           @bind="messageInput"
                           @bind:event="oninput"
                           @onkeypress="HandleKeyPress"
                           disabled="@(isSendingMessage || agentInfo?.IsAgentAvailable != true)" />
                    <button class="btn btn-success rounded-circle d-flex align-items-center justify-content-center" 
                            style="width: 40px; height: 40px;"
                            @onclick="SendMessage"
                            disabled="@(!IsSessionActiveOrReadyToStart() || isSendingMessage || string.IsNullOrWhiteSpace(messageInput) || agentInfo?.IsAgentAvailable != true)">
                        @if (isSendingMessage)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-send"></i>
                        }
                    </button>
                </div>
                }

                @* DR Tab Content - Diabetic Retinopathy *@
                @if (activeTab == "dr" && IsOphthalmologist())
                {
                    <div class="p-3 d-flex align-items-center justify-content-between"
                        style="background: linear-gradient(90deg, #2e7d32, #66bb6a); color: white;">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-eye me-2"></i>Diabetic Retinopathy Detection
                        </h6>
                        <small class="opacity-75">AI-Powered Grading</small>
                    </div>
                    <div class="flex-grow-1 overflow-auto p-4"
                         style="background-color: #f8fff4;">
                        
                        @if (string.IsNullOrEmpty(drResult))
                        {
                            @* Important Notice *@
                            <div class="alert alert-warning d-flex align-items-start mb-4" role="alert" style="border-radius: 12px; border-left: 4px solid #ffc107;">
                                <i class="bi bi-exclamation-triangle-fill me-3 fs-4 text-warning"></i>
                                <div>
                                    <strong>Important:</strong> Please upload only <strong>fundus/retinal eye images</strong> for accurate Diabetic Retinopathy detection. 
                                </div>
                            </div>

                            @* Upload Area *@
                            <label for="drFileInputReal" class="dr-upload-area text-center p-5 mb-4 d-block" 
                                 style="border: 3px dashed #2e7d32; border-radius: 16px; background: #ffffff; cursor: pointer; transition: all 0.3s ease;">
                                <div style="font-size: 4rem;">👁️</div>
                                <h5 class="text-dark mb-2 fw-semibold">Upload Fundus Image</h5>
                                <p class="text-muted mb-1">Click to browse or drag & drop</p>
                                <small class="text-muted d-block">Supports: JPG, PNG, JPEG</small>
                                <small class="text-success d-block mt-2"><i class="bi bi-info-circle me-1"></i>Only fundus/retina images for accurate results</small>
                            </label>
                            <InputFile OnChange="HandleDRImageUpload" accept="image/*" class="d-none" id="drFileInputReal" disabled="@isUploadingDR" />

                            @* Preview Image *@
                            @if (!string.IsNullOrEmpty(drPreviewImageUrl))
                            {
                                <div class="text-center mb-4 position-relative" style="max-width: 400px; margin: 0 auto;">
                                    <img src="@drPreviewImageUrl" alt="Preview" class="img-fluid rounded shadow" style="max-height: 300px; border-radius: 16px !important;" />
                                    <button class="btn btn-danger btn-sm position-absolute rounded-circle" 
                                            style="top: 10px; right: 10px; width: 36px; height: 36px;"
                                            @onclick="ClearDRPreview">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            }
                                
                            @if (isUploadingDR)
                            {
                                <div class="text-center mt-4">
                                    <div class="spinner-border text-success" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p class="mt-3 fw-semibold text-success">Analyzing Image...</p>
                                </div>
                            }

                            @* DR Severity Cards *@
                            <div class="mb-3 mt-4">
                                <p class="text-muted small text-center mb-2"><i class="bi bi-bullseye me-1"></i>DR Severity Grades:</p>
                            </div>
                            <div class="row g-2">
                                <div class="col-6 col-md-4">
                                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px;">
                                        <div class="card-body text-center py-2">
                                            <small class="text-muted">Grade 0</small>
                                            <p class="small mb-0 mt-1">No DR</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px;">
                                        <div class="card-body text-center py-2">
                                            <small class="text-muted">Grade 1</small>
                                            <p class="small mb-0 mt-1">Mild NPDR</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px;">
                                        <div class="card-body text-center py-2">
                                            <small class="text-muted">Grade 2</small>
                                            <p class="small mb-0 mt-1">Moderate NPDR</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px;">
                                        <div class="card-body text-center py-2">
                                            <small class="text-muted">Grade 3</small>
                                            <p class="small mb-0 mt-1">Severe NPDR</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px;">
                                        <div class="card-body text-center py-2">
                                            <small class="text-muted">Grade 4</small>
                                            <p class="small mb-0 mt-1">Proliferative DR</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* Sample Image Guidance *@
                            <div class="alert alert-info mt-4" role="alert" style="border-radius: 12px;">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-lightbulb me-2 fs-5"></i>
                                    <div>
                                        <strong>Tip:</strong> Upload a <strong>fundus photograph</strong> or <strong>retinal scan</strong> image from an eye examination for accurate DR grading.
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @* Results Display *@
                            <div class="p-4 mb-4" style="background: linear-gradient(135deg, #f8fff4 0%, #d7f2c2 100%); border-radius: 16px;">
                                <h5 class="text-center mb-4 fw-bold text-dark">Analysis Results</h5>
                                
                                @* Prediction Card *@
                                <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
                                    <div class="card-body text-center py-4">
                                        <p class="text-muted small mb-2">Diabetic Retinopathy Grade</p>
                                        <h3 class="fw-bold mb-1 text-success" style="text-transform: capitalize;">@drResult</h3>
                                        <span class="badge px-4 py-2 fs-6" style="background: linear-gradient(135deg, #2e7d32 0%, #66bb6a 100%);">
                                            @((drConfidence * 100).ToString("F1"))% Confidence
                                        </span>
                                    </div>
                                </div>

                                @* Probabilities *@
                                @if (drProbabilities.Count > 0)
                                {
                                    <div class="mb-4">
                                        @foreach (var prob in drProbabilities.OrderByDescending(x => x.Value))
                                        {
                                            var percentage = (prob.Value * 100);
                                            <div class="card border-0 shadow-sm mb-2" style="border-radius: 10px;">
                                                <div class="card-body py-3 px-4">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span class="fw-medium text-dark text-capitalize">@GetDRGradeLabel(prob.Key)</span>
                                                        <span class="fw-bold text-success">@percentage.ToString("F1")%</span>
                                                    </div>
                                                    <div class="progress" style="height: 8px; border-radius: 4px; background: #e9ecef;">
                                                        <div class="progress-bar" role="progressbar" 
                                                             style="width: @percentage.ToString("F1")%; background: linear-gradient(90deg, #2e7d32, #66bb6a); border-radius: 4px; transition: width 0.8s ease;"
                                                             aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @* DR Info *@
                                <div class="card border-0 shadow-sm" style="border-radius: 12px; border-left: 4px solid #2e7d32 !important;">
                                    <div class="card-body">
                                        <h6 class="fw-bold text-dark mb-2">
                                            <i class="bi bi-info-circle me-2 text-success"></i>About DR Grades
                                        </h6>
                                        <p class="text-muted small mb-0" style="line-height: 1.6;">
                                            @GetDRDescription(drResult)
                                        </p>
                                    </div>
                                </div>

                                @* Validation Warning *@
                                <div class="alert alert-warning mt-3 mb-0" role="alert" style="border-radius: 10px;">
                                    <div class="d-flex align-items-start">
                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                        <small>
                                            <strong>Note:</strong> These results are only accurate for <strong>fundus/retinal eye images</strong>. 
                                            If you uploaded a non-eye image, please discard this result and upload a proper retinal scan.
                                        </small>
                                    </div>
                                </div>
                            </div>

                            @* Action Buttons *@
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-success flex-grow-1" @onclick="ClearDRResult">
                                    <i class="bi bi-arrow-repeat me-2"></i>Analyze Another Image
                                </button>
                            </div>
                            
                            @* Footer Notice *@
                            <div class="text-center mt-4">
                                <small class="text-muted">
                                    This is for educational purposes only. Consult a medical professional for diagnosis.
                                </small>
                            </div>
                        }
                    </div>
                }

                @* Classifier Tab Content - Eye Disease Classification *@
                @if (activeTab == "classifier" && IsOphthalmologist())
                {
                    <div class="p-3 d-flex align-items-center justify-content-between"
                        style="background: linear-gradient(90deg, #2e7d32, #66bb6a); color: white;">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-eye me-2"></i>Eye Disease Classifier
                        </h6>
                        <small class="opacity-75">AI-Powered Detection</small>
                    </div>
                    <div class="flex-grow-1 overflow-auto p-4"
                         style="background-color: #f8fff4;">
                        
                        @if (string.IsNullOrEmpty(classifierResult))
                        {
                            @* Important Notice *@
                            <div class="alert alert-warning d-flex align-items-start mb-4" role="alert" style="border-radius: 12px; border-left: 4px solid #ffc107;">
                                <i class="bi bi-exclamation-triangle-fill me-3 fs-4 text-warning"></i>
                                <div>
                                    <strong>Important:</strong> Please upload only <strong>fundus/retinal eye images</strong>. 
                                    The classifier is trained specifically for eye disease detection and may produce inaccurate results for non-eye images.
                                </div>
                            </div>

                            @* Upload Area *@
                            <label for="classifierFileInputReal" class="classifier-upload-area text-center p-5 mb-4 d-block" 
                                 style="border: 3px dashed #2e7d32; border-radius: 16px; background: #ffffff; cursor: pointer; transition: all 0.3s ease;">
                                <div style="font-size: 4rem;">👁️</div>
                                <h5 class="text-dark mb-2 fw-semibold">Upload Retinal Eye Image</h5>
                                <p class="text-muted mb-1">Click to browse or drag & drop</p>
                                <small class="text-muted d-block">Supports: JPG, PNG, JPEG</small>
                                <small class="text-success d-block mt-2"><i class="bi bi-info-circle me-1"></i>Only fundus/retina images for accurate results</small>
                            </label>
                            <InputFile OnChange="HandleClassifierImageUpload" accept="image/*" class="d-none" id="classifierFileInputReal" disabled="@isUploadingClassifier" />

                            @* Preview Image *@
                            @if (!string.IsNullOrEmpty(classifierPreviewImageUrl))
                            {
                                <div class="text-center mb-4 position-relative" style="max-width: 400px; margin: 0 auto;">
                                    <img src="@classifierPreviewImageUrl" alt="Preview" class="img-fluid rounded shadow" style="max-height: 300px; border-radius: 16px !important;" />
                                    <button class="btn btn-danger btn-sm position-absolute rounded-circle" 
                                            style="top: 10px; right: 10px; width: 36px; height: 36px;"
                                            @onclick="ClearClassifierPreview">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            }
                                
                            @if (isUploadingClassifier)
                            {
                                <div class="text-center mt-4">
                                    <div class="spinner-border text-success" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p class="mt-3 fw-semibold text-success">Analyzing Image...</p>
                                </div>
                            }

                            @* Disease Info Cards - What we detect *@
                            <div class="mb-3">
                                <p class="text-muted small text-center mb-2"><i class="bi bi-bullseye me-1"></i>Conditions we can detect:</p>
                            </div>
                            <div class="row g-3">
                                <div class="col-6">
                                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px;">
                                        <div class="card-body text-center py-3">
                                            <i class="bi bi-eye-slash text-primary fs-4"></i>
                                            <p class="small mb-0 mt-2">Cataract</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px;">
                                        <div class="card-body text-center py-3">
                                            <i class="bi bi-droplet text-danger fs-4"></i>
                                            <p class="small mb-0 mt-2">Diabetic Retinopathy</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px;">
                                        <div class="card-body text-center py-3">
                                            <i class="bi bi-circle text-warning fs-4"></i>
                                            <p class="small mb-0 mt-2">Glaucoma</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px;">
                                        <div class="card-body text-center py-3">
                                            <i class="bi bi-check-circle text-success fs-4"></i>
                                            <p class="small mb-0 mt-2">Normal</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* Sample Image Guidance *@
                            <div class="alert alert-info mt-4" role="alert" style="border-radius: 12px;">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-lightbulb me-2 fs-5"></i>
                                    <div>
                                        <strong>Tip:</strong> For best results, upload a clear <strong>fundus photograph</strong> or <strong>retinal scan</strong> image taken during an eye examination.
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @* Results Display *@
                            <div class="p-4 mb-4" style="background: linear-gradient(135deg, #f8fff4 0%, #d7f2c2 100%); border-radius: 16px;">
                                <h5 class="text-center mb-4 fw-bold text-dark">Analysis Results</h5>
                                
                                @* Prediction Card *@
                                <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
                                    <div class="card-body text-center py-4">
                                        <p class="text-muted small mb-2">Predicted Condition</p>
                                        <h3 class="fw-bold mb-3 text-success" style="text-transform: capitalize;">@classifierResult.Replace("_", " ")</h3>
                                        <span class="badge px-4 py-2 fs-6" style="background: linear-gradient(135deg, #2e7d32 0%, #66bb6a 100%);">
                                            @((classifierConfidence * 100).ToString("F1"))% Confidence
                                        </span>
                                    </div>
                                </div>

                                @* Probabilities *@
                                @if (classifierProbabilities.Count > 0)
                                {
                                    <div class="mb-4">
                                        @foreach (var prob in classifierProbabilities.OrderByDescending(x => x.Value))
                                        {
                                            var percentage = (prob.Value * 100);
                                            <div class="card border-0 shadow-sm mb-2" style="border-radius: 10px;">
                                                <div class="card-body py-3 px-4">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span class="fw-medium text-dark text-capitalize">@prob.Key.Replace("_", " ")</span>
                                                        <span class="fw-bold text-success">@percentage.ToString("F1")%</span>
                                                    </div>
                                                    <div class="progress" style="height: 8px; border-radius: 4px; background: #e9ecef;">
                                                        <div class="progress-bar" role="progressbar" 
                                                             style="width: @percentage.ToString("F1")%; background: linear-gradient(90deg, #2e7d32, #66bb6a); border-radius: 4px; transition: width 0.8s ease;"
                                                             aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @* Disease Info *@
                                <div class="card border-0 shadow-sm" style="border-radius: 12px; border-left: 4px solid #2e7d32 !important;">
                                    <div class="card-body">
                                        <h6 class="fw-bold text-dark mb-2">
                                            <i class="bi bi-info-circle me-2 text-success"></i>About this Condition
                                        </h6>
                                        <p class="text-muted small mb-0" style="line-height: 1.6;">
                                            @GetDiseaseDescription(classifierResult)
                                        </p>
                                    </div>
                                </div>

                                @* Validation Warning *@
                                <div class="alert alert-warning mt-3 mb-0" role="alert" style="border-radius: 10px;">
                                    <div class="d-flex align-items-start">
                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                        <small>
                                            <strong>Note:</strong> These results are only accurate for <strong>fundus/retinal eye images</strong>. 
                                            If you uploaded a non-eye image, please discard this result and upload a proper retinal scan.
                                        </small>
                                    </div>
                                </div>
                            </div>

                            @* Action Buttons *@
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-success flex-grow-1" @onclick="ClearClassifierResult">
                                    <i class="bi bi-arrow-repeat me-2"></i>Analyze Another Image
                                </button>
                            </div>
                            
                            @* Footer Notice *@
                            <div class="text-center mt-4">
                                <small class="text-muted">
                                    This is for educational purposes only. Consult a medical professional for diagnosis.
                                </small>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>


        <!-- Patient Info Sidebar -->
        <div class="col-12 col-md-3 mb-3" id="patientInfoSidebar">
            <div class="border rounded shadow-sm p-3" 
                style="height: 80vh; overflow-y: auto; background: linear-gradient(180deg, #f8fff4 0%, #d7f2c2 100%);">

                <h5 class="fw-bold text-success text-center mb-3">
                    <i class="bi bi-person-circle me-2"></i> Patient Info
                </h5>

                @if (isLoadingPatient)
                {
                    <div class="d-flex justify-content-center py-4">
                        <div class="spinner-border text-success" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm border-0 mb-2" style="border-radius: 15px;">
                        <div class="card-body" style="background: #ffffff;">
                            <h6 class="fw-bold text-success">
                                <i class="bi bi-info-circle me-2"></i> Basic Info
                            </h6>
                            <p class="mb-1"><strong>Name:</strong> @(patientDtoResponse?.Data?.FirstName) @(patientDtoResponse?.Data?.LastName)</p>
                            <p class="mb-1"><strong>Gender:</strong> @(patientDtoResponse?.Data?.Gender)</p>
                            <p class="mb-0"><strong>Blood Group:</strong> @(patientDtoResponse?.Data?.BloodGroup)</p>
                        </div>
                    </div>

                    <div class="card shadow-sm border-0 mb-2" style="border-radius: 15px;">
                        <div class="card-body" style="background: #f9fff5;">
                            <h6 class="fw-bold text-success">
                                <i class="bi bi-thermometer-half me-2"></i> Initial Symptoms
                            </h6>
                            <p class="mb-0">@(string.IsNullOrEmpty(patientDtoResponse?.Data?.InitialConditions) ? "No symptoms recorded" : patientDtoResponse?.Data?.InitialConditions)</p>
                        </div>
                    </div>

                    <div class="card shadow-sm border-0 mb-2" style="border-radius: 15px;">
                        <div class="card-body" style="background: #ffffff;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold text-success mb-0">
                                    <i class="bi bi-clipboard-data me-2"></i> History
                                </h6>
                                <div class="d-flex align-items-center gap-2">
                                    <button class="btn btn-sm btn-outline-success rounded-pill" 
                                            @onclick="RefreshPatientHistory"
                                            disabled="@isRefreshingHistory"
                                            title="Refresh History">
                                        @if (isRefreshingHistory)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-arrow-clockwise"></i>
                                        }
                                    </button>
                                    <button class="btn btn-sm btn-success rounded-circle" 
                                            @onclick="OpenPatientHistoryModal"
                                            disabled="@isLoadingPatientFullHistory"
                                            title="View Full History"
                                            style="width: 32px; height: 32px; padding: 0;">
                                        @if (isLoadingPatientFullHistory)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-clock-history"></i>
                                        }
                                    </button>
                                </div>
                            </div>
                            <div style="max-height: 150px; overflow-y: auto; white-space: pre-wrap; font-size: 0.85rem;">
                                @if (string.IsNullOrEmpty(patientDtoResponse?.Data?.History))
                                {
                                    <p class="text-muted mb-0">No history recorded</p>
                                }
                                else
                                {
                                    @((MarkupString)FormatHistoryForDisplay(patientDtoResponse.Data.History))
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm border-0 mb-2" style="border-radius: 15px;">
                        <div class="card-body" style="background: #f9fff5;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold text-success mb-0">
                                    <i class="bi bi-file-earmark-medical me-2"></i> Prescriptions
                                </h6>
                                <button class="btn btn-sm btn-success rounded-circle" 
                                        @onclick="OpenPatientReportsModal"
                                        disabled="@isLoadingPatientReports"
                                        title="View All Prescriptions"
                                        style="width: 32px; height: 32px; padding: 0;">
                                    @if (isLoadingPatientReports)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-eye"></i>
                                    }
                                </button>
                            </div>
                            <p class="text-muted small mb-0">Click the icon to view all saved prescriptions</p>
                        </div>
                    </div>

                    @* Medication Adherence Section *@
                    @* M-7 MEDICATION STICKING SHOWING TO DOCTOR *@
                    <div class="card shadow-sm border-0 mb-2" style="border-radius: 15px;">
                        <div class="card-body" style="background: #fff8f0;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold text-warning mb-0">
                                    <i class="bi bi-clipboard-check me-2"></i> Medication Adherence
                                </h6>
                                <button class="btn btn-sm btn-warning rounded-circle" 
                                        @onclick="LoadMedicationAdherence"
                                        disabled="@isLoadingAdherence"
                                        title="View Adherence Details"
                                        style="width: 32px; height: 32px; padding: 0;">
                                    @if (isLoadingAdherence)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-clockwise"></i>
                                    }
                                </button>
                            </div>
                            @if (medicationAdherenceData.Count > 0)
                            {
                                <div class="mt-2" style="max-height: 200px; overflow-y: auto;">
                                    @foreach (var adherence in medicationAdherenceData.Take(3))
                                    {
                                        <div class="p-2 mb-2 rounded" style="background: white; border-left: 3px solid @GetAdherenceColor(adherence.AdherencePercentage);">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="fw-bold small">@adherence.MedicineName</span>
                                                <span class="badge" style="background: @GetAdherenceColor(adherence.AdherencePercentage);">
                                                    @adherence.AdherencePercentage.ToString("F0")%
                                                </span>
                                            </div>
                                            <div class="progress mt-1" style="height: 6px;">
                                                <div class="progress-bar" 
                                                     role="progressbar" 
                                                     style="width: @adherence.AdherencePercentage%; background: @GetAdherenceColor(adherence.AdherencePercentage);">
                                                </div>
                                            </div>
                                            <small class="text-muted">@adherence.TakenDoses/@adherence.TotalDoses doses • @adherence.MissedDoses missed</small>
                                        </div>
                                    }
                                    @if (medicationAdherenceData.Count > 3)
                                    {
                                        <p class="text-muted small mb-0 text-center">+ @(medicationAdherenceData.Count - 3) more medications</p>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">Click refresh to load patient's medication adherence</p>
                            }
                        </div>
                    </div>

                    @* Daily Medication History Bar Graph *@
                    <div class="card shadow-sm border-0 mb-2" style="border-radius: 15px;">
                        <div class="card-body" style="background: #f0fff4;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold text-success mb-0">
                                    <i class="bi bi-bar-chart-fill me-2"></i> 7-Day History
                                </h6>
                                <button class="btn btn-sm btn-success rounded-circle" 
                                        @onclick="LoadDailyHistory"
                                        disabled="@isLoadingDailyHistory"
                                        title="Load Daily History"
                                        style="width: 32px; height: 32px; padding: 0;">
                                    @if (isLoadingDailyHistory)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-clockwise"></i>
                                    }
                                </button>
                            </div>
                            @if (dailyHistoryData.Count > 0)
                            {
                                var overallPercentage = dailyHistoryData.Average(d => d.AdherencePercentage);
                                var overallColor = overallPercentage >= 80 ? "#28a745" : (overallPercentage >= 50 ? "#ffc107" : "#dc3545");
                                <div class="text-center mb-2">
                                    <span class="badge px-3 py-2" style="background: @overallColor; font-size: 0.9rem;">
                                        <i class="bi bi-heart-pulse me-1"></i> @overallPercentage.ToString("F0")% Overall
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-end" style="height: 120px; gap: 4px;">
                                    @foreach (var day in dailyHistoryData)
                                    {
                                        var maxDoses = dailyHistoryData.Max(d => d.ScheduledDoses);
                                        var barHeight = maxDoses > 0 ? (day.ScheduledDoses * 100.0 / maxDoses) : 0;
                                        var takenHeight = day.ScheduledDoses > 0 ? (day.TakenDoses * barHeight / day.ScheduledDoses) : 0;
                                        var missedHeight = barHeight - takenHeight;
                                        var isToday = day.Date.Date == DateTime.Today;
                                        var barColor = day.AdherencePercentage >= 80 ? "#28a745" : (day.AdherencePercentage >= 50 ? "#ffc107" : "#dc3545");
                                        
                                        <div class="d-flex flex-column align-items-center flex-grow-1" style="min-width: 30px;">
                                            <div class="d-flex flex-column justify-content-end" style="height: 90px; width: 100%;">
                                                @if (missedHeight > 0)
                                                {
                                                    <div style="height: @(missedHeight)%; background: #dc3545; border-radius: 4px 4px 0 0; min-height: 2px;"></div>
                                                }
                                                @if (takenHeight > 0)
                                                {
                                                    <div style="height: @(takenHeight)%; background: @barColor; border-radius: @(missedHeight > 0 ? "0" : "4px 4px") 0 0; min-height: 2px; @(isToday ? "border: 2px solid #1a5928;" : "")"></div>
                                                }
                                            </div>
                                            <small class="text-muted mt-1" style="font-size: 0.65rem; @(isToday ? "font-weight: bold; color: #1a5928 !important;" : "")">
                                                @day.DayName.Substring(0, Math.Min(3, day.DayName.Length))
                                            </small>
                                            <small style="font-size: 0.6rem; color: @barColor;">@day.AdherencePercentage.ToString("F0")%</small>
                                        </div>
                                    }
                                </div>
                                <div class="d-flex justify-content-center gap-3 mt-2">
                                    <small><span style="display: inline-block; width: 10px; height: 10px; background: #28a745; border-radius: 2px;"></span> Taken</small>
                                    <small><span style="display: inline-block; width: 10px; height: 10px; background: #dc3545; border-radius: 2px;"></span> Missed</small>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">Click refresh to load 7-day medication history</p>
                            }
                        </div>
                    </div>

                    @if (agentInfo != null)
                    {
                        <div class="card shadow-sm border-0 mb-2" style="border-radius: 15px;">
                            <div class="card-body" style="background: #ffffff;">
                                <h6 class="fw-bold text-success">
                                    <i class="bi bi-robot me-2"></i> AI Agent Info
                                </h6>
                                <p class="mb-1"><strong>Specialty:</strong> @agentInfo.Specialty</p>
                                <p class="mb-0">
                                    <strong>Status:</strong> 
                                    @if (agentInfo.IsAgentAvailable)
                                    {
                                        <span class="text-success"><i class="bi bi-check-circle me-1"></i>Available</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning"><i class="bi bi-exclamation-circle me-1"></i>Unavailable</span>
                                    }
                                </p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

    </div>
</div>

@* Prescription Edit Popup Modal *@
@if (showPrescriptionPopup)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content" style="border-radius: 15px; overflow: hidden;">
                <div class="modal-header" style="background: linear-gradient(90deg, #2e7d32, #66bb6a); color: white;">
                    <h5 class="modal-title">
                        <i class="bi bi-file-earmark-medical me-2"></i>Edit Prescription
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="ClosePrescriptionPopup"></button>
                </div>
                <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-success"><i class="bi bi-clipboard2-pulse me-1"></i>Diagnosis</label>
                        <textarea class="form-control" rows="2" @bind="prescriptionData.Diagnosis"></textarea>
                    </div>
                    
                    @* Medicines Section with Individual Controls *@
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold text-success mb-0"><i class="bi bi-capsule me-1"></i>Medicines</label>
                            <button type="button" class="btn btn-success btn-sm" @onclick="AddMedicineEntry">
                                <i class="bi bi-plus-circle me-1"></i>Add Medicine
                            </button>
                        </div>
                        
                        @if (medicineEntries.Count == 0)
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>Click "Add Medicine" to add medicines to the prescription
                            </div>
                        }
                        else
                        {
                            @foreach (var (medicine, index) in medicineEntries.Select((m, i) => (m, i)))
                            {
                                <div class="card mb-2" style="border: 1px solid #d8f3df; border-radius: 10px;">
                                    <div class="card-body py-2 px-3">
                                        <div class="row g-2 align-items-center">
                                            @* Medicine Name *@
                                            <div class="col-md-3">
                                                <label class="form-label small text-muted mb-1">Medicine Name</label>
                                                <input type="text" class="form-control form-control-sm" 
                                                       placeholder="e.g., Panadol"
                                                       @bind="medicine.Name" />
                                            </div>
                                            
                                            @* Quantity with up/down buttons *@
                                            <div class="col-md-2">
                                                <label class="form-label small text-muted mb-1">Qty</label>
                                                <div class="input-group input-group-sm">
                                                    <button type="button" class="btn btn-outline-secondary" 
                                                            @onclick="() => DecreaseMedicineQty(index)"
                                                            disabled="@(medicine.Quantity <= 1)">
                                                        <i class="bi bi-dash"></i>
                                                    </button>
                                                    <input type="text" class="form-control text-center" 
                                                           value="@medicine.Quantity" readonly 
                                                           style="max-width: 50px;" />
                                                    <button type="button" class="btn btn-outline-secondary" 
                                                            @onclick="() => IncreaseMedicineQty(index)">
                                                        <i class="bi bi-plus"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            
                                            @* Duration in Days *@
                                            <div class="col-md-2">
                                                <label class="form-label small text-muted mb-1">Duration (Days)</label>
                                                <div class="input-group input-group-sm">
                                                    <button type="button" class="btn btn-outline-secondary" 
                                                            @onclick="() => DecreaseMedicineDuration(index)"
                                                            disabled="@(medicine.DurationDays <= 1)">
