    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(messageInput) || agentInfo?.IsAgentAvailable != true)
            return;

        var message = messageInput.Trim();
        messageInput = string.Empty;

        try
        {
            isSendingMessage = true;
            StateHasChanged();
            await ScrollToBottom();

            var client = await ApiClient.SetAuthorizedHeader();
            var request = new SendMessageRequest
            {
                PatientId = patientId,
                ChatId = currentChatId,
                Message = message
            };

            var response = await client.PostAsJsonAsync("api/Chat/send", request);
            var apiResponse = await response.Content.ReadFromJsonAsync<SendMessageResponse>();

            if (response.IsSuccessStatusCode && apiResponse != null && apiResponse.Status)
            {
                // If this was a new chat, update the current chat ID
                if (string.IsNullOrEmpty(currentChatId))
                {
                    currentChatId = apiResponse.ChatId;
                }

                // Add the message to the current chat
                if (currentChat == null)
                {
                    currentChat = new ChatModel
                    {
                        Id = apiResponse.ChatId,
                        PatientId = patientId,
                        Chats = new List<ChatMessage>()
                    };
                }

                currentChat.Chats.Add(new ChatMessage
                {
                    Query = message,
                    Response = apiResponse.AIResponse,
                    Timestamp = apiResponse.Timestamp
                });

                // Refresh chat list to update message count
                await LoadChatList();
            }
            else
            {
                ToastComponent?.ShowDangerToast("Error", apiResponse?.Message ?? "Failed to send message");
                messageInput = message; // Restore the message
            }
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Error", ex.Message);
            messageInput = message; // Restore the message
        }
        finally
        {
            isSendingMessage = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

