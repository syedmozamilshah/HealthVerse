    private void ParseClassifierDetailedResult(string jsonResponse)
    {
        try
        {
            using var doc = JsonDocument.Parse(jsonResponse);
            var root = doc.RootElement;

            // Get prediction
            if (root.TryGetProperty("prediction", out var predField))
            {
                classifierResult = predField.GetString() ?? "";
            }

            // Get confidence
            if (root.TryGetProperty("confidence", out var confField))
            {
                classifierConfidence = confField.GetDouble();
            }

            // Get probabilities
            classifierProbabilities.Clear();
            if (root.TryGetProperty("probabilities", out var probField))
            {
                foreach (var prop in probField.EnumerateObject())
                {
                    classifierProbabilities[prop.Name] = prop.Value.GetDouble();
                }
            }

            // If no direct fields found, try to parse generic format
            if (string.IsNullOrEmpty(classifierResult))
            {
                classifierResult = ParseHighestProbabilityResult(jsonResponse, "classifier");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error parsing classifier result: {ex.Message}");
            classifierResult = "Error parsing result";
        }
    }

