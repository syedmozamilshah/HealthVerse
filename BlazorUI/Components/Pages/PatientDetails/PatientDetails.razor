                    doctorName = doctorResult.Success ? doctorResult.Value : "Doctor";
                }
            }
            
            if (string.IsNullOrEmpty(doctorSpecialty))
            {
                doctorSpecialty = agentInfo?.Specialty ?? "Specialist";
            }

