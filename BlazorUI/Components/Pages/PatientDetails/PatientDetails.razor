    };

    // Eye Disease Classifier mappings
    private static readonly Dictionary<string, string> EyeDiseaseLabels = new()
    {
        { "0", "Normal" },
        { "1", "Cataract" },
        { "2", "Glaucoma" },
        { "3", "Diabetic Retinopathy" },
        { "cataract", "Cataract" },
        { "glaucoma", "Glaucoma" },
        { "diabetic_retinopathy", "Diabetic Retinopathy" },
        { "normal", "Normal" }
    };

    private string GetDrLabel(string label)
    {
        if (DrGradeLabels.TryGetValue(label, out var drLabel))
            return drLabel;
        return label;
    }

    private string GetEyeDiseaseLabel(string label)
    {
        // Check numeric labels first
        if (EyeDiseaseLabels.TryGetValue(label, out var eyeLabel))
            return eyeLabel;
        
        // Then check case-insensitive text labels
        var lowerLabel = label.ToLowerInvariant();
        if (EyeDiseaseLabels.TryGetValue(lowerLabel, out var eyeLabelLower))
            return eyeLabelLower;
        
        return label;
    }

    private string ParseHighestProbabilityResult(string jsonResponse, string resultType = "dr")
    {
        try
        {
            using var doc = JsonDocument.Parse(jsonResponse);
            var root = doc.RootElement;

            // PRIORITY 1: Check for predicted_label field directly (most APIs return this)
            if (root.TryGetProperty("predicted_label", out var predictedLabel))
            {
                var label = predictedLabel.GetString();
                if (!string.IsNullOrEmpty(label))
                    return label;
            }

            // PRIORITY 2: Check for prediction/class/label fields
            if (root.TryGetProperty("prediction", out var predField))
            {
                var val = predField.GetString();
                if (!string.IsNullOrEmpty(val))
                    return val;
            }
            if (root.TryGetProperty("class", out var classField))
            {
                var val = classField.GetString();
                if (!string.IsNullOrEmpty(val))
                    return val;
            }
            if (root.TryGetProperty("label", out var labelField))
            {
                var val = labelField.GetString();
                if (!string.IsNullOrEmpty(val))
                    return val;
            }

            // PRIORITY 3: Try to find predictions array or object
            JsonElement predictions;
            if (root.TryGetProperty("predictions", out predictions) || 
                root.TryGetProperty("results", out predictions) ||
                root.TryGetProperty("probabilities", out predictions))
            {
                // Handle array format
                if (predictions.ValueKind == JsonValueKind.Array)
                {
                    string highestLabel = "";
                    double highestProb = 0;
                    
                    foreach (var pred in predictions.EnumerateArray())
                    {
                        string label = "";
                        double prob = 0;
                        
                        if (pred.TryGetProperty("label", out var labelEl))
                            label = labelEl.GetString() ?? "";
                        else if (pred.TryGetProperty("class", out var classEl))
                            label = classEl.GetString() ?? "";
                        else if (pred.TryGetProperty("name", out var nameEl))
                            label = nameEl.GetString() ?? "";
                        
                        if (pred.TryGetProperty("probability", out var probEl))
                            prob = probEl.GetDouble();
                        else if (pred.TryGetProperty("confidence", out var confEl))
                            prob = confEl.GetDouble();
                        else if (pred.TryGetProperty("score", out var scoreEl))
                            prob = scoreEl.GetDouble();
                        
                        if (prob > highestProb)
                        {
                            highestProb = prob;
                            highestLabel = label;
                        }
                    }
                    
                    if (!string.IsNullOrEmpty(highestLabel))
                        return resultType == "classifier" ? GetEyeDiseaseLabel(highestLabel) : GetDrLabel(highestLabel);
                }
                // Handle object format (key: probability)
                else if (predictions.ValueKind == JsonValueKind.Object)
                {
                    string highestLabel = "";
                    double highestProb = 0;
                    
                    foreach (var prop in predictions.EnumerateObject())
                    {
                        double prob = prop.Value.GetDouble();
                        if (prob > highestProb)
                        {
                            highestProb = prob;
                            highestLabel = prop.Name;
                        }
                    }
                    
                    if (!string.IsNullOrEmpty(highestLabel))
                        return resultType == "classifier" ? GetEyeDiseaseLabel(highestLabel) : GetDrLabel(highestLabel);
                }
            }
            
            // Try direct object format (label: probability at root level)
            if (root.ValueKind == JsonValueKind.Object)
            {
                string highestLabel = "";
                double highestProb = 0;
                
                foreach (var prop in root.EnumerateObject())
                {
                    if (prop.Value.ValueKind == JsonValueKind.Number)
                    {
                        double prob = prop.Value.GetDouble();
                        if (prob > highestProb)
                        {
                            highestProb = prob;
                            highestLabel = prop.Name;
                        }
                    }
                }
                
                if (!string.IsNullOrEmpty(highestLabel))
                    return resultType == "classifier" ? GetEyeDiseaseLabel(highestLabel) : GetDrLabel(highestLabel);
            }
            
            return jsonResponse;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error parsing prediction response: {ex.Message}");
            return jsonResponse;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var client = await ApiClient.SetAuthorizedHeader();
            if (client.DefaultRequestHeaders.Authorization == null)
            {
                // Not logged in - redirect to login
                Navigation.NavigateTo("/", true);
                return;
            }

            // Check subscription status first
            await CheckSubscriptionStatus();
            
            await LoadAllData();
            
            // After loading, automatically start a chat with patient context if no chats exist
            await AutoStartChatWithContext();
        }
    }

    private async Task CheckSubscriptionStatus()
    {
        try
        {
            var client = await ApiClient.SetAuthorizedHeader();
            var response = await client.GetAsync("api/Doctor/get/profile");
            
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<DoctorProfileResponse>();
                if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Doctor != null)
                {
                    doctorProfile = apiResponse.Doctor;
                    
                    // Check verification status first - redirect if not verified
                    if (!doctorProfile.IsVerified)
                    {
                        await JSRuntime.InvokeVoidAsync("alert", "Your account is not verified yet. Please complete your profile verification to view patient details.");
                        Navigation.NavigateTo("/profile-setup", true);
                        return;
                    }
                    
                    // Check actual subscription status from Stripe API
                    var subResponse = await client.GetAsync("api/Stripe/doctor/subscription-status");
                    if (subResponse.IsSuccessStatusCode)
                    {
                        var subResult = await subResponse.Content.ReadFromJsonAsync<SubscriptionStatusResult>();
                        if (subResult == null || !subResult.IsSubscribed)
                        {
                            await JSRuntime.InvokeVoidAsync("alert", "Please complete your subscription payment to view patient details.");
                            Navigation.NavigateTo("/payment-due", true);
                            return;
                        }
                    }
                    else
                    {
                        // If we can't check subscription, redirect to payment
                        Navigation.NavigateTo("/payment-due", true);
                        return;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error checking subscription: {ex.Message}");
        }
    }

    private class SubscriptionStatusResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("isSubscribed")]
        public bool IsSubscribed { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("subscriptionStatus")]
        public string? SubscriptionStatus { get; set; }
    }

    private async Task AutoStartChatWithContext()
    {
        try
        {
            // Check if agent is available
            if (agentInfo?.IsAgentAvailable != true || patientDtoResponse?.Data == null)
                return;

            var client = await ApiClient.SetAuthorizedHeader();
            
            // First, check if there's an existing chat with messages for this patient
            if (chatList != null && chatList.Count > 0)
            {
                // Find the most recent chat that has messages (not empty)
                var existingChat = chatList.FirstOrDefault(c => c.MessageCount > 0);
                if (existingChat != null)
                {
                    // Load the existing chat and continue from where it stopped
                    await LoadChat(existingChat.Id);
                    ToastComponent?.ShowInfoToast("Continuing Chat", "Loaded existing consultation");
                    return;
                }
            }
            
            // No existing chat with messages - create a new one with patient context
            var patientName = $"{patientDtoResponse.Data.FirstName} {patientDtoResponse.Data.LastName}".Trim();
            var initialConditions = patientDtoResponse.Data.InitialConditions ?? "";
            var history = patientDtoResponse.Data.History ?? "";

            // Build the context message - handle case when symptoms were skipped
            var contextParts = new List<string>();
            contextParts.Add($"Patient Name: {patientName}");
            
            if (!string.IsNullOrWhiteSpace(initialConditions))
            {
                contextParts.Add($"Initial Symptoms/Conditions: {initialConditions}");
            }
            else
            {
                // No symptoms recorded - ask the doctor to gather symptoms
                contextParts.Add("Initial Symptoms/Conditions: Not recorded during booking. Please ask the patient about their symptoms.");
            }
            
            if (!string.IsNullOrWhiteSpace(history))
            {
                contextParts.Add($"Medical History: {history}");
            }
            
            var contextMessage = !string.IsNullOrWhiteSpace(initialConditions)
                ? $"I am starting a consultation for a patient. Here is their information:\n\n{string.Join("\n", contextParts)}\n\nPlease acknowledge this patient information and let me know you're ready to assist with the consultation."
                : $"I am starting a consultation for a patient. Here is their information:\n\n{string.Join("\n", contextParts)}\n\nNote: The patient did not provide symptoms during booking. Please start by asking about their current symptoms and concerns.";

            // Step 1: Create chat instantly (without AI call)
            var createRequest = new CreateChatRequest
            {
                PatientId = patientId,
                Title = DateTimeHelper.GetPakistanNow().ToString("MMMM dd, yyyy"),
                PatientName = "",  // Empty to skip AI call on create
                InitialConditions = "",
                History = ""
            };

            var createResponse = await client.PostAsJsonAsync("api/Chat/create", createRequest);
            
            if (createResponse.IsSuccessStatusCode)
            {
                var createResult = await createResponse.Content.ReadFromJsonAsync<ChatModelResponse>();
                if (createResult != null && createResult.Status && createResult.Data != null)
                {
                    currentChat = createResult.Data;
                    currentChatId = createResult.Data.Id;
                    
                    // Step 2: Show the user message immediately in UI
                    currentChat.Chats.Add(new ChatMessage
                    {
                        Query = contextMessage,
                        Response = "",  // Empty response initially
                        Timestamp = DateTime.Now
                    });
                    
                    await LoadChatList();
                    isSendingMessage = true;  // Show "thinking" indicator
                    StateHasChanged();
                    await ScrollToBottom();

                    // Step 3: Send message to AI and get response
                    var sendRequest = new SendMessageRequest
                    {
                        PatientId = patientId,
                        ChatId = currentChatId,
                        Message = contextMessage
                    };

                    var sendResponse = await client.PostAsJsonAsync("api/Chat/send", sendRequest);
                    var sendResult = await sendResponse.Content.ReadFromJsonAsync<SendMessageResponse>();

                    if (sendResponse.IsSuccessStatusCode && sendResult != null && sendResult.Status)
                    {
                        // Step 4: Update the message with AI response
                        var lastMsg = currentChat.Chats.LastOrDefault();
                        if (lastMsg != null)
                        {
                            lastMsg.Response = sendResult.AIResponse;
                            lastMsg.Timestamp = sendResult.Timestamp;
                        }
                        ToastComponent?.ShowSuccessToast("Ready", "AI Assistant ready");
                    }
                    else
                    {
                        // Remove the pending message if failed
                        currentChat.Chats.RemoveAt(currentChat.Chats.Count - 1);
                        ToastComponent?.ShowDangerToast("Error", sendResult?.Message ?? "Failed to get AI response");
                    }
                    
                    await LoadChatList();
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"AutoStartChatWithContext error: {ex.Message}");
        }
        finally
        {
            isSendingMessage = false;
            isCreatingChat = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

