    private string FormatHistoryForDisplay(string history)
    {
        if (string.IsNullOrEmpty(history))
            return "<p class='text-muted mb-0'>No history recorded</p>";

        // Split by prescription entries and format nicely
        var formatted = history
            .Replace("--- Prescription", "<div class='border-top pt-2 mt-2'><strong class='text-success'>Prescription")
            .Replace("---\n", "</strong></div>")
            .Replace("Diagnosis:", "<br/><span class='text-primary'>Diagnosis:</span>")
            .Replace("Medicines:", "<br/><span class='text-primary'>Medicines:</span>")
            .Replace("Advice:", "<br/><span class='text-primary'>Advice:</span>")
            .Replace("Follow-up:", "<br/><span class='text-primary'>Follow-up:</span>")
            .Replace("Summary:", "<br/><span class='text-primary'>Summary:</span>")
            .Replace("\n", "<br/>");

        return $"<div>{formatted}</div>";
    }

