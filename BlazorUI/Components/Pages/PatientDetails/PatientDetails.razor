    private List<HistoryEntry> ParseHistoryIntoEntries(string history)
    {
        var entries = new List<HistoryEntry>();
        
        if (string.IsNullOrEmpty(history))
            return entries;

        // Split by prescription markers
        var parts = history.Split(new[] { "--- Prescription" }, StringSplitOptions.RemoveEmptyEntries);
        
        foreach (var part in parts)
        {
            if (string.IsNullOrWhiteSpace(part))
                continue;

            var entry = new HistoryEntry { Type = "Prescription" };
            
            // Extract date from the format "(dd-MM-yyyy) ---"
            var dateMatch = System.Text.RegularExpressions.Regex.Match(part, @"\((\d{2}-\d{2}-\d{4})\)");
            if (dateMatch.Success)
            {
                entry.Date = dateMatch.Groups[1].Value;
            }
            else
            {
                entry.Date = "Unknown Date";
            }

            // Parse individual fields
            var lines = part.Split('\n');
            foreach (var line in lines)
            {
                var trimmedLine = line.Trim();
                
                if (trimmedLine.StartsWith("Diagnosis:"))
                    entry.Diagnosis = trimmedLine.Substring("Diagnosis:".Length).Trim();
                else if (trimmedLine.StartsWith("Medicines:"))
                    entry.Medicines = trimmedLine.Substring("Medicines:".Length).Trim();
                else if (trimmedLine.StartsWith("Advice:"))
                    entry.Advice = trimmedLine.Substring("Advice:".Length).Trim();
                else if (trimmedLine.StartsWith("Follow-up:"))
                    entry.FollowUp = trimmedLine.Substring("Follow-up:".Length).Trim();
                else if (trimmedLine.StartsWith("Summary:"))
                    entry.Summary = trimmedLine.Substring("Summary:".Length).Trim();
            }

            entries.Add(entry);
        }

        // Sort by date (most recent first)
        return entries.OrderByDescending(e => {
            if (DateTime.TryParseExact(e.Date, "dd-MM-yyyy", null, System.Globalization.DateTimeStyles.None, out var date))
                return date;
            return DateTime.MinValue;
        }).ToList();
    }

    // History Entry class
    public class HistoryEntry
    {
        public string Date { get; set; } = "";
        public string Type { get; set; } = "Prescription";
        public string Diagnosis { get; set; } = "";
        public string Medicines { get; set; } = "";
        public string Advice { get; set; } = "";
        public string FollowUp { get; set; } = "";
        public string Summary { get; set; } = "";
    }

    // Medicine Entry class for individual medicine items
    public class MedicineEntry
    {
        public string Name { get; set; } = "";
        public int Quantity { get; set; } = 1;
        public int DurationDays { get; set; } = 7; // Duration in days for medication
        public bool Morning { get; set; } = false;
        public bool Afternoon { get; set; } = false;
        public bool Evening { get; set; } = false;
        public bool Night { get; set; } = false;
        public string Instructions { get; set; } = "";

        public string GetTimingDisplay()
        {
            var timings = new List<string>();
            if (Morning) timings.Add("Morning");
            if (Afternoon) timings.Add("Afternoon");
            if (Evening) timings.Add("Evening");
            if (Night) timings.Add("Night");
            return timings.Count > 0 ? string.Join(", ", timings) : "As needed";
        }

        public string ToFormattedString()
        {
            var timing = GetTimingDisplay();
            return $"{Name} - {Quantity} tablet(s) - {timing} for {DurationDays} days" + 
                   (string.IsNullOrEmpty(Instructions) ? "" : $" | {Instructions}");
        }
    }

