@code {
    [Parameter]
    public string patientId { get; set; } = string.Empty;

    private PatientDtoResponse? patientDtoResponse = new PatientDtoResponse();
    private NetcodeHubToast? ToastComponent;
    private AppointmentModelDtos? patientConfirmedAppointment;
    private AppointmentModelDtos? patientInProgressAppointment;

    // Chat state
    private List<ChatSummary> chatList = new();
    private ChatModel? currentChat;
    private string currentChatId = string.Empty;
    private string messageInput = string.Empty;
    private AgentInfoResponse? agentInfo;

    // Loading states
    private bool isLoadingPatient = true;
    private bool isLoadingChats = true;
    private bool isCreatingChat = false;
    private bool isSendingMessage = false;

    // Ophthalmologist tabs state
    private string activeTab = "agent";
    private bool isUploadingDR = false;
    private bool isUploadingClassifier = false;
    private string drResult = string.Empty;
    private double drConfidence = 0;
    private Dictionary<string, double> drProbabilities = new();
    private string? drPreviewImageUrl;

    // Prescription state
    private bool isGeneratingPrescription = false;
    private bool showPrescriptionPopup = false;
    private bool showPrescriptionPreview = false;
    private bool isSavingPrescription = false;
    private bool isSendingPrescription = false;
    private bool isLoadingSavedPrescriptions = false;
    private bool showSavedPrescriptionsModal = false;

    // Referral state
    private bool isReferring = false;
    private string selectedReferralSpecialty = "";
    private bool hasPrescriptionGenerated = false;

    private List<SavedPrescription> savedPrescriptions = new();
    private PrescriptionData prescriptionData = new();
    private List<MedicineEntry> medicineEntries = new();
    private string prescriptionHtml = string.Empty;
    private string? doctorName;
    private string? doctorId;
    private string? doctorSpecialty;
    private string? doctorClinicAddress;
    private string classifierResult = string.Empty;
    private double classifierConfidence = 0;
    private Dictionary<string, double> classifierProbabilities = new();
    private string? classifierPreviewImageUrl;
    private bool isRefreshingHistory = false;
    private DoctorProfile? doctorProfile;

    @* M-4 APPOINTMENT STARTS *@
    private async Task StartSessionByPatient()
    {
        try
        {
            var client = await ApiClient.SetAuthorizedHeader();
            var response = await client.PostAsync($"api/Appointment/start/{patientId}", null);
            if (response.IsSuccessStatusCode)
            {
                ToastComponent?.ShowSuccessToast("Success", "Session started successfully");
                await LoadPatientDetails();
                await LoadPatientAppointments();
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastComponent?.ShowDangerToast("Error", BuildStartSessionErrorMessage(error));
            }
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Error", $"Failed to start session: {ex.Message}");
        }
    }

    @* M-4 APPOINTMENT COMPLETE *@

    private async Task CompleteByPatient()
    {
        try
        {
            var client = await ApiClient.SetAuthorizedHeader();
            
            // Check if prescription is generated
            bool canComplete = hasPrescriptionGenerated;

            if (!canComplete)
            {
                var presResponse = await client.GetAsync($"api/Prescription/patient/{patientId}");
                if (presResponse.IsSuccessStatusCode)
                {
                    var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    var responseContent = await presResponse.Content.ReadAsStringAsync();
                    var result = System.Text.Json.JsonSerializer.Deserialize<SavedPrescriptionsResponse>(responseContent, options);
                    
                    if (result?.Success == true && result.Data != null)
                    {
                        // Allow completion if a prescription was created today for this patient
                        if (result.Data.Any(p => p.CreatedAt.Date == DateTime.UtcNow.Date || p.CreatedAt.Date == DateTime.Today))
                        {
                            canComplete = true;
                        }
                    }
                }
            }

            if (!canComplete)
            {
                ToastComponent?.ShowDangerToast("Action Required", "You must generate and send a prescription before completing the appointment.");
                return;
            }

            var response = await client.PostAsync($"api/Appointment/complete/{patientId}", null);
            if (response.IsSuccessStatusCode)
            {
                ToastComponent?.ShowSuccessToast("Success", "Appointment marked as completed");
                await LoadPatientDetails();
                await LoadPatientAppointments();
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastComponent?.ShowDangerToast("Error", $"Could not complete appointment: {error}");
            }
        }
        catch (Exception ex)
        {
            ToastComponent?.ShowDangerToast("Error", $"Failed to complete appointment: {ex.Message}");
        }
    }

    private bool CanStartPatientAppointment()
    {
        if (patientConfirmedAppointment == null)
        {
            return false;
        }

        var appointmentTime = patientConfirmedAppointment.SlotStartTime ?? patientConfirmedAppointment.AppointmentDate;

        if (appointmentTime.Kind == DateTimeKind.Unspecified)
        {
            appointmentTime = DateTime.SpecifyKind(appointmentTime, DateTimeKind.Utc);
        }
        else if (appointmentTime.Kind == DateTimeKind.Local)
        {
            appointmentTime = appointmentTime.ToUniversalTime();
        }

        return DateTime.UtcNow >= appointmentTime;
    }

    private bool CanCompletePatientAppointment()
    {
        return patientInProgressAppointment != null;
    }

    private bool IsSessionActiveOrReadyToStart()
    {
        return patientInProgressAppointment != null || CanStartPatientAppointment();
    }

    private string BuildStartSessionErrorMessage(string responseContent)
    {
        if (string.IsNullOrWhiteSpace(responseContent))
        {
            return "Could not start session.";
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(responseContent);
            var root = doc.RootElement;
            var message = TryGetStringProperty(root, "message") ?? "Could not start session.";

            if (TryGetUtcDateTime(root, "appointmentStartUtc", out var startUtc)
                && TryGetUtcDateTime(root, "appointmentEndUtc", out var endUtc))
            {
                var startLocal = startUtc.ToLocalTime();
                var endLocal = endUtc.ToLocalTime();
                return $"Session can only be started between {startLocal:hh:mm tt} and {endLocal:hh:mm tt} (local time).";
            }

            return message;
        }
        catch
        {
            return responseContent;
        }
    }

    private static string? TryGetStringProperty(System.Text.Json.JsonElement root, string propertyName)
    {
        foreach (var prop in root.EnumerateObject())
        {
            if (string.Equals(prop.Name, propertyName, StringComparison.OrdinalIgnoreCase))
            {
                return prop.Value.GetString();
            }
        }

        return null;
    }

    private static bool TryGetUtcDateTime(System.Text.Json.JsonElement root, string propertyName, out DateTime value)
    {
        value = default;

        foreach (var prop in root.EnumerateObject())
        {
            if (!string.Equals(prop.Name, propertyName, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var rawValue = prop.Value.GetString();
            if (string.IsNullOrWhiteSpace(rawValue))
            {
                return false;
            }

            return DateTime.TryParse(
                rawValue,
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal,
                out value);
        }

        return false;
    }

    // Patient Reports and History Modal state
    private bool showPatientReportsModal = false;
    private bool showPatientHistoryModal = false;
    private bool isLoadingPatientReports = false;
    private bool isLoadingPatientFullHistory = false;
