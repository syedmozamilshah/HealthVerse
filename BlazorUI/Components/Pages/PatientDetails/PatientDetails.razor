                    <p style=""margin: 5px 0 0 15px; white-space: pre-wrap;"">{FormatPrescriptionField(prescriptionData.Advice)}</p>
                </div>

                <div style=""margin-bottom: 15px;"">
                    <strong style=""color: #2e7d32;"">Notes:</strong>
                    <p style=""margin: 5px 0 0 15px; white-space: pre-wrap;"">{FormatPrescriptionField(prescriptionData.Notes)}</p>
                </div>

                <div style=""margin-bottom: 15px;"">
                    <strong style=""color: #2e7d32;"">Follow Up:</strong>
                    <p style=""margin: 5px 0 0 15px;"">{FormatPrescriptionField(prescriptionData.FollowUp)}</p>
                </div>
            </div>

            <!-- Footer -->
            <div style=""margin-top: 40px; padding-top: 20px; border-top: 2px solid #eee;"">
                <p style=""margin: 5px 0;""><strong>Signed:</strong> Dr. {doctorName}</p>
