@inherits LayoutComponentBase

@using AdminDashboard.Services
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation
@inject AuthService AuthService

<div class="admin-layout">
    <!-- Top Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm fixed-top">
        <div class="container-fluid">
            <button class="btn btn-link text-dark" @onclick="ToggleSidebar">
                <i class="bi bi-list fs-4"></i>
            </button>
            <a class="navbar-brand d-flex align-items-center" href="/">
                <i class="bi bi-heart-pulse-fill fs-3 me-2" style="color: #198754;"></i>
                <span class="fw-bold">HealthVerse Admin Panel</span>
            </a>
            
            <div class="dropdown ms-auto">
                <button class="btn btn-link text-decoration-none dropdown-toggle d-flex align-items-center" 
                        type="button" 
                        id="userMenuDropdown" 
                        data-bs-toggle="dropdown" 
                        aria-expanded="false">
                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center me-2" 
                         style="width: 32px; height: 32px; background-color: #198754;">
                        <strong>A</strong>
                    </div>
                    <span class="d-none d-md-inline text-dark">Admin User</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuDropdown">
                    <li><button class="dropdown-item" @onclick="Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Sidebar Overlay -->
    @if (isSidebarToggled)
    {
        <div class="sidebar-overlay d-lg-none" @onclick="ToggleSidebar"></div>
    }

    <!-- Sidebar -->
    <aside class="sidebar shadow-sm @(isSidebarToggled ? "toggled" : "")">
        <div class="list-group list-group-flush p-3">
            <NavLink class="list-group-item list-group-item-action border-0 rounded mb-1 d-flex align-items-center" href="/" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2 me-3 fs-5"></i>
                <span>Dashboard Overview</span>
            </NavLink>
            
            <NavLink class="list-group-item list-group-item-action border-0 rounded mb-1 d-flex align-items-center" href="/users">
                <i class="bi bi-people me-3 fs-5"></i>
                <span>User Management</span>
            </NavLink>
            
            <NavLink class="list-group-item list-group-item-action border-0 rounded mb-1 d-flex align-items-center" href="/verification">
                <i class="bi bi-patch-check me-3 fs-5"></i>
                <span>Verification Pipeline</span>
            </NavLink>
            
            <NavLink class="list-group-item list-group-item-action border-0 rounded mb-1 d-flex align-items-center" href="/ai-agent">
                <i class="bi bi-robot me-3 fs-5"></i>
                <span>AI Agent Control</span>
            </NavLink>
            
            <NavLink class="list-group-item list-group-item-action border-0 rounded mb-1 d-flex align-items-center" href="/finance">
                <i class="bi bi-credit-card me-3 fs-5"></i>
                <span>Finance & Subscriptions</span>
            </NavLink>
            
            <NavLink class="list-group-item list-group-item-action border-0 rounded mb-1 d-flex align-items-center" href="/logs">
                <i class="bi bi-activity me-3 fs-5"></i>
                <span>System Logs & Health</span>
            </NavLink>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content @(isSidebarToggled ? "toggled" : "")">
        <div class="container-fluid p-4">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@inject IJSRuntime JS

@code {
    private bool isSidebarToggled = false;

    private void ToggleSidebar()
    {
        isSidebarToggled = !isSidebarToggled;
    }

    private async Task Logout()
    {
        try
        {
            await JS.InvokeVoidAsync("authCookies.clearAdminSession");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error clearing cookies via JS: {ex.Message}");
        }

        AuthService.Logout();
        Navigation.NavigateTo("/login", true);
    }
}
